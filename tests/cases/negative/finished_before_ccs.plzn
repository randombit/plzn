# Send Finished without sending ChangeCipherSpec first.
# This is a state machine violation — Finished (encrypted, since
# keys were installed during CKE) must follow CCS (RFC 5246 §7.4.9).
plzn tls "negative/finished-before-ccs" {
  rfc 5246 section 7.4.9
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ChangeCipherSpec {
    send Finished
  }
  expect alert fatal/unexpected_message
  expect ok if rustls
}
