# Send application data before client Finished in TLS 1.3.
# A correct server MUST reject this — no application data
# should be accepted before the handshake completes.
plzn tls "negative/tls13-appdata-before-finished" {
  rfc 8446 section 4.4.4
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send Finished {
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
}
