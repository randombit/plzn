# Send ChangeCipherSpec twice in TLS 1.2. The second CCS is a
# protocol violation per RFC 5246 §7.1. Complete the handshake
# exchange to verify the server rejects the duplicate.
plzn tls "negative/double-ccs" {
  rfc 5246 section 7.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ChangeCipherSpec {
    send ChangeCipherSpec
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect alert fatal/{unexpected_message, internal_error, decode_error}
}
