# Send Finished twice in TLS 1.3. The second Finished after
# the handshake completes is a protocol violation.
plzn tls "negative/double-finished-tls13" {
  rfc 8446 section 4.4.4
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake after send Finished {
    send Finished
    recv AppData
  }
  expect alert fatal/unexpected_message
}
