# CVE-2026-34582: TLS 1.3 client authentication bypass.
#
# A malicious client omits Certificate, CertificateVerify, and
# Finished entirely, and instead sends application data. A correct
# server MUST reject this — it should not process AppData before
# the client's Finished has been received and verified.
#
# Botan <= 3.11.0 accepted this, serving content to unauthenticated
# clients. Fixed in 3.11.1.
plzn tls "negative/tls13-client-auth-bypass" {
  rfc 8446 section 4.4
  chain: [default]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake until send Certificate {
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
}
