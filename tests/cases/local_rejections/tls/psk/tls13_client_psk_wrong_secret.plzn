plzn tls "selftest/local-rejection/tls13-client-psk-wrong-secret" {
  rfc 8446 section 4.2.11.2
  chain: []
  psk {
    identity: "plzn-psk-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  uut client {
    versions: [tls13]
    psk_secret: "0f0e0d0c0b0a0908"
  }
  flow handshake {
    recv ClientHello { has_ext: pre_shared_key }
  }
  expect reject fatal/decrypt_error
}
