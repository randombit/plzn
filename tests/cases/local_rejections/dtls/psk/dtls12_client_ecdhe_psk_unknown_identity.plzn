plzn tls "selftest/local-rejection/dtls12-client-ecdhe-psk-unknown-identity" {
  rfc 5489 section 3.3
  chain: []
  psk {
    identity: "plzn-dtls-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  uut client {
    versions: [dtls12]
    psk_identity: "not-an-identity"
  }
  peer { capabilities: [ecdhe_psk] }
  flow handshake {}
  expect reject fatal/unknown_psk_identity
}
