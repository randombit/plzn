plzn tls "selftest/local-rejection/dtls12-client-psk-wrong-secret" {
  rfc 4279 section 2
  chain: []
  psk {
    identity: "plzn-psk-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  uut client {
    versions: [dtls12]
    psk_secret: "0f0e0d0c0b0a0908"
  }
  flow handshake {}
  expect reject fatal/bad_record_mac
}
