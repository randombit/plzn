#!/usr/bin/env bash
# plzn pre-commit gate: run the full check.sh (build + tests + format + lint + clippy)
# before every commit. Version-controlled and activated via
#   git config core.hooksPath hooks
# (see CLAUDE.md). Bypass a single commit with `git commit --no-verify` only
# when you know the change cannot affect the gate.
set -euo pipefail

# Run from the worktree root regardless of where git invoked the hook.
root="$(git rev-parse --show-toplevel)"
cd "$root"

exec ./check.sh
