plzn tls "dtls13/server-flight-selective-ack" {
  rfc 9147 section 5.8
  chain: [default]
  uut server {
    versions: [dtls13]
    mtu: 256
    initial_timeout_ms: 400
    session_tickets: 0
  }
  flow {
    send ClientHello
    suppress_ack
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    expect next_timeout 400ms
    send_ack first
    advance_clock 400ms
    expect_retransmit
    expect next_timeout 800ms
    send_ack all
    expect no_timeout
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/server-flight-progressive-selective-acks" {
  rfc 9147 section 7
  chain: [default]
  uut server {
    versions: [dtls13]
    mtu: 256
    session_tickets: 0
  }
  flow {
    send ClientHello
    suppress_ack
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send_ack last
    advance_clock 400ms
    expect_retransmit
    send_ack even
    advance_clock 800ms
    expect_retransmit
    send_ack odd
    expect no_timeout
    send Finished
  }
  expect ok
}

plzn tls "dtls13/server-ignores-ack-for-previous-flight" {
  rfc 9147 section 7
  chain: [default]
  uut server { versions: [dtls13], session_tickets: 0 }
  flow {
    send ClientHello { +ext key_share = raw "0000" }
    suppress_ack
    recv HelloRetryRequest
    send ClientHello
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send_ack first
    advance_clock 400ms
    expect_retransmit
    send_ack all
    expect no_timeout
    send Finished
  }
  expect ok
}

plzn tls "dtls13/server-ignores-ack-for-forgotten-record" {
  rfc 9147 section 7
  chain: [default]
  uut server {
    versions: [dtls13]
    mtu: 256
    session_tickets: 0
  }
  flow {
    send ClientHello
    suppress_ack
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    advance_clock 400ms
    expect_retransmit
    advance_clock 800ms
    expect_retransmit
    advance_clock 1600ms
    expect_retransmit
    advance_clock 3200ms
    expect_retransmit
    advance_clock 6400ms
    expect_retransmit
    advance_clock 12800ms
    expect_retransmit
    advance_clock 25600ms
    expect_retransmit
    advance_clock 51200ms
    expect_retransmit
    advance_clock 60s
    expect_retransmit
    advance_clock 60s
    expect_retransmit
    advance_clock 60s
    expect_retransmit
    send_ack first
    advance_clock 60s
    expect_retransmit
    send Finished
  }
  expect ok
}

plzn tls "dtls13/server-acks-retransmitted-finished-after-appdata-until-epoch-expires" {
  rfc 9147 section 5.8
  chain: [default]
  uut server { versions: [dtls13], session_tickets: 0 }
  flow handshake until send Finished {
    send Finished
    expect_ack
    send AppData
    recv AppData
    retransmit_previous_epoch Finished
    advance_clock 100ms
    expect_ack
    # BoringSSL retains the prior read epoch for four minutes.
    advance_clock 241s
    retransmit_previous_epoch Finished
    wait 300ms
  }
  expect ok
}

plzn tls "dtls13/server-flight-duplicate-ack-is-idempotent" {
  rfc 9147 section 5.8
  chain: [default]
  uut server {
    versions: [dtls13]
    mtu: 256
    initial_timeout_ms: 400
    session_tickets: 0
  }
  flow {
    send ClientHello
    suppress_ack
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send_ack first
    advance_clock 400ms
    expect_retransmit
    send_ack first
    advance_clock 800ms
    expect_retransmit
    send_ack all
    expect no_timeout
    send Finished
  }
  expect ok
}

plzn tls "dtls13/server-rejects-ack-at-lower-epoch" {
  rfc 9147 section 7
  chain: [default]
  uut server {
    versions: [dtls13]
    session_tickets: 0
  }
  flow {
    send ClientHello
    suppress_ack
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send_ack all outer_epoch 0
    recv Finished
  }
  expect alert fatal/decode_error
  expect alert fatal/illegal_parameter if boringssl
}

plzn tls "dtls13/server-rejects-overflowing-ack-epoch" {
  rfc 9147 section 7
  chain: [default]
  uut server {
    versions: [dtls13]
    session_tickets: 0
  }
  flow {
    send ClientHello
    suppress_ack
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send_ack first outer_epoch 0 overflow_epoch
    recv Finished
  }
  expect alert fatal/decode_error
  expect alert fatal/illegal_parameter if boringssl
}
