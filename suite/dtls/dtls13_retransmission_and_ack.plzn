    advance_clock 400ms
    expect_retransmit
    advance_clock 800ms
    expect_retransmit
    advance_clock 1600ms
    expect_retransmit
    advance_clock 3200ms
    expect_retransmit
    advance_clock 6400ms
    expect_retransmit
    advance_clock 12800ms
    expect_retransmit
    advance_clock 25600ms
    expect_retransmit
    advance_clock 51200ms
    expect_retransmit
    advance_clock 60s
