plzn tls "dtls13/server-discards-fragment-at-window-upper-bound" {
  rfc 9147 section 5.8
  chain: [default]
  uut server { versions: [dtls13] }
  # Seven is the first message sequence outside the receiver's flight window.
  flow handshake { send ClientHello @ future_sequence 7 }
  expect ok
}

plzn tls "dtls13/client-discards-fragment-at-window-upper-bound" {
  rfc 9147 section 5.8
  chain: [default]
  uut client { versions: [dtls13] }
  # Seven is the first message sequence outside the receiver's flight window.
  flow handshake { send ServerHello @ future_sequence 7 }
  expect ok
}

plzn tls "dtls13/server-processes-valid-fragment-packed-with-future-fragment" {
  rfc 9147 section 5.8
  chain: [default]
  uut server { versions: [dtls13] }
  flow handshake {
    send ClientHello @ future_sequence_packed 1000
    send AppData
    recv AppData
  }
  expect ok
}
