plzn tls "dtls13/server-reassembles-reordered-overlapping-fragments" {
  rfc 9147 section 5.8
  chain: [default]
  uut server { versions: [dtls13] }
  flow handshake { send ClientHello @ reorder_overlap 3 }
  expect ok
}

plzn tls "dtls13/client-reassembles-reordered-overlapping-fragments" {
  rfc 9147 section 5.8
  chain: [default]
  uut client { versions: [dtls13] }
  flow handshake { send ServerHello @ reorder_overlap 3 }
  expect ok
}

plzn tls "dtls13/server-reassembles-duplicate-fragments" {
  rfc 9147 section 5.8
  chain: [default]
  uut server { versions: [dtls13] }
  flow handshake { send ClientHello @ duplicate_fragment 7 }
  expect ok
}

plzn tls "dtls13/client-reassembles-duplicate-fragments" {
  rfc 9147 section 5.8
  chain: [default]
  uut client { versions: [dtls13] }
  flow handshake { send ServerHello @ duplicate_fragment 7 }
  expect ok
}

