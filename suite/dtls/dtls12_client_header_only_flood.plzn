plzn tls "dtls12/client-header-only-flood" {
  rfc 6347 section 4.2.3
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  flow {
    recv ClientHello
    send HelloVerifyRequest
    recv ClientHello
    header_only_flood 8
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
  }
  expect ok
}
