plzn tls "dtls13/client-replay-window" {
  syntax 1.0
  rfc 9147 section 4.5.1
  chain: [default]
  uut client { versions: [dtls13] }
  flow handshake {
    repeat 200 {
      send AppData { size: 1 }
      resend_flight
      recv AppData { size: 1 }
    }
  }
  expect ok
  # Each iteration sends a request and a byte-identical replay of it. The UUT
  # must answer once per iteration and drop every replayed datagram, so exactly
  # 200 application records come back; an answered replay would be a 201st.
  assert app_data_records == 200
}

plzn tls "dtls13/server-replay-window" {
  syntax 1.0
  rfc 9147 section 4.5.1
  chain: [default]
  uut server { versions: [dtls13] }
  flow handshake {
    repeat 200 {
      send AppData { size: 1 }
      resend_flight
      recv AppData { size: 1 }
    }
  }
  expect ok
  assert app_data_records == 200
}

plzn tls "dtls13/client-replay-window-large-gaps" {
  syntax 1.0
  rfc 9147 section 4.2.2
  rfc 9147 section 4.5.1
  chain: [default]
  uut client { versions: [dtls13] }
  flow handshake {
    map_record_sequences multiply 1023
    repeat 200 {
      send AppData { size: 1 }
      resend_flight
      recv AppData { size: 1 }
    }
  }
  expect ok
  assert app_data_records == 200
}

plzn tls "dtls13/client-replay-window-non-monotonic" {
  syntax 1.0
  rfc 9147 section 4.5.1
  chain: [default]
  uut client { versions: [dtls13] }
  flow handshake until send ServerHello {
    # Install the map before protected records allocate numbers, avoiding collision with an earlier ACK.
    # xor 63 delivers each block of 64 record numbers in descending order, so
    # the oldest is 63 behind the newest: a 64-record window, the RFC 6347
    # 4.1.2.6 default and OpenSSL's DTLS 1.3 window (RFC 9147 4.5.1 names no
    # size; BoringSSL's is 256).
    map_record_sequences xor 63
    send ServerHello
    send EncryptedExtensions
    send Certificate
    send CertificateVerify
    send Finished
    recv Finished
    repeat 500 {
      send AppData { size: 1 }
      resend_flight
      recv AppData { size: 1 }
    }
  }
  expect ok
  assert app_data_records == 500
}
