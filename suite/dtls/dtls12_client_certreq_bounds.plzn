plzn tls "dtls12/client-certreq-empty-sigalgs" {
  rfc 5246 section 7.4.4
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  peer { request_client_cert: true }
  flow handshake {
    send CertificateRequest { signature_algorithms: [] }
  }
  expect alert fatal/decode_error
  expect alert fatal/internal_error if openssl
  xfail libressl "accepts a CertificateRequest with an empty signature_algorithms list"
}

plzn tls "dtls12/client-certreq-empty-types" {
  rfc 5246 section 7.4.4
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  peer { request_client_cert: true }
  flow handshake {
    send CertificateRequest { certificate_types: [] }
  }
  expect alert fatal/decode_error
  expect alert fatal/handshake_failure if boringssl
  xfail openssl "accepts a CertificateRequest with an empty certificate_types list"
  xfail libressl "accepts a CertificateRequest with an empty certificate_types list"
}
