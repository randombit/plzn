plzn tls "dtls12/client-cbc-etm-over-dtls" {
  rfc 7366 section 3
  chain: [ecdsa_p256]
  matrix {
    suite in [ECDHE_ECDSA_WITH_AES_128_CBC_SHA, ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, ECDHE_ECDSA_WITH_AES_256_CBC_SHA384, ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA]
  }
  uut client {
    versions: [dtls12]
    cipher_suites: [$suite]
    encrypt_then_mac: true
  }
  flow handshake {
    recv ClientHello { cipher_suites: [$suite], has_ext: encrypt_then_mac }
    send AppData
    recv AppData
  }
  expect ok
}
