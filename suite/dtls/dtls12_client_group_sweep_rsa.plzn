plzn tls "dtls12/client-group-x25519" {
  rfc 8422 section 5.1.1
  chain: [rsa_2048]
  uut client {
    versions: [dtls12]
    curves: [x25519]
  }
  peer { capabilities: [ecdhe_rsa, x25519] }
  flow handshake {
    send AppData
    recv AppData
  }
  expect ok
}

