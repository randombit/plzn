plzn tls "dtls12/duplicate-clienthello-extension" {
  rfc 5246 section 7.4.1.4
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  flow handshake {
    send ClientHello { +ext dup signature_algorithms = raw "00020403" }
  }
  expect alert fatal/{decode_error, illegal_parameter}
}

plzn tls "dtls12/duplicate-serverhello-extension" {
  rfc 5246 section 7.4.1.4
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  flow handshake {
    send ServerHello { +ext dup renegotiation_info = raw "00" }
  }
  expect alert fatal/{decode_error, illegal_parameter}
}

plzn tls "dtls12/empty-server-certificate-list" {
  rfc 5246 section 7.4.2
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  flow handshake {
    send Certificate { entries: 0 }
  }
  expect alert fatal/{decode_error, handshake_failure}
}

plzn tls "dtls12/minor-version-tolerance" {
  rfc 6347 section 4.2.1
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  flow handshake {
    send ClientHello { legacy_version: 0xfe00 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls12/major-version-tolerance" {
  rfc 6347 section 4.2.1
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  flow handshake {
    send ClientHello { legacy_version: 0xfdff }
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/protocol_version if libressl
}

plzn tls "dtls12/version-too-low" {
  rfc 6347 section 4.2.1
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  flow handshake {
    send ClientHello { legacy_version: 0xffff }
  }
  expect alert fatal/protocol_version
}
