plzn tls "dtls13/server-accepts-lengthless-unified-header" {
  rfc 9147 section 4.2.1
  chain: [default]
  uut server { versions: [dtls13] }
  flow handshake {
    send AppData @ dtls13_omit_length
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/client-accepts-lengthless-unified-header" {
  rfc 9147 section 4.2.1
  chain: [default]
  uut client { versions: [dtls13] }
  flow handshake {
    send AppData @ dtls13_omit_length
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/server-accepts-short-record-number" {
  rfc 9147 section 4.2.2
  chain: [default]
  uut server { versions: [dtls13] }
  flow handshake {
    send AppData @ dtls13_short_sequence
    recv AppData
  }
  expect ok
