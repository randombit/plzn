plzn tls "dtls13/server-discards-unnegotiated-cid-header" {
  rfc 9147 section 4.2.1
  chain: [default]
  uut server { versions: [dtls13] }
  flow handshake {
    send AppData { reply: none } @ dtls13_set_cid_bit
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/client-discards-unnegotiated-cid-header" {
  rfc 9147 section 4.2.1
  chain: [default]
  uut client { versions: [dtls13] }
  flow handshake {
    send AppData { reply: none } @ dtls13_set_cid_bit
    send AppData
    recv AppData
  }
  expect ok
}

