plzn tls "dtls12/client-sweep-ecdhe-psk" {
  rfc 5489 section 3
  chain: []
  psk {
    identity: "plzn-dtls-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  matrix {
    suite in [ECDHE_PSK_WITH_AES_128_GCM_SHA256, ECDHE_PSK_WITH_AES_256_GCM_SHA384, ECDHE_PSK_WITH_CHACHA20_POLY1305_SHA256, ECDHE_PSK_WITH_AES_128_CCM_SHA256, ECDHE_PSK_WITH_NULL_SHA, ECDHE_PSK_WITH_NULL_SHA256, ECDHE_PSK_WITH_NULL_SHA384]
  }
  uut client {
    versions: [dtls12]
    cipher_suites: [$suite]
  }
  flow handshake {
    recv ClientHello { cipher_suites: [$suite] }
    send AppData
    recv AppData
  }
  expect ok
}
