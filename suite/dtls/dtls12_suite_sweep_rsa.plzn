plzn tls "dtls12/sweep-rsa" {
  rfc 6347 section 4.1.2
  chain: [rsa_2048]
  uut server { versions: [dtls12] }
  matrix {
    suite in [ECDHE_RSA_WITH_AES_128_GCM_SHA256, ECDHE_RSA_WITH_AES_256_GCM_SHA384, ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256, ECDHE_RSA_WITH_ARIA_128_GCM_SHA256, ECDHE_RSA_WITH_ARIA_256_GCM_SHA384, ECDHE_RSA_WITH_CAMELLIA_128_GCM_SHA256, ECDHE_RSA_WITH_CAMELLIA_256_GCM_SHA384, ECDHE_RSA_WITH_NULL_SHA,
              DHE_RSA_WITH_AES_128_GCM_SHA256, DHE_RSA_WITH_AES_256_GCM_SHA384, DHE_RSA_WITH_CHACHA20_POLY1305_SHA256, DHE_RSA_WITH_ARIA_128_GCM_SHA256, DHE_RSA_WITH_ARIA_256_GCM_SHA384, DHE_RSA_WITH_CAMELLIA_128_GCM_SHA256, DHE_RSA_WITH_CAMELLIA_256_GCM_SHA384, DHE_RSA_WITH_AES_128_CCM, DHE_RSA_WITH_AES_256_CCM,
              RSA_WITH_AES_128_GCM_SHA256, RSA_WITH_AES_256_GCM_SHA384, RSA_WITH_ARIA_128_GCM_SHA256, RSA_WITH_ARIA_256_GCM_SHA384, RSA_WITH_CAMELLIA_128_GCM_SHA256, RSA_WITH_CAMELLIA_256_GCM_SHA384, RSA_WITH_AES_128_CCM, RSA_WITH_AES_256_CCM]
  }
  flow handshake {
    recv ServerHello { cipher_suite: $suite }
    send AppData
    recv AppData
  }
  expect ok
}
