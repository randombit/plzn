plzn tls "dtls12/client-server-point-zero" {
  rfc 8422 section 5.11
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_ecdsa, secp256r1] }
  flow handshake {
    send ServerKeyExchange { key_share_point: zero }
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}

