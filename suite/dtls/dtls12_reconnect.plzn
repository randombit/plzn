plzn tls "dtls12/reconnect" {
  rfc 6347 section 4.2.8
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    dtls_epoch0_restart: true
  }
  flow handshake after recv Finished {
    send AppData
    recv AppData
    restart
    send ClientHello
    recv HelloVerifyRequest
    send ClientHello
    recv ServerHello
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect ok
}
