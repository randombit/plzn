plzn tls "dtls12/server-ignores-stale-initial-client-hello-after-cookie-exchange" {
  rfc 6347 section 4.2.4
  chain: [ecdsa_p256]
  uut server { versions: [dtls12] }
  flow {
    send ClientHello
    hold_retransmit
    recv HelloVerifyRequest
    send ClientHello
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    release_flight
    wait 200ms
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect ok
}

