plzn tls "dtls12/cookie-secret-rotation" {
  rfc 6347 section 4.2.1
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    dtls_require_cookie: true
  }
  flow {
    send ClientHello
    recv HelloVerifyRequest
    rotate_cookie_secret
    send ClientHello
    recv HelloVerifyRequest
    send ClientHello
    recv ServerHello
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
  }
  expect ok
  expect alert fatal/handshake_failure if openssl
  expect alert fatal/handshake_failure if libressl
}
