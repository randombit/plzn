plzn tls "dtls12/client-initiated-renegotiation-cookie" {
  rfc 6347 section 4.2.1
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    renegotiate_after_handshake: true
  }
  flow handshake after send Finished {
    send AppData
    recv AppData
    recv ClientHello { has_ext: renegotiation_info }
    send HelloVerifyRequest
    recv ClientHello { has_ext: renegotiation_info }
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}
