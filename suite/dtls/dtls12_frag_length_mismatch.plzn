plzn tls "dtls12/frag-length-mismatch" {
  rfc 6347 section 4.2.3
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  # Botan (PR #5783, 2026-11-03) lets an epoch-0 ClientHello fragment whose
  # header disagrees with the buffered slot restart that slot instead of
  # alerting, so one planted fragment cannot sink every later handshake
  # attempt. The sibling cases below pin that behaviour and its limits.
  skip botan "restarts the unauthenticated ClientHello reassembly from the conflicting fragment instead of alerting; see the sibling cases"
  xfail openssl "abandons the handshake without an alert when fragments disagree on the message length"
  flow handshake { send ClientHello @ length_mismatch 16 }
  expect alert fatal/decode_error
  expect alert fatal/illegal_parameter if boringssl
  expect close if libressl
}

# Botan's side of the case above: the conflicting fragment silently replaces
# the slot, and a retransmitted, consistent ClientHello then completes the
# handshake. `retransmit_flight` would replay the inconsistent fragments, and a
# second `send ClientHello` is suppressed until a HelloVerifyRequest arrives, so
# the retransmission is plzn's own first ClientHello for this case (deterministic
# seeding) sent raw under record sequence number 5, as a retransmission timer
# would send it. Regenerate the literal if plzn's default DTLS 1.2 ClientHello
# changes: Botan's cookie binds the hello, so a stale literal fails at
# `recv ServerHello` with a second HelloVerifyRequest.
plzn tls "dtls12/frag-length-mismatch-restart" {
  rfc 6347 section 4.2.3
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  skip openssl "aborts at the inconsistent fragment; see dtls12/frag-length-mismatch"
  skip libressl "aborts at the inconsistent fragment; see dtls12/frag-length-mismatch"
  skip boringssl "aborts at the inconsistent fragment; see dtls12/frag-length-mismatch"
  flow handshake until send ClientHello {
    send ClientHello @ length_mismatch 200
    send raw ""
    recv HelloVerifyRequest
    send ClientHello
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect ok
}

# The leniency is confined to the unauthenticated first ClientHello: the same
# inconsistency in a server-sent message, or in a client message after the
# cookie exchange, remains a fatal decode error on Botan.
plzn tls "dtls12/frag-length-mismatch-to-client" {
  rfc 6347 section 4.2.3
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  xfail openssl "abandons the handshake without an alert when fragments disagree on the message length"
  flow handshake { send ServerHello @ length_mismatch 16 }
  expect alert fatal/decode_error
  expect alert fatal/illegal_parameter if boringssl
  expect close if libressl
}

plzn tls "dtls12/frag-length-mismatch-after-cookie" {
  rfc 6347 section 4.2.3
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  xfail openssl "abandons the handshake without an alert when fragments disagree on the message length"
  flow handshake { send ClientKeyExchange @ length_mismatch 16 }
  expect alert fatal/decode_error
  expect alert fatal/illegal_parameter if boringssl
  expect close if libressl
}
