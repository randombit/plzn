plzn tls "dtls12/alpn-server" {
  rfc 7301 section 3.2
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    alpn_select: "foo"
    expect_alpn: "foo"
  }
  flow handshake {
    send ClientHello { +ext alpn = ["foo", "bar", "baz"] }
    recv ServerHello { ext alpn == "foo" }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls12/alpn-client" {
  rfc 7301 section 3.1
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    alpn_advertise: ["foo", "bar", "baz"]
    expect_alpn: "foo"
  }
  flow {
    recv ClientHello { ext alpn == ["foo", "bar", "baz"] }
    send HelloVerifyRequest
    recv ClientHello { ext alpn == ["foo", "bar", "baz"] }
    send ServerHello { +ext alpn = "foo" }
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls12/alpn-server-decline" {
  rfc 7301 section 3.2
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    alpn_decline: true
  }
  flow handshake {
    send ClientHello { +ext alpn = ["foo", "bar"] }
    recv ServerHello { lacks_ext: alpn }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls12/alpn-server-no-common" {
  rfc 7301 section 3.2
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    alpn_select: "http/1.1"
  }
  flow handshake {
    send ClientHello { +ext alpn = ["h2"] }
  }
  expect alert fatal/no_application_protocol
}

plzn tls "dtls12/alpn-client-reject-unknown" {
  rfc 7301 section 3.2
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    alpn_advertise: ["foo", "bar"]
  }
  flow handshake {
    send ServerHello { +ext alpn = "baz" }
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if openssl
}

plzn tls "dtls12/alpn-server-empty-protocol" {
  rfc 7301 section 3.1
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    alpn_select: "foo"
  }
  flow handshake {
    # Encodes "foo", an empty protocol name, then "baz".
    send ClientHello { +ext alpn = raw "000903666f6f000362617a" }
  }
  expect alert fatal/decode_error
}

plzn tls "dtls12/alpn-client-empty-selection" {
  rfc 7301 section 3.1
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    alpn_advertise: ["foo"]
  }
  flow handshake {
    # Encodes a ProtocolNameList containing one empty name.
    send ServerHello { +ext alpn = raw "000100" }
  }
  expect alert fatal/decode_error
}

plzn tls "dtls12/alpn-server-resumption" {
  rfc 7301 section 3.1
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    alpn_select: "foo"
    expect_alpn: "foo"
  }

  session initial {
    flow handshake {
      send ClientHello { +ext alpn = ["foo", "bar"] }
      recv ServerHello { ext alpn == "foo" }
      send AppData
      recv AppData
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send ClientHello { +ext alpn = ["foo", "bar"] }
      recv ServerHello { ext alpn == "foo" }
      send AppData
      recv AppData
    }
    expect ok
  }
}

plzn tls "dtls12/alpn-client-resumption" {
  rfc 7301 section 3.1
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    alpn_advertise: ["foo", "bar"]
    expect_alpn: "foo"
  }

  session initial {
    flow handshake {
      recv ClientHello { ext alpn == ["foo", "bar"] }
      send ServerHello { +ext alpn = "foo" }
      send AppData
      recv AppData
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      recv ClientHello { ext alpn == ["foo", "bar"] }
      send ServerHello { +ext alpn = "foo" }
      send AppData
      recv AppData
    }
    expect ok
  }
  xfail libressl "its DTLS client fails every abbreviated handshake with an internal error (transcript never freed)"
}
