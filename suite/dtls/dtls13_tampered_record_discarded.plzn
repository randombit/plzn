plzn tls "dtls13/server-tampered-record-discarded" {
  rfc 9147 section 4.5.2
  chain: [default]
  uut server { versions: [dtls13] }
  matrix {
    suite in [AES_128_GCM_SHA256, AES_256_GCM_SHA384, CHACHA20_POLY1305_SHA256]
  }
  flow handshake {
    send AppData { reply: none } @ xor[record.aead_tag, -1] = 0x01
    send AppData
    recv AppData
  }
  expect ok
}
