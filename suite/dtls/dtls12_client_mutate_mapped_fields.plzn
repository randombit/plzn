plzn tls "dtls12/client-mutate-ske-ecdh-point" {
  rfc 8422 section 5.11
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_ecdsa, secp256r1] }
  flow handshake {
    send ServerKeyExchange @ xor[handshake.ecdh_point, 1] = 0x01
  }
  expect alert fatal/{decrypt_error, illegal_parameter}
  expect alert fatal/decode_error if libressl
}

plzn tls "dtls12/client-mutate-certificate-list" {
  rfc 5246 section 7.4.2
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    verify_peer: true
  }
  flow handshake {
    # Index 8 of certificate_list lands inside the leaf's tbsCertificate.
    send Certificate @ xor[handshake.certificate_list, 8] = 0x01
  }
  expect alert fatal/{bad_certificate, decode_error}
}
