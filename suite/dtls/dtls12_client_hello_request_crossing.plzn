plzn tls "dtls12/client-hello-request-crossing" {
  rfc 5246 section 7.4.1.1
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    renegotiation: server
  }
  flow handshake after send Finished {
    send HelloRequest
    recv ClientHello
    send HelloRequest
    wait 200ms
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}
