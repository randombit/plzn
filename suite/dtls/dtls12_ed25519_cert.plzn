plzn tls "dtls12/ed25519-cert" {
  rfc 8422 section 5.4
  chain: [ed25519]
  uut server {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_ecdsa] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ed25519] }
    send AppData
    recv AppData
  }
  expect ok
  xfail openssl "cannot use an Ed25519 certificate in DTLS 1.2 (its version check expects a TLS version number; fixed after 3.6)"
  expect alert fatal/handshake_failure if botan
}
