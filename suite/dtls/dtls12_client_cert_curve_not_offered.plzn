plzn tls "dtls12/client-cert-curve-not-offered" {
  rfc 8422 section 5.1.1
  chain: [ecdsa_p256]
  xfail botan "accepts a client certificate whose curve was absent from the server's supported_groups"
  uut client {
    versions: [dtls12]
    curves: [secp384r1]
  }
  peer { capabilities: [ecdhe_ecdsa] }
  flow handshake {
    send AppData
    recv AppData
  }
  expect alert fatal/illegal_parameter
  xfail libressl "accepts a server certificate whose curve was absent from its supported_groups"
}
