plzn tls "dtls12/client-sweep-ecdsa" {
  rfc 6347 section 4.1.2
  chain: [ecdsa_p256]
  matrix {
    suite in [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256,
              ECDHE_ECDSA_WITH_AES_128_CBC_SHA, ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, ECDHE_ECDSA_WITH_AES_256_CBC_SHA, ECDHE_ECDSA_WITH_AES_256_CBC_SHA384, ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA,
              ECDHE_ECDSA_WITH_ARIA_128_GCM_SHA256, ECDHE_ECDSA_WITH_ARIA_256_GCM_SHA384, ECDHE_ECDSA_WITH_CAMELLIA_128_GCM_SHA256, ECDHE_ECDSA_WITH_CAMELLIA_256_GCM_SHA384,
              ECDHE_ECDSA_WITH_AES_128_CCM, ECDHE_ECDSA_WITH_AES_256_CCM, ECDHE_ECDSA_WITH_AES_128_CCM_8, ECDHE_ECDSA_WITH_AES_256_CCM_8,
              ECDHE_ECDSA_WITH_NULL_SHA]
  }
  uut client {
    versions: [dtls12]
    cipher_suites: [$suite]
    encrypt_then_mac: false
  }
  flow handshake {
    recv ClientHello { cipher_suites: [$suite], lacks_ext: encrypt_then_mac }
    send AppData
    recv AppData
  }
  expect ok
}
