plzn tls "dtls12/client-sweep-psk" {
  rfc 4279 section 2
  chain: []
  psk {
    identity: "plzn-dtls-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  matrix {
    suite in [PSK_WITH_AES_128_GCM_SHA256, PSK_WITH_AES_256_GCM_SHA384, PSK_WITH_CHACHA20_POLY1305_SHA256, PSK_WITH_ARIA_128_GCM_SHA256, PSK_WITH_ARIA_256_GCM_SHA384, PSK_WITH_CAMELLIA_128_GCM_SHA256, PSK_WITH_CAMELLIA_256_GCM_SHA384, PSK_WITH_AES_128_CCM, PSK_WITH_AES_256_CCM, PSK_WITH_NULL_SHA, PSK_WITH_NULL_SHA256, PSK_WITH_NULL_SHA384]
  }
  uut client {
    versions: [dtls12]
    cipher_suites: [$suite]
  }
  flow handshake {
    recv ClientHello { cipher_suites: [$suite] }
    send AppData
    recv AppData
  }
  expect ok
}
