}

plzn tls "dtls12/mandatory-server-message-omissions/server-hello-done" {
  rfc 5246 section 7.4.5
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    initial_timeout_ms: 1
    dtls_max_retransmissions: 2
  }
  flow {
    recv ClientHello
    send HelloVerifyRequest
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    hold_flight
    release_flight [0, 1, 2]
    advance_clock 1ms
    expect_retransmit
    advance_clock 2ms
    expect_retransmit
    advance_clock 4ms
  }
  expect timeout
}

plzn tls "dtls12/mandatory-server-message-omissions/change-cipher-spec" {
  rfc 5246 section 7.1
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    initial_timeout_ms: 1
    dtls_max_retransmissions: 2
  }
  flow {
    recv ClientHello
    send HelloVerifyRequest
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    hold_flight
    release_flight [1]
    advance_clock 1ms
    expect_retransmit
    advance_clock 2ms
    expect_retransmit
    advance_clock 4ms
  }
  expect timeout
}

plzn tls "dtls12/mandatory-server-message-omissions/finished" {
  rfc 5246 section 7.4.9
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    initial_timeout_ms: 1
    dtls_max_retransmissions: 2
  }
  flow {
    recv ClientHello
    send HelloVerifyRequest
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    hold_flight
    release_flight [0]
    advance_clock 1ms
    expect_retransmit
    advance_clock 2ms
    expect_retransmit
    advance_clock 4ms
  }
  expect timeout
}
