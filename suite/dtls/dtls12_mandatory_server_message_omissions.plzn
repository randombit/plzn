plzn tls "dtls12/mandatory-server-message-omissions/server-hello" {
  rfc 6347 section 4.2.2
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    initial_timeout_ms: 1
    dtls_max_retransmissions: 2
  }
  flow {
    recv ClientHello
    send HelloVerifyRequest
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    hold_flight
    release_flight [1, 2, 3]
    advance_clock 1ms
    expect_retransmit
    advance_clock 2ms
    expect_retransmit
    advance_clock 4ms
  }
  expect timeout
}

plzn tls "dtls12/mandatory-server-message-omissions/certificate" {
  rfc 5246 section 7.4.2
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
    initial_timeout_ms: 1
    dtls_max_retransmissions: 2
  }
  flow {
    recv ClientHello
    send HelloVerifyRequest
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    hold_flight
    release_flight [0, 2, 3]
    advance_clock 1ms
    expect_retransmit
    advance_clock 2ms
    expect_retransmit
    advance_clock 4ms
  }
  expect timeout
}

plzn tls "dtls12/mandatory-server-message-omissions/server-key-exchange" {
  rfc 5246 section 7.4.3
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
