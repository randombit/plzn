    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    hold_flight
    release_flight [0, 1, 3]
    advance_clock 1ms
    expect_retransmit
    advance_clock 2ms
    expect_retransmit
    advance_clock 4ms
  }
