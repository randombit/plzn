plzn tls "dtls13/server-rejects-fragment-type-mismatch" {
  rfc 9147 section 5.5
  chain: [default]
  uut server { versions: [dtls13] }
  flow handshake { send ClientHello @ type_mismatch 16 }
  expect alert fatal/{decode_error, illegal_parameter}
}

plzn tls "dtls13/client-rejects-fragment-type-mismatch" {
  rfc 9147 section 5.5
  chain: [default]
  uut client { versions: [dtls13] }
  flow handshake { send ServerHello @ type_mismatch 16 }
  expect alert fatal/{decode_error, illegal_parameter}
}

