plzn tls "dtls12/malformed-supported-groups" {
  rfc 5246 section 7.4.1.4
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_ecdsa] }
  flow handshake {
    send ClientHello {
      +ext supported_groups = raw "00"
    }
  }
  expect alert fatal/decode_error
}
