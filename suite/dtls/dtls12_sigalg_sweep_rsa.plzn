plzn tls "dtls12/sigalg-rsa-pss-sha256" {
  rfc 5246 section 7.4.1.4.1
  chain: [rsa_2048]
  uut server {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_rsa] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256] }
    recv ServerKeyExchange { signature_scheme: rsa_pss_rsae_sha256 }
    send AppData
    recv AppData
  }
  expect ok
}

