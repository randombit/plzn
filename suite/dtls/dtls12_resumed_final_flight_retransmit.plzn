plzn tls "dtls12/resumed-final-flight-retransmits-after-activation" {
  rfc 6347 section 4.2.4
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }

  session initial {
    flow handshake {
      send AppData
      recv AppData
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake after recv Finished {
      send ChangeCipherSpec
      send Finished
      hold_flight
      advance_clock 1s
      expect_retransmit
      retransmit_flight
      release_flight
      send AppData
      recv AppData
    }
    expect ok
  }
}
