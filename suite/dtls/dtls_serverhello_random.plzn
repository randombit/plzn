plzn tls "dtls12/serverhello-random-fresh-across-connections" {
  rfc 5246 section 7.4.1.3
  chain: [default]
  uut server { versions: [dtls12] }
  repeat 8
  flow handshake {
    recv ServerHello { random: capture $random }
    send AppData
    recv AppData
  }
  expect ok
  assert unique $random
}

plzn tls "dtls13/serverhello-random-fresh-across-connections" {
  rfc 9846 section 4.2.3
  chain: [default]
  uut server { versions: [dtls13] }
  repeat 8
  flow handshake {
    recv ServerHello { random: capture $random }
    send AppData
    recv AppData
  }
  expect ok
  assert unique $random
}
