plzn tls "dtls13/server-rejects-corrupt-resumption-psk-binder" {
  rfc 8446 section 4.2.11.2
  chain: [default]
  uut server { versions: [dtls13] }

  session initial {
    flow handshake {
      recv NewSessionTicket
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send ClientHello @ xor[handshake.psk_binder, -1] = 0x01
    }
    expect alert fatal/{decrypt_error, illegal_parameter}
  }
}

plzn tls "dtls13/server-rejects-resumption-pre-shared-key-not-last" {
  rfc 8446 section 4.2.11
  chain: [default]
  uut server { versions: [dtls13] }

  session initial {
    flow handshake {
      recv NewSessionTicket
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send ClientHello { reverse_extensions }
    }
    expect alert fatal/illegal_parameter
  }
}
