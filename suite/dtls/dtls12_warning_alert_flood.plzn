plzn tls "dtls12/warning-alert-flood/server-application-data-over-thirty-two" {
  rfc 6347 section 4.1
  rfc 5246 section 7.2.1
  chain: [ecdsa_p256]
  uut server { versions: [dtls12] }
  matrix {
    count in [33, 100]
  }
  flow handshake {
    repeat $count { send alert warning/user_canceled }
    send AppData
    recv AppData
    wait 50ms
  }
  expect ok
  expect alert fatal/unexpected_message if openssl
  expect alert fatal/unexpected_message if boringssl
  expect alert fatal/unexpected_message if botan
}

plzn tls "dtls12/warning-alert-flood/client-handshake-before-server-hello-one-to-four" {
  rfc 6347 section 4.1
  rfc 5246 section 7.2.1
  chain: [ecdsa_p256]
  uut client { versions: [dtls12] }
  matrix {
    count in [1, 4]
  }
  flow handshake until send ServerHello {
    repeat $count { send alert warning/user_canceled }
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
    wait 50ms
  }
  expect ok
}

plzn tls "dtls12/warning-alert-flood/client-handshake-before-server-hello-five-to-sixteen" {
  rfc 6347 section 4.1
  rfc 5246 section 7.2.1
  chain: [ecdsa_p256]
  uut client { versions: [dtls12] }
  matrix {
    count in [5, 16]
  }
  flow handshake until send ServerHello {
    repeat $count { send alert warning/user_canceled }
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
    wait 50ms
  }
  expect ok
  expect alert fatal/unexpected_message if openssl
  expect alert fatal/unexpected_message if boringssl
}

