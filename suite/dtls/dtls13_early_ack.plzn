# RFC 9147 7.1: a flight that the next flight answers is implicitly
# acknowledged, and ACKs "SHOULD NOT be sent for these flights unless the
# responding flight cannot be generated immediately". The same section lets an
# implementation "send explicit ACKs for the complete received flight even
# though it will eventually also be implicitly acknowledged", and recommends an
# ACK for a partially received flight. A peer must therefore accept an ACK that
# arrives before the flight which implicitly acknowledges its own. OpenSSL
# 4.1.0's DTLS 1.3 server answers such an ACK with a fatal unexpected_message
# (fixed on its master by 9a4ce25036); plzn's client used to acknowledge every
# record of the server's flight as it read it, which is why no DTLS 1.3
# handshake completed against OpenSSL 4.1.0 until plzn followed the SHOULD NOT.
# These cases keep the early ACK as a deliberate, explicit step.
#
# OpenSSL's DTLS 1.3 client has the mirror-image problem: an ACK that arrives
# before the ServerHello (a server acknowledging the ClientHello flight, RFC
# 9147 7 allows an epoch 0 ACK for epoch 0 records) draws fatal
# unexpected_message. rec_layer_d1.c means to drop such an ACK while the
# version is DTLS_ANY_VERSION, but negotiated_version stays PROTO_VERSION_UNSET
# until the ServerHello, so the default branch (SSL_R_UNEXPECTED_RECORD) fires
# instead; still so on master as of 2026-11-18.

plzn tls "dtls13/server-tolerates-ack-of-complete-flight-before-finished" {
  rfc 9147 section 7.1
  chain: [default]
  uut server { versions: [dtls13] }
  flow {
    send ClientHello
    suppress_ack
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send_ack all
    send Finished
    send AppData
    recv AppData
  }
  expect ok
  xfail openssl "OpenSSL 4.1.0 answers an ACK received before the client's Finished with fatal unexpected_message (fixed on master by 9a4ce25036)"
}

# The small MTU spreads the server's flight over several records, so the ACK
# after EncryptedExtensions covers only part of it: the case RFC 9147 7.1
# recommends an ACK for when the rest of the flight does not arrive at once.
plzn tls "dtls13/server-tolerates-ack-of-partial-flight-before-finished" {
  rfc 9147 section 7.1
  chain: [default]
  uut server {
    versions: [dtls13]
    mtu: 256
  }
  flow {
    send ClientHello
    suppress_ack
    recv ServerHello
    recv EncryptedExtensions
    send_ack all
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData
    recv AppData
  }
  expect ok
  xfail openssl "OpenSSL 4.1.0 answers an ACK received before the client's Finished with fatal unexpected_message (fixed on master by 9a4ce25036)"
}

# The client-side counterpart: the server acknowledges the ClientHello flight
# (an epoch 0 ACK) before answering it. The client's Finished is then ACKed
# explicitly too, since suppress_ack also stops the automatic one.
plzn tls "dtls13/client-tolerates-ack-of-client-hello-before-server-hello" {
  rfc 9147 section 7.1
  chain: [default]
  uut client { versions: [dtls13] }
  flow {
    suppress_ack
    recv ClientHello
    send_ack all
    send ServerHello
    send EncryptedExtensions
    send Certificate
    send CertificateVerify
    send Finished
    recv Finished
    send_ack all
    send AppData
    recv AppData
  }
  expect ok
  xfail openssl "answers an epoch 0 ACK received before the ServerHello with fatal unexpected_message (rec_layer_d1.c: negotiated_version is still unset, so the DTLS_ANY_VERSION drop branch is never taken)"
}
