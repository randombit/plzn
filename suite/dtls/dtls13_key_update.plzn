plzn tls "dtls13/server-reciprocates-requested-key-update" {
  rfc 9147 section 8
  chain: [default]
  uut server { versions: [dtls13], session_tickets: 0 }
  flow handshake {
    send KeyUpdate { request_update: update_requested }
    send AppData
    recv KeyUpdate { request_update: update_not_requested }
    recv AppData
    expect next_timeout 100ms
    advance_clock 100ms
    expect_ack
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/client-reciprocates-requested-key-update" {
  rfc 9147 section 8
  chain: [default]
  uut client { versions: [dtls13], session_tickets: 0 }
  flow handshake {
    send KeyUpdate { request_update: update_requested }
    send AppData
    recv KeyUpdate { request_update: update_not_requested }
    recv AppData
    expect next_timeout 100ms
    advance_clock 100ms
    expect_ack
    send AppData
