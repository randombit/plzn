  expect ok
}

plzn tls "dtls13/server-key-update-waits-for-ack-and-retransmits" {
  rfc 9147 section 8
  chain: [default]
  uut server {
    versions: [dtls13]
    session_tickets: 0
    initial_timeout_ms: 400
    key_update: true
  }
  flow handshake {
    suppress_ack
    recv KeyUpdate { request_update: update_not_requested }
    send AppData
    recv AppData
    expect next_timeout 400ms
    advance_clock 400ms
    expect_retransmit
    send_ack all
    expect no_timeout
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/client-key-update-waits-for-ack-and-retransmits" {
  rfc 9147 section 8
  chain: [default]
  uut client {
    versions: [dtls13]
    session_tickets: 0
    initial_timeout_ms: 400
    key_update: true
  }
  flow handshake {
    suppress_ack
    recv KeyUpdate { request_update: update_not_requested }
    send AppData
    recv AppData
    expect next_timeout 400ms
    advance_clock 400ms
    expect_retransmit
    send_ack all
    expect no_timeout
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/server-rejects-key-update-with-extra-data" {
  rfc 9147 section 8
  chain: [default]
  uut server { versions: [dtls13], session_tickets: 0 }
  flow handshake {
    send KeyUpdate { request_update: update_requested } @ pad +1
  }
  expect alert fatal/{decode_error, illegal_parameter}
}

plzn tls "dtls13/client-rejects-key-update-with-extra-data" {
  rfc 9147 section 8
  chain: [default]
  uut client { versions: [dtls13], session_tickets: 0 }
  flow handshake {
    send KeyUpdate { request_update: update_requested } @ pad +1
  }
  expect alert fatal/decode_error
}

