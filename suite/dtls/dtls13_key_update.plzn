plzn tls "dtls13/server-accepts-key-update-and-old-epoch-data-before-ack" {
  rfc 9147 section 8
  chain: [default]
  uut server { versions: [dtls13], session_tickets: 0 }
  flow handshake {
    send KeyUpdate { request_update: update_not_requested }
    send AppData
    recv AppData
    expect next_timeout 100ms
    advance_clock 100ms
    expect_ack
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/client-accepts-key-update-and-old-epoch-data-before-ack" {
  rfc 9147 section 8
  chain: [default]
  uut client { versions: [dtls13], session_tickets: 0 }
  flow handshake {
    send KeyUpdate { request_update: update_not_requested }
    send AppData
    recv AppData
    expect next_timeout 100ms
    advance_clock 100ms
    expect_ack
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "dtls13/server-accepts-repeated-key-updates" {
  rfc 9147 section 8
  chain: [default]
  uut server { versions: [dtls13], session_tickets: 0 }
  flow handshake {
    repeat 10 {
      send KeyUpdate { request_update: update_not_requested }
      send AppData
      recv AppData
      expect next_timeout 100ms
      advance_clock 100ms
      expect_ack
    }
  }
  expect ok
}

plzn tls "dtls13/client-accepts-repeated-key-updates" {
  rfc 9147 section 8
  chain: [default]
