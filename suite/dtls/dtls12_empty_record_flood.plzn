  expect alert fatal/unexpected_message if botan
}

plzn tls "dtls12/empty-record-flood/client-plaintext-handshake-before-server-hello-one-to-two-hundred-and-one" {
  rfc 6347 section 4.1
  rfc 5246 section 6.2.1
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  matrix {
    count in [1, 32, 33, 200, 201]
  }
  flow handshake until send ServerHello {
    repeat $count { send empty_record handshake }
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
    wait 50ms
  }
  expect ok
}

