plzn tls "dtls12/cbc-etm-over-dtls" {
  rfc 7366 section 3
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    encrypt_then_mac: true
  }
  matrix {
    suite in [ECDHE_ECDSA_WITH_AES_128_CBC_SHA, ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, ECDHE_ECDSA_WITH_AES_256_CBC_SHA384, ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA]
  }
  flow handshake {
    send ClientHello {
      +ext encrypt_then_mac
    }
    recv ServerHello { cipher_suite: $suite, has_ext: encrypt_then_mac }
    send AppData
    recv AppData
  }
  expect ok
}
