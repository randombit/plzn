plzn tls "dtls12/ecdhe-psk-cke-point-zero" {
  rfc 8422 section 5.11
  chain: []
  uut server {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_psk, secp256r1] }
  psk {
    identity: "plzn-dtls-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  flow handshake {
    send ClientKeyExchange { key_share_point: zero }
  }
  expect alert fatal/illegal_parameter
}

plzn tls "dtls12/ecdhe-psk-cke-point-truncated" {
  rfc 8422 section 5.7
  chain: []
  uut server {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_psk, secp256r1] }
