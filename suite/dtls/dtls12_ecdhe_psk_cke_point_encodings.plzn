plzn tls "dtls12/ecdhe-psk-cke-point-compressed" {
  rfc 8422 section 5.1.2
  chain: []
  uut server {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_psk, secp256r1] }
  skip boringssl "supports only the mandatory uncompressed point format and does not negotiate compressed points"
  psk {
    identity: "plzn-dtls-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  flow handshake {
    send ClientKeyExchange { key_share_point: compressed }
    send AppData
    recv AppData
  }
  expect ok
}
