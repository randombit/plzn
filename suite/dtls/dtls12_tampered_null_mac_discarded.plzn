plzn tls "dtls12/tampered-null-mac-discarded" {
  rfc 6347 section 4.1.2.7
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  matrix {
    suite in [ECDHE_ECDSA_WITH_NULL_SHA]
  }
  flow handshake {
    recv ServerHello { cipher_suite: $suite }
    send AppData { reply: none } @ xor[record.mac, 0] = 0x01
    send AppData
    recv AppData
  }
  expect ok
  xfail libressl "a silently discarded bad-MAC record leaves an error queued, so SSL_read reports SSL_ERROR_SSL"
}
