plzn tls "dtls12/client-sigalg-sweep-rsa" {
  rfc 5246 section 7.4.1.4.1
  chain: [rsa_2048]
  uut client {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_rsa] }
  matrix { scheme in [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512, rsa_pkcs1_sha256, rsa_pkcs1_sha384, rsa_pkcs1_sha512] }
  flow handshake {
    send ServerKeyExchange { signature_scheme: $scheme }
    send AppData
    recv AppData
  }
  expect ok
}
