plzn tls "dtls12/server-max-handshake-message-size/cookie-client-hello-over-limit" {
  syntax 1.1
  rfc 6347 section 4.2.2
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    max_handshake_message_size: 4096
  }
  flow handshake until send ClientHello {
    send ClientHello
    recv HelloVerifyRequest
    send ClientHello @ pad to 4097, @ fragment 256
    hold_flight
    release_flight [0]
  }
  expect alert fatal/handshake_failure
}

