plzn tls "dtls12/client-auth-bad-certificate-verify" {
  rfc 5246 section 7.4.8
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
    require_client_cert: true
  }
  flow handshake {
    send CertificateVerify @ xor[-1] = 0x01
  }
  expect alert fatal/decrypt_error
  expect alert fatal/internal_error if libressl
}
