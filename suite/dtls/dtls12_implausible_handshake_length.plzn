plzn tls "dtls12/client-implausible-handshake-length/hello-request" {
  syntax 1.0
  rfc 6347 section 4.2.2
  chain: [ecdsa_p256]
  uut client { versions: [dtls12] }
  xfail gnutls "never checks the HelloRequest length and starts a renegotiation"
  flow handshake after send Finished {
    send AppData
    recv AppData
    send HelloRequest @ set[handshake.length, 0..2] = 0xff
    wait 300 ms
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/handshake_failure if botan
  expect alert fatal/decode_error if libressl
}
