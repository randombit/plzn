plzn tls "dtls12/mutate-cke-ecdh-point" {
  rfc 8422 section 5.11
  chain: [ecdsa_p256]
  uut server {
    versions: [dtls12]
  }
  peer { capabilities: [ecdhe_ecdsa, secp256r1] }
  flow handshake {
    send ClientKeyExchange @ xor[handshake.ecdh_point, 1] = 0x01
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}
