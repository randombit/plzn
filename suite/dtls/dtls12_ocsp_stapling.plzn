plzn tls "dtls12/ocsp-stapling-empty-response" {
  rfc 6066 section 8
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  skip openssl "the OpenSSL client shim does not enable status_request"
  flow {
    recv ClientHello { has_ext: status_request }
    send HelloVerifyRequest
    recv ClientHello { has_ext: status_request }
    send ServerHello { +ext status_request }
    send Certificate
    send CertificateStatus { response: [] }
    wait 300ms
  }
  expect alert fatal/decode_error
  skip libressl "does not offer status_request unless configured (no shim knob yet)"
}

plzn tls "dtls12/ocsp-stapling-unknown-status-type" {
  rfc 6066 section 8
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  skip openssl "the OpenSSL client shim does not enable status_request"
  flow {
    recv ClientHello { has_ext: status_request }
    send HelloVerifyRequest
    recv ClientHello { has_ext: status_request }
    send ServerHello { +ext status_request }
    send Certificate
    send CertificateStatus @ set[handshake.status_type, 0] = 2
    wait 300ms
  }
  expect alert fatal/decode_error
  skip libressl "does not offer status_request unless configured (no shim knob yet)"
}
