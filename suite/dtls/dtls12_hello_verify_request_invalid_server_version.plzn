plzn tls "dtls12/hello-verify-request-invalid-server-version" {
  rfc 6347 section 4.2.1
  chain: [ecdsa_p256]
  uut client {
    versions: [dtls12]
  }
  flow {
    recv ClientHello
    send HelloVerifyRequest { legacy_version: 0x0101, cookie: [] }
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect any { ok, alert fatal/decode_error }
  expect alert fatal/protocol_version if libressl
}
