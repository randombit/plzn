plzn tls "client/tls13-server-certificate-verify-scheme/ed25519" {
  rfc 8446 section 4.4.3
  chain: [ed25519]
  uut client {
    versions: [tls13]
    verify_prefs: [ed25519]
  }
  skip botan "no Ed25519 TLS signature scheme"
  flow handshake {
    recv ClientHello { signature_algorithms: [ed25519] }
    send CertificateVerify { algorithm: ed25519 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls13-server-certificate-verify-scheme/unoffered" {
  rfc 8446 section 4.4.3
  chain: [rsa_2048]
  uut client {
    versions: [tls13]
    verify_prefs: [rsa_pss_rsae_sha256]
  }
  flow handshake {
    recv ClientHello { signature_algorithms: [rsa_pss_rsae_sha256] }
    send CertificateVerify { algorithm: rsa_pss_rsae_sha384 }
    wait 300ms
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/handshake_failure if openssl
}
