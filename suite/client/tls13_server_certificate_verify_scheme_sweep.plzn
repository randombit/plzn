plzn tls "client/tls13-server-certificate-verify-scheme/rsa-pss-rsae" {
  rfc 8446 section 4.4.3
  chain: [rsa_2048]
  uut client {
    versions: [tls13]
    verify_prefs: [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
  }
  matrix {
    scheme in [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
  }
  flow handshake {
    recv ClientHello { signature_algorithms: [$scheme] }
    send CertificateVerify { algorithm: $scheme }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls13-server-certificate-verify-scheme/rsa-pss-pss" {
  rfc 8446 section 4.4.3
  chain: [rsa_pss]
  uut client {
    versions: [tls13]
    verify_prefs: [rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512]
  }
  matrix {
    scheme in [rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512]
  }
  flow handshake {
    recv ClientHello { signature_algorithms: [$scheme] }
    send CertificateVerify { algorithm: $scheme }
    send AppData
    recv AppData
  }
  expect ok
}

