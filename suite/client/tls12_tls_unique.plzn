plzn tls "client/tls12-tls-unique-full-handshake" {
  rfc 5929 section 3
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake {
    recv TLSUnique
  }
  expect ok
}

plzn tls "client/tls12-tls-unique-resumption-with-ems" {
  rfc 7627 section 5.4
  chain: [default]
  uut client { versions: [tls12] }

  session initial {
    flow handshake {
      recv TLSUnique
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      recv TLSUnique
    }
    expect ok
  }
  skip libressl "does not implement extended_master_secret"
}

plzn tls "client/tls12-tls-unique-unavailable-on-resumption-without-ems" {
  rfc 7627 section 5.4
  chain: [default]
  uut client {
    versions: [tls12]
    extended_master_secret: off
  }

  session initial {
    flow handshake {
      send ServerHello { -ext extended_master_secret }
      recv ClientHello { has_ext: session_ticket }
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send ServerHello { -ext extended_master_secret }
      recv TLSUnique { unavailable: true }
    }
    expect ok
  }
}
