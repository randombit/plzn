plzn tls "client/tls12-wrong-type-serverhello" {
  rfc 5246 section 7.4
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake {
    send ServerHello @ set[handshake.msg_type, 0] = 0xff
  }
  expect alert fatal/{unexpected_message,decode_error}
}

plzn tls "client/tls12-wrong-type-server-certificate" {
  rfc 5246 section 7.4
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake {
    send Certificate @ set[handshake.msg_type, 0] = 0xff
