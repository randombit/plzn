plzn tls "client/tls12-wrong-type-certificaterequest" {
  rfc 5246 section 7.4
  chain: [default]
  uut client { versions: [tls12] }
  peer { request_client_cert: true }
  flow handshake {
    send CertificateRequest @ set[handshake.msg_type, 0] = 0xff
  }
  expect alert fatal/{unexpected_message,decode_error}
}

plzn tls "client/tls12-wrong-type-newsessionticket" {
  rfc 5077 section 3.1
  chain: [default]
  uut client { versions: [tls12] }
  peer { capabilities: [session_ticket] }
  skip wolfssl "built without HAVE_SESSION_TICKET: the client never offers SessionTicket, so no NewSessionTicket is sent"
  xfail go "accepts a NewSessionTicket with an unexpected handshake type"
  flow handshake {
    send NewSessionTicket @ set[handshake.msg_type, 0] = 0xff
  }
  expect alert fatal/{unexpected_message,decode_error}
}

