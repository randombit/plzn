plzn tls "client/tls12-multi-chain-ecdsa-scheme-does-not-constrain-curve" {
  rfc 5246 section 7.4.6
  chain: [default]
  uut client {
    versions: [tls12]
  }
  peer { request_client_cert: true }
  client_chain: [ecdsa_p256, ecdsa_p384, rsa_2048]
  xfail rustls "its TLS 1.2 signing keys are curve-bound to the TLS 1.3 interpretation of the ECDSA scheme"
  flow handshake {
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send CertificateRequest { signature_algorithms: [ecdsa_secp384r1_sha384] }
    send ServerHelloDone
    recv Certificate { entries: 1, leaf_key: ecdsa_p256 }
    recv ClientKeyExchange
    recv CertificateVerify
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-multi-chain-picks-rsa" {
  rfc 5246 section 7.4.6
  chain: [default]
  uut client {
    versions: [tls12]
  }
  peer { request_client_cert: true }
  client_chain: [ecdsa_p256, ecdsa_p384, rsa_2048]
  flow handshake {
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send CertificateRequest { signature_algorithms: [rsa_pkcs1_sha256] }
    send ServerHelloDone
    recv Certificate { entries: 1, leaf_key: rsa_2048 }
    recv ClientKeyExchange
    recv CertificateVerify
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-multi-chain-none-fits" {
  rfc 5246 section 7.4.6
  chain: [default]
  uut client {
    versions: [tls12]
  }
  peer { request_client_cert: true }
  client_chain: [ecdsa_p256, ecdsa_p384]
  xfail botan "sends a non-empty Certificate before aborting because no requested signature scheme fits"
  flow handshake {
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send CertificateRequest { certificate_types: [rsa_sign], signature_algorithms: [rsa_pkcs1_sha256] }
    send ServerHelloDone
    recv Certificate { entries: 0 }
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-single-credential-wrong-curve" {
  rfc 5246 section 7.4.6
  chain: [default]
  uut client {
    versions: [tls12]
  }
  peer { request_client_cert: true }
  client_chain: [ecdsa_p256]
  xfail rustls "its TLS 1.2 signing key is scheme-bound and declines SHA-384 with a P-256 key"
  flow handshake {
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send CertificateRequest { signature_algorithms: [ecdsa_secp384r1_sha384] }
    send ServerHelloDone
    recv Certificate { entries: 1, leaf_key: ecdsa_p256 }
    recv ClientKeyExchange
    recv CertificateVerify
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-multi-chain-certificate-type-rsa" {
  rfc 5246 section 7.4.4
  chain: [default]
  client_chain: [ecdsa_p256, rsa_2048]
  xfail rustls "its client-certificate resolver cannot inspect TLS 1.2 certificate_types"
  uut client { versions: [tls12] }
  peer { request_client_cert: true }
  flow handshake {
    send CertificateRequest {
      certificate_types: [rsa_sign]
      signature_algorithms: [ecdsa_secp256r1_sha256, rsa_pkcs1_sha256]
    }
    recv Certificate { entries: 1, leaf_key: rsa_2048 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-multi-chain-certificate-type-ecdsa" {
  rfc 5246 section 7.4.4
  chain: [default]
  client_chain: [rsa_2048, ecdsa_p256]
  xfail rustls "its client-certificate resolver cannot inspect TLS 1.2 certificate_types"
  uut client { versions: [tls12] }
  peer { request_client_cert: true }
  flow handshake {
    send CertificateRequest {
      certificate_types: [ecdsa_sign]
      signature_algorithms: [rsa_pkcs1_sha256, ecdsa_secp256r1_sha256]
    }
    recv Certificate { entries: 1, leaf_key: ecdsa_p256 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-multi-chain-certificate-type-ecdsa-ed25519" {
  rfc 5246 section 7.4.4
  chain: [default]
  client_chain: [rsa_2048, ed25519]
  xfail botan "does not treat Ed25519 as an ecdsa_sign client-certificate type in TLS 1.2"
  xfail rustls "its client-certificate resolver cannot inspect TLS 1.2 certificate_types"
  uut client { versions: [tls12] }
  peer { request_client_cert: true }
  flow handshake {
    send CertificateRequest {
      certificate_types: [ecdsa_sign]
      signature_algorithms: [rsa_pkcs1_sha256, ed25519]
    }
    recv Certificate { entries: 1, leaf_key: ed25519 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-multi-chain-preserves-credential-preference" {
  rfc 5246 section 7.4.4
  chain: [default]
  client_chain: [ecdsa_p384, ecdsa_p256]
  uut client { versions: [tls12] }
  peer { request_client_cert: true }
  flow handshake {
    send CertificateRequest {
      certificate_types: [ecdsa_sign]
      signature_algorithms: [ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384]
    }
