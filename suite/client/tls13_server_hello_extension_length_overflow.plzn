plzn tls "client/tls13-server-hello-extension-length-overflow" {
  rfc 8446 section 4.1.3
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake after recv ClientHello {
    send raw "16030300460200004203039f9cafa88664d9095f85dd64a39e5dd5c09f5a4a5362938af3718ee4e818af6a00c03000001aff01000100000b00040300010200230100000f00010100170000"
    wait 300 ms
  }
  expect alert fatal/decode_error
  expect alert fatal/protocol_version if libressl
  # The 4.1 client offers neither ec_point_formats nor renegotiation_info in a
  # TLS 1.3-only ClientHello, so the ServerHello's ec_point_formats is an
  # unsolicited extension and is rejected before the overflowing one is read.
  expect alert fatal/unsupported_extension if openssl
}
