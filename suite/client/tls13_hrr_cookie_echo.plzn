plzn tls "client/tls13-hrr-cookie-echo" {
  rfc 8446 section 4.2.2
  chain: [default]
  uut client {
    versions: [tls13]
    curves: [x25519, secp384r1, secp256r1]
  }
  peer { capabilities: [secp256r1, hrr] }
  flow handshake {
    send HelloRetryRequest {
      +ext cookie = raw "0010000102030405060708090a0b0c0d0e0f"
    }
  }
  expect ok
}
