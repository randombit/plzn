plzn tls "client/tls13-client-keyupdate-crossing" {
  rfc 8446 section 4.6.3
  chain: [default]
  uut client {
    versions: [tls13]
    records_per_traffic_key: 3
  }
  flow handshake {
    send AppData
    recv AppData
    send AppData
    recv AppData
    send AppData
    recv AppData
    send AppData
    send KeyUpdate { request_update: update_requested }
    recv KeyUpdate { request_update: update_requested }
    recv AppData
    # Both peers' reciprocal KeyUpdates are emitted automatically before application data.
    send AppData
    recv KeyUpdate { request_update: update_not_requested }
    recv AppData
  }
  expect ok
}
