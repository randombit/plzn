plzn tls "client/tls12-resume-ticket" {
  rfc 5077 section 3.1
  chain: [default]
  uut client {
    versions: [tls12]
  }

  session initial {
    flow handshake {
      recv ClientHello { has_ext: session_ticket }
      send AppData
      recv AppData
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake after recv Finished {
      send AppData
      recv AppData
    }
    expect ok
  }
}
