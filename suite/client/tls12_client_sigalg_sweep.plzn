plzn tls "client/tls12-client-rsa-sigalg-sweep" {
  rfc 5246 section 7.4.1.4.1
  uut client {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_rsa] }
  chain: [rsa_2048]
  matrix {
    scheme in [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512, rsa_pkcs1_sha256, rsa_pkcs1_sha384, rsa_pkcs1_sha512]
  }
  flow handshake {
    recv ClientHello { signature_algorithms: [$scheme] }
    send ServerKeyExchange { signature_scheme: $scheme }
    send AppData
    recv AppData
  }
  expect ok
}
