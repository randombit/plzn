plzn tls "client/tls12-length/server-hello-message" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake until send ServerHello {
    send ServerHello @ sub[handshake.length] = 1
    wait 300 ms
  }
  expect alert fatal/{decode_error,unexpected_message}
  expect close if wolfssl
}

plzn tls "client/tls12-length/server-hello-session-id" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake until send ServerHello {
    send ServerHello @ add[handshake.session_id_length] = 1
    wait 300 ms
  }
  expect alert fatal/{decode_error,illegal_parameter}
  expect close if wolfssl
}

plzn tls "client/tls12-length/server-hello-extensions" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake until send ServerHello {
    send ServerHello { +ext extended_master_secret } @ sub[handshake.extensions_length] = 1
    wait 300 ms
  }
  expect alert fatal/decode_error
  expect close if wolfssl
}

plzn tls "client/tls12-length/server-certificate-message" {
  rfc 5246 section 7.4.2
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake until send Certificate {
    send Certificate @ sub[handshake.length] = 1
    wait 300 ms
  }
  expect alert fatal/{decode_error,unexpected_message,bad_certificate,certificate_unknown}
  expect close if wolfssl
}

plzn tls "client/tls12-length/server-certificate-list" {
