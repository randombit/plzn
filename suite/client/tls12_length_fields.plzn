plzn tls "client/tls12-length/server-certificate-entry" {
  rfc 5246 section 7.4.2
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake until send Certificate {
    send Certificate @ sub[handshake.first_certificate_length] = 1
    wait 300 ms
