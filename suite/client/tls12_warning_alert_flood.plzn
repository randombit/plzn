  expect close if wolfssl
  expect alert fatal/unexpected_message if go
  expect alert fatal/internal_error if gnutls
  expect alert fatal/unexpected_message if botan
}

plzn tls "client/tls12-warning-alert-flood/application-data-one-to-four" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut client { versions: [tls12] }
  matrix {
    count in [1, 4]
  }
  flow handshake {
    repeat $count { send alert warning/user_canceled }
    send AppData
    recv AppData
  }
  expect ok
}

