plzn tls "client/tls12-warning-alert-flood/interleaved-with-application-data-one-burst" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut client { versions: [tls12] }
  matrix {
    count in [1]
  }
  flow handshake {
    repeat $count {
      repeat 4 { send alert warning/user_canceled }
      send AppData
      recv AppData
    }
  }
  expect ok
}

plzn tls "client/tls12-warning-alert-flood/interleaved-with-application-data-two-or-more-bursts" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut client { versions: [tls12] }
  matrix {
    count in [2, 3, 5]
  }
  flow handshake {
    repeat $count {
      repeat 4 { send alert warning/user_canceled }
      send AppData
      recv AppData
    }
  }
  expect ok
  expect close if rustls
  expect close if wolfssl
}
