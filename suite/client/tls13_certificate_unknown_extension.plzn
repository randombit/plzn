plzn tls "client/tls13-rejects-grease-certificate-extension" {
  rfc 8446 section 4.4.2
  rfc 8701 section 3.1
  chain: [default]
  uut client { versions: [tls13] }
  # RFC 8446 4.4.2: server Certificate extensions MUST correspond to ones
  # from the ClientHello; 4.2: an unsolicited one MUST be answered with
  # unsupported_extension. RFC 8701 3.1: a GREASE value in any TLS 1.3
  # Certificate extension MUST fail the connection.
  xfail go "accepts an unsolicited GREASE Certificate extension"
  xfail openssl "accepts any unknown unsolicited Certificate extension, GREASE or not"
  matrix {
    grease in grease
  }
  flow handshake {
    send Certificate {
      +ext $grease = zeros 25
    }
  }
  expect alert fatal/{decode_error, illegal_parameter, unsupported_extension}
  xfail libressl "accepts an unsolicited GREASE Certificate extension"
}
