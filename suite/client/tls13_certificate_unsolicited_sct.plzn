plzn tls "client/tls13-certificate-unsolicited-sct" {
  rfc 8446 section 4.4.2
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake {
    send Certificate {
      +ext signed_certificate_timestamp = raw "0000"
    }
  }
  expect alert fatal/{decode_error, illegal_parameter, unsupported_extension}
  xfail libressl "accepts an unsolicited signed_certificate_timestamp Certificate extension"
}
