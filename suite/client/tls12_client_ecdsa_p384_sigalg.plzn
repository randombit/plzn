plzn tls "client/tls12-client-ecdsa-p384" {
  rfc 8422 section 5.4
  chain: [ecdsa_p384]
  uut client {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_ecdsa] }
  matrix {
    group in [x25519, secp256r1, secp384r1]
  }
  flow handshake {
    recv ClientHello { supported_groups: [$group], signature_algorithms: [ecdsa_secp384r1_sha384] }
    send ServerKeyExchange { signature_scheme: ecdsa_secp384r1_sha384 }
    send AppData
    recv AppData
  }
  expect ok
}
