plzn tls "client/tls13-all-zero-inner-plaintext" {
  rfc 8446 section 5.4
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake after recv Finished {
    send empty_record application_data @ set[record.inner_type] = 0
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decrypt_error if boringssl
  expect alert fatal/bad_record_mac if boringssl
  expect close if rustls
}
