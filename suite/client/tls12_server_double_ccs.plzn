plzn tls "client/tls12-server-double-ccs" {
  rfc 5246 section 7.1
  chain: [default]
  uut client {
    versions: [tls12]
  }
  flow {
    recv ClientHello
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send ChangeCipherSpec
    send Finished
    wait 300 ms
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decode_error if rustls
  expect close if wolfssl
}
