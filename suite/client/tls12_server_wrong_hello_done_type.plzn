plzn tls "client/tls12-server-wrong-hello-done-type" {
  rfc 5246 section 7.4.5
  chain: [default]
  uut client {
    versions: [tls12]
  }
  matrix {
    mtype in [0x01, 0x02, 0x14, 0xff]
  }
  flow handshake {
    send ServerHelloDone @ set[handshake.msg_type, 0] = $mtype
  }
  expect alert fatal/{decode_error, unexpected_message}
}
