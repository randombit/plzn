plzn tls "client/tls13-session-id-mismatch" {
  rfc 8446 section 4.1.3
  chain: [default]
  xfail rustls "does not check legacy_session_id_echo and completes the handshake"
  uut client { versions: [tls13] }
  flow handshake {
    send ServerHello {
      legacy_session_id_echo: [
        0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
        0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
        0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa,
        0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa, 0xaa
      ]
    }
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if boringssl
}
