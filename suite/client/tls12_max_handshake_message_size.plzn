  rfc 5246 section 7.4
  chain: [ecdsa_p256]
  uut client {
    versions: [tls12]
    max_handshake_message_size: 4096
  }
  flow handshake {
    send AppData
    recv AppData
    send HelloRequest @ pad to 4097, @ fragment 4 hold_all
  }
  expect alert fatal/handshake_failure
}

