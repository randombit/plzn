# Floods of consecutive zero-length records at a TLS 1.2 client: the mirror of
# suite/server/tls12_empty_record_flood.plzn, whose header lists what each
# library does with a zero-length record and why. Every library reacts the
# same way in this role at the matching position.
#
# Positions: unprotected empty handshake records before the ServerHello and
# after the ServerKeyExchange; protected empty handshake records after the
# server's ChangeCipherSpec; and empty application data after the handshake,
# under an AEAD and a CBC suite (a single one is
# tls12_server_empty_app_data_record).

plzn tls "client/tls12-empty-record-flood/plaintext-handshake-before-server-hello-one-to-thirty-two" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut client {
    versions: [tls12]
  }
  matrix {
    count in [1, 2, 32]
  }
  flow handshake until send ServerHello {
    repeat $count { send empty_record handshake }
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect ok if openssl
  expect ok if boringssl
  expect alert fatal/decode_error if botan
  expect alert fatal/decode_error if rustls
  expect alert fatal/record_overflow if wolfssl
}

plzn tls "client/tls12-empty-record-flood/plaintext-handshake-before-server-hello-over-thirty-two" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut client {
    versions: [tls12]
  }
  matrix {
    count in [33, 100, 1000]
  }
  flow handshake until send ServerHello {
    repeat $count { send empty_record handshake }
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decode_error if botan
  expect alert fatal/decode_error if rustls
  expect alert fatal/record_overflow if wolfssl
}

