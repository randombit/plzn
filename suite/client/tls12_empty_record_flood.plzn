plzn tls "client/tls12-empty-record-flood/application-data-two-to-sixteen" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut client {
    versions: [tls12]
    cipher_suites: [$suite]
  }
  matrix {
    count in [2, 16]
    suite in [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, ECDHE_ECDSA_WITH_AES_128_CBC_SHA256]
  }
  flow handshake {
    repeat $count { send empty_record application_data }
    send AppData
    recv AppData
  }
  expect ok
}

