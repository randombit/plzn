plzn tls "client/tls12-psk-rejects-certificate-request" {
  rfc 4279 section 2
  chain: []
  psk {
    identity: "plzn-psk-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  uut client {
    versions: [tls12]
    cipher_suites: [PSK_WITH_AES_128_GCM_SHA256]
  }
  flow {
    recv ClientHello { cipher_suites: [PSK_WITH_AES_128_GCM_SHA256] }
    send ServerHello { cipher_suite: PSK_WITH_AES_128_GCM_SHA256 }
    send CertificateRequest {
      certificate_types: [rsa_sign]
      signature_algorithms: [rsa_pkcs1_sha256]
    }
    wait 300 ms
  }
  expect alert fatal/unexpected_message
}
