plzn tls "client/tls13-ee-fragment-interleaved-empty-app-data" {
  rfc 8446 section 5.1
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake until send EncryptedExtensions {
    send EncryptedExtensions @ fragment 4 hold
    send empty_record application_data
    flush_fragment
    send Certificate
    send CertificateVerify
    send Finished
    wait 300 ms
  }
  expect alert fatal/unexpected_message
  expect close if rustls
}
