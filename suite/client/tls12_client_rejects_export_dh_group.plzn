plzn tls "client/tls12-client-rejects-export-size-dh-group" {
  rfc 7919 section 4
  chain: [rsa_2048]
  uut client { versions: [tls12] }
  peer { capabilities: [dhe_rsa] }
  flow handshake {
    send ServerKeyExchange {
      dh_p: [0xd4, 0xdb, 0x00, 0xd1, 0x82, 0x45, 0xe6, 0x6a,
             0x3b, 0xca, 0x0c, 0x84, 0x53, 0x63, 0x9f, 0x35,
             0x88, 0xff, 0xaf, 0x9b, 0xaa, 0xd0, 0xaf, 0x35,
             0x72, 0x82, 0x4e, 0x66, 0xbe, 0xc3, 0x8d, 0x66,
             0x36, 0x52, 0x5d, 0xc0, 0x43, 0xbb, 0xc5, 0x12,
             0x7d, 0xd5, 0xfb, 0xd0, 0x25, 0xde, 0xc7, 0x19,
             0x55, 0x55, 0x1a, 0xaa, 0x6b, 0x34, 0xba, 0xcf,
             0x80, 0xd6, 0x85, 0x85, 0x35, 0xb1, 0x3a, 0xbf]
      dh_g: two
    }
  }
  expect alert fatal/{insufficient_security, handshake_failure}
  expect alert fatal/illegal_parameter if libressl
}
