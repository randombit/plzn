plzn tls "client/tls12-shd-nonempty"  {
  rfc 5246 section 7.4.5
  chain: [default]
  uut client {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake {
    send ServerHelloDone @ pad +1
  }
  expect alert fatal/decode_error
  expect alert fatal/illegal_parameter if openssl
}
