plzn tls "client/tls12-ignores-data-after-close-notify" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake {
    atomic {
      send alert warning/close_notify
      send AppData { reply: 64 }
    }
    recv alert warning/close_notify
  }
  expect ok
}

plzn tls "client/tls13-ignores-data-after-close-notify" {
  rfc 9846 section 6.1
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake {
    atomic {
      send alert warning/close_notify
      send AppData { reply: 64 }
    }
    recv alert warning/close_notify
  }
  expect ok
}
