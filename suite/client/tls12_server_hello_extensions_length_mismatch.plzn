plzn tls "client/tls12-server-hello-extensions-length-mismatch" {
  rfc 5246 section 7.4.1.3
  chain: [default]
  uut client {
    versions: [tls12]
  }
  flow handshake after recv ClientHello {
    send raw "16030300460200004203039f9cafa88664d9095f85dd64a39e5dd5c09f5a4a5362938af3718ee4e818af6a00c03000001cff01000100000b00040300010200230000000f00010100170000"
    wait 300 ms
  }
  expect alert fatal/decode_error
}
