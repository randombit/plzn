plzn tls "client/tls12-client-initiated-renegotiation" {
  rfc 5746 section 3.7
  chain: [default]
  uut client {
    versions: [tls12]
    renegotiate_after_handshake: true
  }
  flow handshake after send Finished {
    send AppData
    recv AppData
    recv ClientHello { has_ext: renegotiation_info }
    send ServerHello
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}
