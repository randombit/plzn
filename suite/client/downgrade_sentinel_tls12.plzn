plzn tls "client/downgrade-sentinel-tls12" {
  rfc 8446 section 4.1.3
  chain: [default]
  uut client {
    versions: [tls12, tls13]
  }
  flow handshake {
    send ServerHello {
      random: [
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x44, 0x4f, 0x57, 0x4e, 0x47, 0x52, 0x44, 0x01
      ]
    }
  }
  expect alert fatal/illegal_parameter
}
