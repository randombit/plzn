plzn tls "client/tls12-raw-public-key-only-rejects-x509-selection" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  flow handshake {
    send ServerHello { +ext server_certificate_type = x509 }
  }
  expect alert fatal/unsupported_certificate
  expect alert fatal/decode_error if openssl
  expect alert fatal/illegal_parameter if botan
}

plzn tls "client/tls13-raw-public-key-only-rejects-x509-selection" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  flow handshake {
    send EncryptedExtensions { +ext server_certificate_type = x509 }
  }
  expect alert fatal/unsupported_certificate
  expect alert fatal/decode_error if openssl
  expect alert fatal/illegal_parameter if botan
  expect alert fatal/handshake_failure if rustls
}

plzn tls "client/tls12-x509-only-rejects-unsolicited-raw-public-key" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls12]
    server_certificate_types: [x509]
  }
  flow handshake {
    send ServerHello { +ext server_certificate_type = raw_public_key }
  }
  expect alert fatal/unsupported_extension
  expect alert fatal/decode_error if libressl
}

plzn tls "client/tls13-x509-only-rejects-unsolicited-raw-public-key" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls13]
    server_certificate_types: [x509]
  }
  flow handshake {
    send EncryptedExtensions { +ext server_certificate_type = raw_public_key }
  }
  expect alert fatal/unsupported_extension
  expect close if libressl
}

plzn tls "client/tls12-raw-public-key-only-rejects-default-x509-selection" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  xfail openssl "accepts default X.509 despite its raw-public-key-only policy"
  xfail gnutls "accepts default X.509 despite its raw-public-key-only policy"
  flow handshake {
    send ServerHello { -ext server_certificate_type }
  }
  expect alert fatal/{unsupported_certificate,decode_error,illegal_parameter}
}

plzn tls "client/tls13-raw-public-key-only-rejects-default-x509-selection" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  xfail openssl "accepts default X.509 despite its raw-public-key-only policy"
  xfail gnutls "accepts default X.509 despite its raw-public-key-only policy"
  flow handshake {
    send EncryptedExtensions { -ext server_certificate_type }
  }
  expect alert fatal/{unsupported_certificate,decode_error,illegal_parameter,handshake_failure}
}

plzn tls "client/tls12-rejects-x509-certificate-encoded-as-raw-public-key" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send Certificate { certificate_type: x509 }
  }
  expect alert fatal/{decode_error,bad_certificate,certificate_unknown}
}

