plzn tls "client/tls12-rejects-empty-server-raw-public-key" {
  rfc 7250 section 3
  chain: [default]
  uut client {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send Certificate { certificate_list: [] }
  }
  expect alert fatal/{decode_error,bad_certificate,certificate_unknown}
}

plzn tls "client/tls13-rejects-empty-server-raw-public-key" {
  rfc 7250 section 3
  chain: [default]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send Certificate { certificate_list: [0, 0, 0, 0, 0] }
  }
  expect alert fatal/{decode_error,bad_certificate,certificate_unknown}
}

plzn tls "client/tls13-rejects-empty-server-certificate-list-with-raw-public-key" {
  rfc 8446 section 4.4.2
  chain: [default]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send Certificate { entries: 0 }
  }
  expect alert fatal/{certificate_required,decode_error,bad_certificate,certificate_unknown}
  expect close if rustls
}

plzn tls "client/tls13-rejects-raw-public-key-without-certificate-verify" {
  rfc 8446 section 4.4.3
  chain: [default]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake until send CertificateVerify {
    send Finished
  }
  expect alert fatal/unexpected_message
}

plzn tls "client/tls12-raw-public-key-server-authentication-resumption" {
  rfc 7250 section 4.2
  rfc 5077 section 3.1
  chain: [ecdsa_p256]
  uut client {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }

  session initial {
    flow handshake {
      send AppData
      recv AppData
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake after recv Finished {
      send AppData
      recv AppData
    }
    expect ok
  }
}

plzn tls "client/tls13-raw-public-key-server-authentication-resumption" {
  rfc 7250 section 4.2
  rfc 8446 section 4.6.1
  chain: [ecdsa_p256]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }

  session initial {
    flow handshake after recv Finished {
      send NewSessionTicket
      send AppData
      recv AppData
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      recv ClientHello { has_ext: pre_shared_key }
      send AppData
      recv AppData
    }
    expect ok
  }
}

# RFC 7250 3: "The SubjectPublicKeyInfo value in the Certificate payload MUST
# contain the DER encoding [X.690] of the SubjectPublicKeyInfo." The entry
# below holds a PEM framed P-256 SubjectPublicKeyInfo instead.
plzn tls "client/tls13-rejects-pem-encoded-server-raw-public-key" {
  rfc 7250 section 3
  chain: [default]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send Certificate {
      certificate_list: [
        0x00, 0x00, 0xb2, 0x2d, 0x2d, 0x2d, 0x2d, 0x2d, 0x42, 0x45, 0x47, 0x49,
        0x4e, 0x20, 0x50, 0x55, 0x42, 0x4c, 0x49, 0x43, 0x20, 0x4b, 0x45, 0x59,
