plzn tls "client/tls12-raw-public-key-server-authentication" {
  rfc 7250 section 4.2
  chain: [ecdsa_p256]
  uut client {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    recv ClientHello { ext server_certificate_type == [raw_public_key] }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls13-raw-public-key-server-authentication" {
  rfc 7250 section 4.2
  chain: [ecdsa_p256]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    recv ClientHello { ext server_certificate_type == [raw_public_key] }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-raw-public-key-offer-selects-x509" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls12]
    server_certificate_types: [raw_public_key, x509]
  }
  flow handshake {
    send ServerHello { +ext server_certificate_type = x509 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls13-raw-public-key-offer-selects-x509" {
  rfc 7250 section 4.2
  chain: [default]
  uut client {
    versions: [tls13]
    server_certificate_types: [raw_public_key, x509]
  }
  flow handshake {
    send EncryptedExtensions { +ext server_certificate_type = x509 }
    send AppData
    recv AppData
  }
  expect ok
}

