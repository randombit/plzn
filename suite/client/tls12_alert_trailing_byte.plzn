plzn tls "client/tls12-alert-trailing-byte" {
  rfc 5246 section 7.2
  chain: [default]
  uut client {
    versions: [tls12]
  }
  flow handshake after recv ClientHello {
    send raw "1503030003020101"
    wait 300 ms
  }
  expect alert fatal/decode_error
  expect alert fatal/unexpected_message if openssl
}
