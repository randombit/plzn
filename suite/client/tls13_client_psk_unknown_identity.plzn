plzn tls "client/tls13-client-psk-unknown-identity" {
  rfc 8446 section 4.2.11
  chain: []
  psk {
    identity: "plzn-psk-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  uut client {
    versions: [tls13]
    psk_identity: "someone-else"
  }
  flow handshake {
    recv ClientHello { has_ext: pre_shared_key }
    send AppData
    recv AppData
  }
  expect ok
}
