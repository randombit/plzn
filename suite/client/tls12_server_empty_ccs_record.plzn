plzn tls "client/tls12-server-empty-ccs-record" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut client {
    versions: [tls12]
  }
  flow handshake until send ChangeCipherSpec {
    send empty_record change_cipher_spec
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect alert fatal/decode_error
  expect alert fatal/illegal_parameter if boringssl
  expect ok if openssl
  expect alert fatal/unexpected_message if libressl
}
