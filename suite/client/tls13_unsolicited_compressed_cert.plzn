plzn tls "client/tls13-unsolicited-compressed-cert" {
  rfc 8879 section 4
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake {
    send Certificate @ set[handshake.msg_type, 0] = 25
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decode_error if boringssl
  expect alert fatal/illegal_parameter if openssl
  expect alert fatal/decode_error if rustls
}
