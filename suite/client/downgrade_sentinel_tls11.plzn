plzn tls "client/downgrade-sentinel-tls11" {
  rfc 8446 section 4.1.3
  chain: [default]
  xfail rustls "checks only the DOWNGRD 01 sentinel when negotiating TLS 1.2; the DOWNGRD 00 one is ignored (RFC 8446 4.1.3: MUST check either)"
  uut client {
    versions: [tls12, tls13]
  }
  flow handshake {
    send ServerHello {
      random: [
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x44, 0x4f, 0x57, 0x4e, 0x47, 0x52, 0x44, 0x00
      ]
    }
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decrypt_error if gnutls
}

plzn tls "client/downgrade-sentinel-negotiated-tls11" {
  rfc 8446 section 4.1.3
  chain: [rsa_2048]
  uut client { versions: [tls11, tls12, tls13] }
  peer { capabilities: [rsa, aes128_cbc_sha] }
  flow handshake {
    send ServerHello {
      random: [
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x44, 0x4f, 0x57, 0x4e, 0x47, 0x52, 0x44, 0x00
      ]
    }
  }
  expect alert fatal/illegal_parameter
}
