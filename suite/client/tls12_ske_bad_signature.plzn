plzn tls "client/tls12-ske-bad-signature" {
  syntax 1.0
  rfc 5246 section 7.4.3
  chain: [default]
  uut client {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake {
    send ServerKeyExchange @ xor[handshake.signature, -1] = 0x01
  }
  expect alert fatal/decrypt_error
}
