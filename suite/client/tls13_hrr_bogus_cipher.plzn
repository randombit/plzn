plzn tls "client/tls13-hrr-bogus-cipher" {
  rfc 8446 section 4.1.3
  chain: [default]
  uut client {
    versions: [tls13]
  }
  peer { capabilities: [hrr] }
  flow handshake {
    send HelloRetryRequest @ set[handshake.cipher_suite, 0] = 0xfe, @ set[handshake.cipher_suite, 1] = 0x00
  }
  expect alert fatal/illegal_parameter
  expect close if wolfssl
  expect alert fatal/handshake_failure if gnutls
}

plzn tls "client/tls13-hrr-tls12-cipher" {
  rfc 8446 section 4.1.3
  chain: [default]
  uut client { versions: [tls13] }
  peer { capabilities: [hrr] }
  flow handshake {
    send HelloRetryRequest @ set[handshake.cipher_suite, 0] = 0x00, @ set[handshake.cipher_suite, 1] = 0x9c
  }
  expect alert fatal/illegal_parameter
  expect close if wolfssl
}
