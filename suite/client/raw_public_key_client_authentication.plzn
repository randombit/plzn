plzn tls "client/tls12-raw-public-key-client-authentication" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut client {
    versions: [tls12]
    client_certificate_types: [raw_public_key]
  }
  peer {
    capabilities: [offer_rpk]
    request_client_cert: true
  }
  flow handshake {
    recv ClientHello { ext client_certificate_type == [raw_public_key] }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls13-raw-public-key-client-authentication" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut client {
    versions: [tls13]
    client_certificate_types: [raw_public_key]
  }
  peer {
    capabilities: [offer_rpk]
    request_client_cert: true
  }
  flow handshake {
    recv ClientHello { ext client_certificate_type == [raw_public_key] }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls13-raw-public-key-client-authentication-ignores-signature-algorithms-cert" {
  rfc 8446 section 4.2.3
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut client {
    versions: [tls13]
    client_certificate_types: [raw_public_key]
  }
  peer {
    capabilities: [offer_rpk]
    request_client_cert: true
  }
  flow handshake {
    send CertificateRequest {
      +ext signature_algorithms_cert = [rsa_pss_rsae_sha256]
    }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-client-certificate-types-selects-raw-public-key" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut client {
    versions: [tls12]
    client_certificate_types: [raw_public_key, x509]
  }
  peer {
    capabilities: [offer_rpk]
    request_client_cert: true
  }
  flow handshake {
    recv Certificate { certificate_type: raw_public_key }
    send AppData
    recv AppData
  }
  expect ok
}

