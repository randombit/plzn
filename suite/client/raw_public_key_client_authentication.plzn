    client_certificate_types: [raw_public_key, x509]
  }
  peer {
    capabilities: [offer_rpk]
    request_client_cert: true
  }
  flow handshake {
    send ServerHello { +ext client_certificate_type = x509 }
    recv Certificate { certificate_type: x509 }
    send AppData
    recv AppData
  }
  expect ok
}

