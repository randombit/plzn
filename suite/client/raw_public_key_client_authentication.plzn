plzn tls "client/tls12-raw-public-key-only-rejects-x509-client-certificate-selection" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut client {
    versions: [tls12]
    client_certificate_types: [raw_public_key]
  }
  peer {
    capabilities: [offer_rpk]
    request_client_cert: true
  }
  flow handshake {
    send ServerHello { +ext client_certificate_type = x509 }
  }
  expect alert fatal/{unsupported_certificate,decode_error,illegal_parameter,unsupported_extension}
}

plzn tls "client/tls13-raw-public-key-only-rejects-x509-client-certificate-selection" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut client {
    versions: [tls13]
    client_certificate_types: [raw_public_key]
  }
  peer {
    capabilities: [offer_rpk]
    request_client_cert: true
  }
  flow handshake {
    send EncryptedExtensions { +ext client_certificate_type = x509 }
  }
  expect alert fatal/{unsupported_certificate,decode_error,illegal_parameter,handshake_failure}
}

plzn tls "client/tls13-raw-public-key-only-allows-omitted-selection-without-certificate-request" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut client {
    versions: [tls13]
    client_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send EncryptedExtensions { -ext client_certificate_type }
    send AppData
    recv AppData
  }
  expect ok
}
