plzn tls "client/tls12-server-empty-app-data-record" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut client {
    versions: [tls12]
  }
  flow handshake after recv Finished {
    send ChangeCipherSpec
    send Finished
    send empty_record application_data
    send AppData
    recv AppData
  }
  expect ok
}
