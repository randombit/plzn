plzn tls "client/tls13-client-keyupdate-read-side-request" {
  rfc 8446 section 4.6.3
  chain: [default]
  uut client {
    versions: [tls13]
    records_per_traffic_key: 4
  }
  flow handshake {
    send alert warning/user_canceled
    send alert warning/user_canceled
    send alert warning/user_canceled
    send alert warning/user_canceled
    send alert warning/user_canceled
    send AppData
    recv KeyUpdate { request_update: update_requested }
    recv AppData
    send AppData
    recv AppData
  }
  expect ok
}
