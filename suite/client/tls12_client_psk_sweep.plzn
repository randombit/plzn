plzn tls "client/tls12-client-psk-sweep" {
  rfc 4279 section 2
  chain: []
  uut client { versions: [tls12] }
  psk {
    identity: "plzn-psk-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  matrix {
    suite in [PSK_WITH_AES_128_GCM_SHA256, PSK_WITH_AES_256_GCM_SHA384, PSK_WITH_CHACHA20_POLY1305_SHA256, PSK_WITH_ARIA_128_GCM_SHA256, PSK_WITH_ARIA_256_GCM_SHA384, PSK_WITH_CAMELLIA_128_GCM_SHA256, PSK_WITH_CAMELLIA_256_GCM_SHA384, PSK_WITH_AES_128_CCM, PSK_WITH_AES_256_CCM, PSK_WITH_AES_128_CCM_8, PSK_WITH_AES_256_CCM_8, PSK_WITH_AES_128_CBC_SHA, PSK_WITH_AES_256_CBC_SHA, PSK_WITH_AES_128_CBC_SHA256, PSK_WITH_AES_256_CBC_SHA384, PSK_WITH_3DES_EDE_CBC_SHA, PSK_WITH_NULL_SHA, PSK_WITH_NULL_SHA256, PSK_WITH_NULL_SHA384, ECDHE_PSK_WITH_AES_128_GCM_SHA256, ECDHE_PSK_WITH_AES_256_GCM_SHA384, ECDHE_PSK_WITH_CHACHA20_POLY1305_SHA256, ECDHE_PSK_WITH_AES_128_CCM_SHA256, ECDHE_PSK_WITH_AES_128_CCM_8_SHA256, ECDHE_PSK_WITH_AES_128_CBC_SHA, ECDHE_PSK_WITH_AES_256_CBC_SHA, ECDHE_PSK_WITH_AES_128_CBC_SHA256, ECDHE_PSK_WITH_AES_256_CBC_SHA384, ECDHE_PSK_WITH_3DES_EDE_CBC_SHA, ECDHE_PSK_WITH_NULL_SHA, ECDHE_PSK_WITH_NULL_SHA256, ECDHE_PSK_WITH_NULL_SHA384]
  }
  flow handshake {
    recv ClientHello { cipher_suites: [$suite] }
    send AppData
    recv AppData
  }
  expect ok
}
