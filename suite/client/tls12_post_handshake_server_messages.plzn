plzn tls "client/tls12-post-handshake-server-hello" {
  rfc 5246 section 7.4
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake after recv Finished {
    send ServerHello
    wait 300 ms
  }
  expect alert fatal/unexpected_message
  expect close if wolfssl
}

plzn tls "client/tls12-post-handshake-certificate" {
  rfc 5246 section 7.4
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake after recv Finished {
    send Certificate
    wait 300 ms
  }
  expect alert fatal/unexpected_message
  expect close if wolfssl
}

plzn tls "client/tls12-post-handshake-finished" {
  rfc 5246 section 7.4
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake after recv Finished {
    send Finished
  }
  expect alert fatal/unexpected_message
}
