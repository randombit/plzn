plzn tls "client/tls13-ticket-after-resumption" {
  rfc 8446 section 4.6.1
  chain: [default]
  uut client { versions: [tls13] }
  skip wolfssl "built without HAVE_SESSION_TICKET: its TLS 1.3 client cannot resume"
  skip libressl "its client does not resume TLS 1.3 sessions"

  session initial {
    flow handshake after recv Finished {
      send NewSessionTicket
      close alert warning/close_notify
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake after recv Finished {
      send NewSessionTicket
      close alert warning/close_notify
    }
    expect ok
  }

  session renewed [resumes: resumed] {
    flow handshake {
      recv ClientHello { has_ext: pre_shared_key }
      send AppData
      recv AppData
    }
    expect ok
  }
}
