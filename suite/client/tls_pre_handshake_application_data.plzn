plzn tls "client/tls12-application-data-before-server-hello" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut client { versions: [tls12] }
  flow {
    recv ClientHello
    send AppData
    wait 300 ms
  }
  expect alert fatal/unexpected_message
  expect close if go
}

plzn tls "client/tls13-application-data-before-server-hello" {
  rfc 8446 section 5.1
  chain: [default]
  uut client { versions: [tls13] }
  flow {
    recv ClientHello
    send AppData
    wait 300 ms
  }
  expect alert fatal/unexpected_message
  expect close if go
}
