plzn tls "client/tls13-ffdhe-shared-secret-leading-zero-preserved" {
  rfc 8446 section 7.4.1
  chain: [default]
  uut client {
    versions: [tls13]
    curves: [$group]
  }
  peer { capabilities: [ffdhe2048, ffdhe3072, ffdhe4096, ffdhe6144, ffdhe8192] }
  matrix {
    group in [ffdhe2048, ffdhe3072, ffdhe4096, ffdhe6144, ffdhe8192]
  }
  flow handshake {
    send ServerHello { shared_secret_leading_zeros: 1 }
    send AppData
    recv AppData
  }
  expect ok
}
