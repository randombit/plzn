plzn tls "client/tls12-implausible-handshake-length/new-session-ticket" {
  syntax 1.0
  rfc 5246 section 7.4
  chain: [ecdsa_p256]
  uut client { versions: [tls12] }
  peer { capabilities: [session_ticket] }
  xfail gnutls "parses any handshake length and checks its size limit only once the whole message has arrived (CHECK_SIZE in lib/handshake.c), so it waits for the announced 16 MiB"
  flow handshake until send ChangeCipherSpec {
    send NewSessionTicket @ set[handshake.length, 0..2] = 0xff, @ fragment 4 hold_all
    wait 300 ms
