plzn tls "client/tls12-implausible-handshake-length/hello-request" {
  syntax 1.0
  rfc 5246 section 7.4
  chain: [ecdsa_p256]
  uut client { versions: [tls12] }
  xfail gnutls "never checks the HelloRequest length and starts a renegotiation"
  flow handshake {
    send AppData
    recv AppData
    send HelloRequest @ set[handshake.length, 0..2] = 0xff, @ fragment 4 hold_all
    wait 300 ms
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/handshake_failure if botan
  expect alert fatal/internal_error if go
  expect close if rustls
  expect close if wolfssl
  expect alert fatal/decode_error if libressl
}
