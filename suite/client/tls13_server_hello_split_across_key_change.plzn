plzn tls "client/tls13-server-hello-split-across-key-change" {
  rfc 8446 section 5.1
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake until send ServerHello {
    send ServerHello @ fragment 40 hold
    flush_fragment
    wait 300 ms
  }
  expect alert fatal/unexpected_message
  expect close if go
  expect close if rustls
}
