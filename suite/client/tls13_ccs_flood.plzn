plzn tls "client/tls13-ccs-flood/after-hello-retry-request-two" {
  rfc 8446 section 5
  chain: [default]
  uut client {
    versions: [tls13]
    curves: [x25519, secp384r1, secp256r1]
  }
  peer { capabilities: [secp256r1, hrr] }
  flow {
    recv ClientHello
    send HelloRetryRequest { key_share_group: secp256r1 }
    repeat 2 {
      send ChangeCipherSpec
    }
    recv ClientHello
    send ServerHello
    send EncryptedExtensions
    send Certificate
    send CertificateVerify
    send Finished
    recv Finished
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/illegal_parameter if wolfssl
}

