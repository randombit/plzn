plzn tls "client/tls12-serverhello-bogus-cipher" {
  rfc 5246 section 7.4.1.3
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake {
    send ServerHello {
      cipher_suite: 0xfe00
    }
  }
  expect alert fatal/handshake_failure
  expect alert fatal/illegal_parameter if boringssl
  expect alert fatal/illegal_parameter if openssl
  expect alert fatal/illegal_parameter if libressl
}
