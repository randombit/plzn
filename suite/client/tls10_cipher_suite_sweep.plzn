plzn tls "client/tls10-cipher-suite-sweep" {
  rfc 2246 section 7.4.1.2
  chain: [rsa_2048, ecdsa_p256]
  matrix { suite in cipher_suites(tls10) }
  uut client {
    versions: [tls10]
    cipher_suites: [$suite]
  }
  psk {
    identity: "plzn-psk-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  flow handshake {
    send AppData
    recv AppData
    send AppData { size: 16384 }
    recv AppData { size: 16384 }
  }
  expect ok
}
