# RFC 7027 Brainpool group code points are only defined for TLS 1.2 and the
# RFC 8734 ones only for TLS 1.3, so a client offering a single version
# advertises only the matching ones.
plzn tls "client/tls13-only-client-omits-tls12-brainpool-groups" {
  rfc 8734 section 1
  chain: [default]
  uut client {
    versions: [tls13]
    curves: [x25519, brainpoolP256r1, brainpoolP256r1tls13]
  }
  flow handshake {
    recv ClientHello {
      supported_groups: [x25519, brainpoolP256r1tls13]
      lacks_supported_group: brainpoolP256r1
    }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "client/tls12-only-client-omits-tls13-brainpool-groups" {
  rfc 8734 section 1
  chain: [default]
  uut client {
    versions: [tls12]
    curves: [secp256r1, brainpoolP256r1, brainpoolP256r1tls13]
  }
  flow handshake {
    recv ClientHello {
      supported_groups: [secp256r1, brainpoolP256r1]
      lacks_supported_group: brainpoolP256r1tls13
    }
    send AppData
    recv AppData
  }
  expect ok
}

# The same holds for the RFC 8734 Brainpool signature schemes.
plzn tls "client/tls12-only-client-omits-tls13-brainpool-signature-schemes" {
  rfc 8734 section 3
  chain: [default]
  uut client { versions: [tls12] }
  matrix {
    scheme in [ecdsa_brainpoolP256r1tls13_sha256, ecdsa_brainpoolP384r1tls13_sha384, ecdsa_brainpoolP512r1tls13_sha512]
  }
  flow handshake {
    recv ClientHello { lacks_signature_algorithm: $scheme }
    send AppData
    recv AppData
  }
  expect ok
}
