plzn tls "client/tls13-serverhello-key-share-not-on-curve" {
  rfc 8446 section 4.2.8.2
  chain: [default]
  uut client {
    versions: [tls13]
  }
  peer { capabilities: [secp256r1] }
  flow handshake {
    send ServerHello @ xor[handshake.key_share, -1] = 0x01
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/internal_error if boringssl
  expect alert fatal/decode_error if libressl
}
