plzn tls "client/tls12-new-session-ticket-truncated-ticket" {
  rfc 5077 section 3.3
  chain: [default]
  uut client {
    versions: [tls12]
  }
  flow {
    recv ClientHello { has_ext: session_ticket }
    send ServerHello { +ext session_ticket }
    send Certificate
    send ServerKeyExchange
    send ServerHelloDone
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send raw "160303000b0400000700010203000500"
    wait 300 ms
  }
  expect alert fatal/decode_error
}
