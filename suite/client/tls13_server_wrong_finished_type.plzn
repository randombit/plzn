plzn tls "client/tls13-server-wrong-finished-type" {
  rfc 8446 section 4.4.4
  chain: [default]
  uut client { versions: [tls13] }
  matrix {
    mtype in [0x01, 0x02, 0x0b, 0xff]
  }
  flow handshake {
    send Finished @ set[handshake.msg_type, 0] = $mtype
  }
  expect alert fatal/{decode_error, unexpected_message, illegal_parameter}
}
