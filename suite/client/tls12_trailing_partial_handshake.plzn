plzn tls "client/tls12-rejects-new-session-ticket-prefix-after-server-hello-done" {
  rfc 5246 section 6.2.1
  rfc 5077 section 3.3
  chain: [default]
  uut client { versions: [tls12] }
  peer { capabilities: [session_ticket] }
  flow handshake until send ServerHelloDone {
    send ServerHelloDone @ trailing "04"
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send NewSessionTicket @ omit_prefix 1
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect ok if openssl
  expect ok if gnutls
  expect close if wolfssl
  expect ok if libressl
}

plzn tls "client/tls12-rejects-finished-prefix-after-server-hello-done" {
  rfc 5246 section 6.2.1
  rfc 5246 section 7.4.9
  chain: [default]
  xfail libressl "carries a partial Finished across the ChangeCipherSpec"
  uut client {
    versions: [tls12]
    session_tickets: 0
  }
  flow handshake until send ServerHelloDone {
    send ServerHelloDone @ trailing "14"
    recv ClientKeyExchange
    recv ChangeCipherSpec
    recv Finished
    send ChangeCipherSpec
    send Finished @ omit_prefix 1
  }
  expect alert fatal/unexpected_message
}

plzn tls "client/tls12-rejects-trailing-partial-message-after-finished" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut client { versions: [tls12] }
  flow handshake until send Finished {
    send Finished @ trailing "00"
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect close if wolfssl
  expect close if go
  # RFC 5246 6.2.1 lets TLS 1.2 interleave record types with a fragmented
  # handshake message (RFC 9846 5.1 notes the TLS 1.3 rules are stricter), so
  # buffering the partial header and carrying on with application data is permitted.
  expect ok if openssl
  # LibreSSL cannot complete a handshake header split across records here and
  # fails the read without an alert.
  expect close if libressl
}

plzn tls "client/tls12-rejects-trailing-partial-message-body-after-finished" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut client { versions: [tls12] }
  xfail wolfssl "buffers the start of a ClientHello, a message a client never receives, and keeps accepting application data"
  flow handshake until send Finished {
    send Finished @ trailing "01000020"
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect close if go
}

plzn tls "client/tls12-rejects-trailing-partial-message-after-resumed-finished" {
  rfc 5246 section 6.2.1
  rfc 5077
  chain: [default]
  uut client { versions: [tls12] }

  session initial {
    flow handshake { close alert warning/close_notify }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake until send Finished {
      send Finished @ trailing "00"
      recv ChangeCipherSpec
      recv Finished
      send AppData
      recv AppData
    }
    expect alert fatal/unexpected_message
    expect close if wolfssl
    expect close if go
    expect close if libressl
    # RFC 5246 6.2.1 lets TLS 1.2 interleave record types with a fragmented
    # handshake message (RFC 9846 5.1 notes the TLS 1.3 rules are stricter), so
    # buffering the partial header and carrying on with application data is permitted.
    expect ok if openssl
  }
}
