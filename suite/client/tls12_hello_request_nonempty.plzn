plzn tls "client/tls12-hello-request-nonempty" {
  rfc 5246 section 7.4.1.1
  chain: [default]
  uut client { versions: [tls12] }
  # OpenSSL caps HelloRequest at zero bytes in its message-size table
  # (ossl_statem_client_max_message_size), so the excess-length check fires
  # illegal_parameter before tls_process_hello_req would say decode_error.
  # GnuTLS's record layer dispatches a post-handshake handshake record on its
  # type byte alone (lib/record.c) and never looks at the HelloRequest length.
  xfail gnutls "never checks the HelloRequest length; starts renegotiation"
  flow handshake {
    send HelloRequest @ pad +1 0x01
  }
  expect alert fatal/{decode_error, illegal_parameter}
}
