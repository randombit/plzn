# Floods of warning alerts at a TLS 1.3 client: the mirror of
# suite/server/tls13_warning_alert_flood.plzn, whose header lists each
# library's cap. user_canceled sent as encrypted records after the
# handshake, and interleaved with application data.

plzn tls "client/tls13-warning-alert-flood/application-data-one-to-four" {
  rfc 8446 section 6.1
  chain: [default]
  uut client { versions: [tls13] }
  matrix {
    count in [1, 4]
  }
  flow handshake {
    repeat $count { send alert warning/user_canceled }
    send AppData
    recv AppData
  }
  expect ok
  expect close if gnutls
}

plzn tls "client/tls13-warning-alert-flood/application-data-five-to-sixteen" {
  rfc 8446 section 6.1
  chain: [default]
  uut client { versions: [tls13] }
  matrix {
    count in [5, 6, 16]
  }
  flow handshake {
    repeat $count { send alert warning/user_canceled }
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/unexpected_message if openssl
  expect alert fatal/unexpected_message if boringssl
  expect close if rustls
  expect close if wolfssl
  expect close if gnutls
}

plzn tls "client/tls13-warning-alert-flood/application-data-seventeen-to-thirty-two" {
  rfc 8446 section 6.1
  chain: [default]
  uut client { versions: [tls13] }
  matrix {
    count in [17, 32]
  }
  flow handshake {
    repeat $count { send alert warning/user_canceled }
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/unexpected_message if openssl
  expect alert fatal/unexpected_message if boringssl
  expect close if rustls
  expect close if wolfssl
  expect alert fatal/unexpected_message if go
  expect close if gnutls
}

plzn tls "client/tls13-warning-alert-flood/application-data-over-thirty-two" {
  rfc 8446 section 6.1
  chain: [default]
  uut client { versions: [tls13] }
  matrix {
    count in [33, 100]
  }
  flow handshake {
    repeat $count { send alert warning/user_canceled }
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/unexpected_message if openssl
  expect alert fatal/unexpected_message if boringssl
  expect close if rustls
  expect close if wolfssl
  expect alert fatal/unexpected_message if go
  expect close if gnutls
  expect alert fatal/unexpected_message if botan
}

plzn tls "client/tls13-warning-alert-flood/interleaved-with-application-data-one-burst" {
  rfc 8446 section 6.1
  chain: [default]
  uut client { versions: [tls13] }
  matrix {
    count in [1]
  }
  flow handshake {
    repeat $count {
      repeat 4 { send alert warning/user_canceled }
      send AppData
      recv AppData
    }
  }
  expect ok
  expect close if gnutls
}

plzn tls "client/tls13-warning-alert-flood/interleaved-with-application-data-two-or-more-bursts" {
  rfc 8446 section 6.1
  chain: [default]
  uut client { versions: [tls13] }
  matrix {
    count in [2, 3, 5]
  }
  flow handshake {
    repeat $count {
      repeat 4 { send alert warning/user_canceled }
      send AppData
      recv AppData
    }
  }
  expect ok
  expect close if rustls
  expect close if wolfssl
  expect close if gnutls
}
