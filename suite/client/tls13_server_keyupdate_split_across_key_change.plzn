plzn tls "client/tls13-server-keyupdate-split-across-key-change" {
  rfc 8446 section 5.1
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake after recv Finished {
    send AppData
    recv AppData
    send KeyUpdate { request_update: update_not_requested } @ fragment 3 hold
    flush_fragment
    wait 300 ms
  }
  expect alert fatal/bad_record_mac
  expect close if libressl
}
