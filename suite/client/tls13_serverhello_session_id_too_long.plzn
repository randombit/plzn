plzn tls "client/tls13-serverhello-session-id-too-long" {
  rfc 8446 section 4.1.3
  chain: [default]
  uut client { versions: [tls13] }
  flow handshake {
    send ServerHello {
      legacy_session_id_echo: 0xAA * 33
    }
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if boringssl
  expect alert fatal/decode_error if botan
  expect alert fatal/decode_error if rustls
}
