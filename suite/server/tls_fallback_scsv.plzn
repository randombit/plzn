  }
  expect alert fatal/inappropriate_fallback
}

plzn tls "server/tls-fallback-scsv/noop-at-tls11-maximum" {
  rfc 7507 section 3
  chain: [rsa_2048]
  uut server { versions: [tls11] }
  peer { capabilities: [rsa, aes128_cbc_sha] }
  flow handshake {
    send ClientHello {
      cipher_suites: [RSA_WITH_AES_128_CBC_SHA, FALLBACK_SCSV]
    }
    send AppData
    recv AppData
  }
  expect ok
}
