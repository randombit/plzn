plzn tls "server/tls13-missing-signature-algorithms" {
  rfc 8446 section 9.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello {
      -ext signature_algorithms
    }
    send AppData
    recv AppData
    close
  }
  expect alert fatal/missing_extension
  expect alert fatal/handshake_failure if boringssl
  expect alert fatal/handshake_failure if rustls
}
