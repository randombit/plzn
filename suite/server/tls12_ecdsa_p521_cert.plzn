plzn tls "server/tls12-p521-cert" {
  rfc 5246 section 7.4.3
  chain: [ecdsa_p521]
  uut server { versions: [tls12] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [ecdsa_secp521r1_sha512]
      +ext supported_groups = [secp256r1, secp521r1]
    }
    send AppData
    recv AppData
    close
  }
  expect ok
}
