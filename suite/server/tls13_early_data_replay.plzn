plzn tls "server/tls13-early-data-ticket-replay-rejected" {
  rfc 8446 section 8
  chain: [default]
  uut server {
    versions: [tls13]
    session_tickets: 1
    max_early_data: 1024
  }
  xfail gnutls "accepts the ticket's 0-RTT again from a new ClientHello: its RFC 8446 8.2 ClientHello recording keys on the PSK binder, so only a byte-identical replay is caught"

  session initial {
    flow handshake {
      recv NewSessionTicket { has_ext: early_data }
      close
    }
    expect ok
  }

  session accepted [resumes: initial] {
    flow {
      send ClientHello
      send EarlyData { size: 32 }
      recv ServerHello { has_ext: pre_shared_key }
      recv EncryptedExtensions { has_ext: early_data }
      recv Finished
      send EndOfEarlyData
      send Finished
      send AppData
      recv AppData
    }
    expect ok
  }

  session replayed [resumes: initial] {
    flow {
      send ClientHello
      send EarlyData { size: 32 }
      recv ServerHello
      recv EncryptedExtensions { lacks_ext: early_data }
      close
    }
    expect ok
  }
}
