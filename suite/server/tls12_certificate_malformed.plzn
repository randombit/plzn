plzn tls "server/tls12-certificate-malformed/empty-client-cert-entry" {
  rfc 5246 section 7.4.6
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pss_rsae_sha256] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: none } @ pad +3, @ set[-4] = 3
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/{decode_error,bad_certificate}
  expect close if libressl
}

plzn tls "server/tls12-certificate-malformed/fuzz-empty-certificate-lengths" {
  rfc 5246 section 7.4.6
  matrix {
    i in [1, 2, 3, 4, 6]
    j in [0, 1, 3, 7]
  }
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pss_rsae_sha256] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: none } @ pad +3, @ set[2] = $i, @ set[5] = $j
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/{decode_error,bad_certificate}
}

plzn tls "server/tls12-certificate-malformed/correct-cert-followed-by-empty" {
  rfc 5246 section 7.4.6
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pss_rsae_sha256] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { certificate_list: [rsa, empty] }
    send ClientKeyExchange
    send CertificateVerify
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect alert fatal/decode_error
  expect ok if rustls
  expect close if libressl
}

