plzn tls "server/tls12-certificate-malformed/valid-handshake" {
  rfc 5246 section 7.4.6
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pss_rsae_sha256] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa }
    send ClientKeyExchange
    send CertificateVerify
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-certificate-malformed/no-client-cert" {
  rfc 5246 section 7.4.6
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pss_rsae_sha256] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: none }
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/handshake_failure
  expect alert fatal/certificate_required if rustls
}

plzn tls "server/tls12-certificate-malformed/fuzz-certificates-length" {
  rfc 5246 section 7.4.6
  matrix {
    v in [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0xff]
  }
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pss_rsae_sha256] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa } @ xor[3] = $v
    send ClientKeyExchange
    send CertificateVerify
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/{decode_error,bad_certificate}
}

