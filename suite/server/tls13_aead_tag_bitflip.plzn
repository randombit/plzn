plzn tls "server/tls13-aead-tag-bitflip" {
  rfc 8446 section 5.2
  chain: [default]
  uut server { versions: [tls13] }
  matrix {
    pos in -16..-1
    bit in [0x01, 0x80]
  }
  flow handshake {
    send AppData { size: 18 } @ xor[record.aead_tag, $pos] = $bit
    recv AppData
  }
  expect alert fatal/bad_record_mac
  expect close if libressl
}

plzn tls "server/tls13-record-integrity-suite-group" {
  rfc 8446 section 5.2
  chain: [default]
  uut server {
    versions: [tls13]
    cipher_suites: [$suite]
    curves: [$group]
  }
  matrix {
    suite in cipher_suites(tls13)
    group in groups(tls13)
  }
  flow handshake {
    send AppData { size: 18 } @ xor[record.aead_tag, 0] = 0xff
    recv AppData
  }
  expect alert fatal/bad_record_mac
  expect close if libressl
}
