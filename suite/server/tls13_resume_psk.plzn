plzn tls "server/tls13-resume-psk" {
  rfc 8446 section 4.6.1
  chain: [default]
  uut server {
    versions: [tls13]
    cipher_suites: [$suite]
    curves: [$group]
  }
  matrix {
    suite in cipher_suites(tls13)
    group in groups(tls13)
  }

  session initial {
    flow handshake {
      recv NewSessionTicket
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send AppData
      recv AppData
    }
    expect ok
  }
}
