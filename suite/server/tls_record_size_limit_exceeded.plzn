plzn tls "server/tls12-record-size-limit/rejects-oversized-record" {
  rfc 8449 section 4
  chain: [default]
  uut server { versions: [tls12], record_size_limit: 512 }
  flow handshake until send ClientHello {
    send ClientHello { +ext record_size_limit = 16385 }
    recv ServerHello { ext record_size_limit == 512 }
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData { size: 513 }
  }
  expect alert fatal/record_overflow
}

plzn tls "server/tls13-record-size-limit/rejects-oversized-content" {
  rfc 8449 section 4
  chain: [default]
  uut server { versions: [tls13], record_size_limit: 513 }
  flow handshake until send ClientHello {
    send ClientHello { +ext record_size_limit = 16385 }
    recv ServerHello
    recv EncryptedExtensions { ext record_size_limit == 513 }
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData { size: 513 }
  }
  expect alert fatal/record_overflow
}

plzn tls "server/tls13-record-size-limit/rejects-oversized-padding" {
  rfc 8449 section 4
  chain: [default]
  uut server { versions: [tls13], record_size_limit: 513 }
  flow handshake until send ClientHello {
    send ClientHello { +ext record_size_limit = 16385 }
    recv ServerHello
    recv EncryptedExtensions { ext record_size_limit == 513 }
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData { size: 32 } @ record_pad 481
  }
  expect alert fatal/record_overflow
}
