plzn tls "server/tls12-raw-public-key-server-authentication" {
  rfc 7250 section 4.2
  chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send ClientHello {
      +ext server_certificate_type = [raw_public_key]
      -ext client_certificate_type
    }
    recv ServerHello { ext server_certificate_type == raw_public_key }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-raw-public-key-server-authentication" {
  rfc 7250 section 4.2
  chain: [ecdsa_p256]
  uut server {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send ClientHello {
      +ext server_certificate_type = [raw_public_key]
      -ext client_certificate_type
    }
    recv EncryptedExtensions { ext server_certificate_type == raw_public_key }
    send AppData
    recv AppData
  }
  expect ok
}

