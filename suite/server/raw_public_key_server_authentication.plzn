plzn tls "server/tls12-prefers-x509-over-raw-public-key" {
  rfc 7250 section 4.2
  chain: [default]
  uut server {
    versions: [tls12]
    server_certificate_types: [x509, raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    recv Certificate { certificate_type: x509 }
    send AppData
    recv AppData
  }
  expect ok
  xfail gnutls "selects the first supported type in the client's list; its certificate-type selection ignores its own CTYPE priority order"
}

plzn tls "server/tls13-prefers-x509-over-raw-public-key" {
  rfc 7250 section 4.2
  chain: [default]
  uut server {
    versions: [tls13]
    server_certificate_types: [x509, raw_public_key]
  }
  xfail gnutls "selects the first supported type in the client's list; its certificate-type selection ignores its own CTYPE priority order"
  peer { capabilities: [offer_rpk] }
  flow handshake {
    recv Certificate { certificate_type: x509 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls12-raw-public-key-only-no-common-certificate-type" {
  rfc 7250 section 4.2
  chain: [default]
  uut server {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  flow handshake {
    send ClientHello { +ext server_certificate_type = [5] }
  }
  expect alert fatal/unsupported_certificate
  expect alert fatal/handshake_failure if boringssl
}

plzn tls "server/tls13-raw-public-key-only-no-common-certificate-type" {
  rfc 7250 section 4.2
  chain: [default]
  uut server {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  flow handshake {
    send ClientHello { +ext server_certificate_type = [5] }
  }
  expect alert fatal/unsupported_certificate
  expect alert fatal/handshake_failure if boringssl
  expect alert fatal/handshake_failure if rustls
}

plzn tls "server/tls13-raw-public-key-ignores-signature-algorithms-cert" {
  rfc 8446 section 4.2.3
  rfc 7250 section 4.2
  chain: [ecdsa_p256]
  uut server {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms_cert = [rsa_pss_rsae_sha256]
    }
    recv EncryptedExtensions { ext server_certificate_type == raw_public_key }
    send AppData
    recv AppData
  }
  expect ok
}

