plzn tls "server/tls12-raw-public-key-only-rejects-absent-certificate-type" {
  rfc 7250 section 4.2
  chain: [default]
  uut server {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  xfail openssl "presents X.509 despite its raw-public-key-only policy"
  flow handshake {}
  expect alert fatal/{unsupported_certificate,handshake_failure}
}

