plzn tls "server/tls12-raw-public-key-server-authentication-resumption" {
  rfc 7250 section 4.2
  rfc 5077 section 3.1
  chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }

  session initial {
    flow handshake { close }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send AppData
      recv AppData
    }
    expect ok
  }
}

plzn tls "server/tls13-raw-public-key-server-authentication-resumption" {
  rfc 7250 section 4.2
  rfc 8446 section 4.6.1
  chain: [ecdsa_p256]
  uut server {
    versions: [tls13]
    server_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }

  session initial {
    flow handshake {
      recv NewSessionTicket
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send AppData
      recv AppData
    }
    expect ok
  }
}
