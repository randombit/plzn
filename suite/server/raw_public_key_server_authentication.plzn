plzn tls "server/tls12-rejects-default-only-server-certificate-type-list" {
  rfc 7250 section 4.2
  chain: [default]
  uut server {
    versions: [tls12]
    server_certificate_types: [raw_public_key, x509]
  }
  xfail openssl "accepts the forbidden default-only certificate-type list"
  xfail gnutls "accepts the forbidden default-only certificate-type list"
  flow handshake {
    send ClientHello { +ext server_certificate_type = [x509] }
  }
  expect alert fatal/{decode_error,illegal_parameter}
}

