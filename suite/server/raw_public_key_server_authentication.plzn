plzn tls "server/tls12-rejects-empty-server-certificate-type-list" {
  rfc 7250 section 3
  chain: [default]
  uut server {
    versions: [tls12]
    server_certificate_types: [raw_public_key, x509]
  }
  flow handshake {
    send ClientHello { +ext server_certificate_type = [] }
  }
  expect alert fatal/{decode_error,illegal_parameter,unsupported_certificate}
}

plzn tls "server/tls13-rejects-empty-server-certificate-type-list" {
  rfc 7250 section 3
  chain: [default]
  uut server {
    versions: [tls13]
    server_certificate_types: [raw_public_key, x509]
  }
  flow handshake {
