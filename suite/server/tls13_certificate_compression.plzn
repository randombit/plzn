plzn tls "server/tls13-cert-compression-empty-list" {
  rfc 8879 section 3
  chain: [default]
  uut server {
    versions: [tls13]
    compress_certificate: true
  }
  peer { capabilities: [compress_cert] }
  flow handshake {
    send ClientHello { +ext compress_certificate = raw "00" }
    recv ServerHello
  }
  expect alert fatal/decode_error
  expect ok if botan
}

plzn tls "server/tls13-cert-compression-duplicated-algorithms" {
  rfc 8879 section 3
  chain: [default]
  uut server {
    versions: [tls13]
    compress_certificate: true
  }
  peer { capabilities: [compress_cert] }
  flow handshake {
    send ClientHello { +ext compress_certificate = [zlib, zlib, zlib] }
    recv Certificate { compressed: 1 }
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/illegal_parameter if rustls
}

