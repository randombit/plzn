plzn tls "server/tls13-cert-compression-smoke-zlib" {
  rfc 8879 section 4
  chain: [default]
  uut server {
    versions: [tls13]
    compress_certificate: true
  }
  peer { capabilities: [compress_cert] }
  flow handshake {
    recv Certificate { compressed: 1 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls12-cert-compression-ignored" {
  rfc 8879 section 3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send ClientHello { +ext compress_certificate = [zlib] }
    recv ServerHello { lacks_ext: compress_certificate }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-cert-compression-zlib-preferred" {
  rfc 8879 section 3
  chain: [default]
  uut server {
    versions: [tls13]
    compress_certificate: true
  }
  peer { capabilities: [compress_cert] }
  flow {
    send ClientHello { +ext compress_certificate = [zlib, brotli] }
    recv ServerHello
    recv EncryptedExtensions
    recv CompressedCertificate { algorithm: zlib }
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-cert-compression-unreasonable-algorithm-0000-alone" {
  rfc 8879 section 7.3
  chain: [default]
  uut server {
    versions: [tls13]
    compress_certificate: true
  }
  peer { capabilities: [compress_cert] }
  flow handshake {
    send ClientHello { +ext compress_certificate = raw "020000" }
    recv Certificate { compressed: 0 }
    send AppData
    recv AppData
  }
  expect ok
}

