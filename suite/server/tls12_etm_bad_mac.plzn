plzn tls "server/tls12-etm-bad-mac" {
  rfc 7366 section 3
  chain: [default]
  uut server {
    versions: [tls12]
    encrypt_then_mac: true
  }
  peer { capabilities: [cbc] }
  flow handshake {
    send ClientHello {
      +ext encrypt_then_mac
    }
    recv ServerHello { has_ext: encrypt_then_mac }
    send AppData { size: 18 } @ xor[record.mac, 0] = 0x01
    recv AppData
  }
  expect alert fatal/bad_record_mac
}
