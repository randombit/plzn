plzn tls "server/tls12-ecdhe-padded-shared-secret/premaster-with-leading-zero-byte" {
  rfc 8422 section 5.10
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_rsa] }
  chain: [rsa_2048]
  matrix {
    group in [0x001d, 0x0017, 0x0018, 0x0019]
  }
  flow handshake {
    send ClientKeyExchange { shared_secret_leading_zeros: 1 }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}
