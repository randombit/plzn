plzn tls "server/tls12-rejects-empty-client-certificate-type-list" {
  rfc 7250 section 3
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    require_client_cert: true
    client_certificate_types: [raw_public_key, x509]
  }
  flow handshake {
    send ClientHello { +ext client_certificate_type = [] }
  }
  expect alert fatal/{decode_error,illegal_parameter,unsupported_certificate}
}

