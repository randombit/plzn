plzn tls "server/tls12-raw-public-key-only-rejects-absent-client-certificate-type" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    require_client_cert: true
    client_certificate_types: [raw_public_key]
  }
  xfail openssl "accepts an X.509 client credential despite its raw-public-key-only policy"
  xfail gnutls "accepts an X.509 client credential despite its raw-public-key-only policy"
  flow handshake {}
  expect alert fatal/{unsupported_certificate,handshake_failure}
}

