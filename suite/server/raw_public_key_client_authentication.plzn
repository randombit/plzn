plzn tls "server/tls12-raw-public-key-client-authentication" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    require_client_cert: true
    client_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake {
    send ClientHello {
      -ext server_certificate_type
      +ext client_certificate_type = [raw_public_key]
    }
    recv ServerHello { ext client_certificate_type == raw_public_key }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-raw-public-key-client-authentication" {
