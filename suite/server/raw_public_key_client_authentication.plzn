plzn tls "server/tls12-client-certificate-types-prefers-x509" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    require_client_cert: true
    client_certificate_types: [x509, raw_public_key]
  }
  xfail openssl "selects the client's raw-public-key preference instead of its configured X.509 preference"
  peer { capabilities: [offer_rpk] }
  flow handshake {
    recv ServerHello { ext client_certificate_type == x509 }
    send AppData
    recv AppData
  }
  expect ok
  xfail gnutls "selects the first supported type in the client's list; its certificate-type selection ignores its own CTYPE priority order"
}

plzn tls "server/tls13-client-certificate-types-prefers-x509" {
  rfc 7250 section 4.1
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server {
    versions: [tls13]
    require_client_cert: true
    client_certificate_types: [x509, raw_public_key]
  }
  xfail openssl "selects the client's raw-public-key preference instead of its configured X.509 preference"
  xfail gnutls "selects the first supported type in the client's list; its certificate-type selection ignores its own CTYPE priority order"
  peer { capabilities: [offer_rpk] }
  flow handshake {
    recv EncryptedExtensions { ext client_certificate_type == x509 }
