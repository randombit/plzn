plzn tls "server/tls13-rejects-raw-public-key-without-certificate-verify" {
  rfc 8446 section 4.4.3
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server {
    versions: [tls13]
    require_client_cert: true
    client_certificate_types: [raw_public_key]
  }
  peer { capabilities: [offer_rpk] }
  flow handshake until send CertificateVerify {
    send Finished
  }
  expect alert fatal/unexpected_message
}
