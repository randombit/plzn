plzn tls "server/tls13-ecdsa-in-certificate-verify/corrupted-signature" {
  rfc 8446 section 4.4.3
  # handshake.signature includes a two-byte length; offsets from 2 address the DER signature.
  matrix {
    pos in [2, 3, 5, 40, -1]
    v in [0x01, 0x80]
  }
  chain: [default]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp521r1_sha512, ecdsa_secp384r1_sha384, ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256, rsa_pss_pss_sha256, rsa_pss_rsae_sha384, rsa_pss_pss_sha384] }
    recv ServerHello
    recv EncryptedExtensions
    recv CertificateRequest
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Certificate { credential: ecdsa_p256 }
    send CertificateVerify { } @ xor[handshake.signature, $pos] = $v
    send Finished
  }
  expect alert fatal/{decrypt_error,decode_error}
}

