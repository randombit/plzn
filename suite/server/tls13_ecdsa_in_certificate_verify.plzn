plzn tls "server/tls13-ecdsa-in-certificate-verify/valid-handshake" {
  rfc 8446 section 4.4.3
  chain: [default]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp521r1_sha512, ecdsa_secp384r1_sha384, ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256, rsa_pss_pss_sha256, rsa_pss_rsae_sha384, rsa_pss_pss_sha384] }
    recv ServerHello
    recv EncryptedExtensions
    recv CertificateRequest
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Certificate { credential: ecdsa_p256 }
    send CertificateVerify { }
    send Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls13-ecdsa-in-certificate-verify/ecdsa_secp256r1_sha256-works" {
  rfc 8446 section 4.4.3
  chain: [default]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp521r1_sha512, ecdsa_secp384r1_sha384, ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256, rsa_pss_pss_sha256, rsa_pss_rsae_sha384, rsa_pss_pss_sha384] }
    recv ServerHello
    recv EncryptedExtensions
    recv CertificateRequest
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Certificate { credential: ecdsa_p256 }
    send CertificateVerify { sign_with: ecdsa_secp256r1_sha256 }
