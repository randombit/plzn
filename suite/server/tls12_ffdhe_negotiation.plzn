plzn tls "server/tls12-ffdhe-negotiation/no-overlap-between-groups" {
  rfc 7919 section 3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake until send ClientHello {
    send ClientHello { cipher_suites: [0x0002, DHE_RSA_WITH_AES_128_CBC_SHA], +ext supported_groups = raw "0002 01ff" }
    recv ServerHello
  }
  expect alert fatal/{handshake_failure,insufficient_security}
}
