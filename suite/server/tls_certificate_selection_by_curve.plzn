plzn tls "server/tls12-certificate-selection-curve-no-match" {
  rfc 8422 section 5.1.1
  chain: [ecdsa_p384]
  xfail gnutls "accepts a TLS 1.2 ECDSA certificate on a curve the client did not offer"
  xfail go "accepts a TLS 1.2 ECDSA certificate on a curve the client did not offer"
  xfail rustls "accepts a TLS 1.2 ECDSA certificate on a curve the client did not offer"
  xfail wolfssl "selects ECDHE_ECDSA with a P-384 certificate although the client's supported_groups omit secp384r1"
  uut server {
    versions: [tls12]
    cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
    curves: [x25519, secp256r1, secp384r1]
  }
  flow handshake {
    send ClientHello {
      cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
      +ext supported_groups = [x25519, secp256r1]
      +ext signature_algorithms = [ecdsa_secp384r1_sha384]
    }
    recv ServerHello
  }
  expect alert fatal/{handshake_failure, access_denied}
}

plzn tls "server/tls12-certificate-selection-ed25519-ignores-curve-list" {
  rfc 8422 section 5.1.1
  chain: [ecdsa_p384, ed25519]
  xfail botan "does not treat Ed25519 as ECDHE_ECDSA-compatible in TLS 1.2"
  uut server {
    versions: [tls12]
    cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
    curves: [x25519, secp256r1]
  }
  flow handshake {
    send ClientHello {
      cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
      +ext supported_groups = [x25519, secp256r1]
      +ext signature_algorithms = [ed25519]
    }
    recv Certificate { entries: 1, leaf_key: ed25519 }
    recv ServerKeyExchange { named_group: x25519, signature_scheme: ed25519 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-certificate-selection-ignores-supported-groups" {
  rfc 8446 section 4.2.7
  chain: [ecdsa_p256, ecdsa_p384]
  uut server {
    versions: [tls13]
    curves: [x25519]
  }
  flow handshake {
    send ClientHello {
      +ext supported_groups = [x25519]
      +ext signature_algorithms = [ecdsa_secp384r1_sha384]
    }
    recv Certificate { entries: 1, leaf_key: ecdsa_p384 }
    recv CertificateVerify { algorithm: ecdsa_secp384r1_sha384 }
    send AppData
    recv AppData
  }
  expect ok
}
