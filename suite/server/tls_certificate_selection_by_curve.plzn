plzn tls "server/tls12-certificate-selection-p256-curve-match-first" {
  rfc 8422 section 5.1.1
  chain: [ecdsa_p256, ecdsa_p384]
  uut server {
    versions: [tls12]
    cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
    curves: [x25519, secp256r1, secp384r1]
  }
  flow handshake {
    send ClientHello {
      cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
      +ext supported_groups = [x25519, secp256r1]
      +ext signature_algorithms = [ecdsa_secp384r1_sha384, ecdsa_secp256r1_sha256]
    }
    recv Certificate { entries: 1, leaf_key: ecdsa_p256 }
    recv ServerKeyExchange { named_group: x25519 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls12-certificate-selection-p256-curve-match-second" {
  rfc 8422 section 5.1.1
  chain: [ecdsa_p384, ecdsa_p256]
  xfail botan "does not apply supported_groups to TLS 1.2 ECDSA credential selection"
  xfail gnutls "does not apply supported_groups to TLS 1.2 ECDSA credential selection"
  uut server {
    versions: [tls12]
    cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
    curves: [x25519, secp256r1, secp384r1]
  }
  flow handshake {
    send ClientHello {
      cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
      +ext supported_groups = [x25519, secp256r1]
      +ext signature_algorithms = [ecdsa_secp384r1_sha384, ecdsa_secp256r1_sha256]
    }
    recv Certificate { entries: 1, leaf_key: ecdsa_p256 }
    recv ServerKeyExchange { named_group: x25519 }
    send AppData
    recv AppData
  }
  expect ok
}

