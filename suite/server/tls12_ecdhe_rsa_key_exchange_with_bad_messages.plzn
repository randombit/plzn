    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}

plzn tls "server/tls12-ecdhe-rsa-key-exchange-with-bad-messages/self-inconsistent-point" {
  rfc 8422 section 5.11
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe, secp256r1] }
  flow handshake {
    send ClientKeyExchange @ xor[handshake.ecdh_point, -1] = 0xff
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}

plzn tls "server/tls12-ecdhe-rsa-key-exchange-with-bad-messages/truncated-Yc" {
  rfc 8422 section 5.11
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe, secp256r1] }
  flow handshake {
    send ClientKeyExchange @ pad -1
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/decode_error
  expect close if rustls
}

plzn tls "server/tls12-ecdhe-rsa-key-exchange-with-bad-messages/padded-Yc" {
