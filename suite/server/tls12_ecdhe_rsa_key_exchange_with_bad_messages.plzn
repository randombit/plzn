plzn tls "server/tls12-ecdhe-rsa-key-exchange-with-bad-messages/invalid-point-0-1" {
  rfc 8422 section 5.11
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe, secp256r1] }
  flow handshake {
    send ClientKeyExchange { key_share_point: zero } @ set[handshake.ecdh_point, -1] = 0x01
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}

