plzn tls "server/tls12-ske-ecdsa-p256-scheme" {
  rfc 8422 section 5.4
  chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_ecdsa] }
  matrix {
    sigalg in [ecdsa_secp256r1_sha256]
  }
  flow handshake {
    recv ServerKeyExchange { signature_scheme: $sigalg }
    send AppData
    recv AppData
    close
  }
  expect ok
}
