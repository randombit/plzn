plzn tls "server/tls13-ccs-invalid-byte" {
  rfc 8446 section 5
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ChangeCipherSpec {
      type: 0xff
    }
  }
  expect alert fatal/unexpected_message
  expect alert fatal/bad_record_mac if boringssl
  expect alert fatal/illegal_parameter if libressl
}
