plzn tls "server/tls12-etm-not-echoed-with-aead"{
  rfc 7366 section 3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe, gcm] }
  flow handshake {
    send ClientHello {
      +ext encrypt_then_mac
    }
    recv ServerHello { lacks_ext: encrypt_then_mac }
    send AppData
    recv AppData
    close
  }
  expect ok
}
