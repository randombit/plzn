plzn tls "server/tls12-sigalg-mismatch" {
  rfc 5246 section 7.4.1.4.1
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_rsa] }
  chain: [rsa_2048]
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384]
    }
  }
  expect alert fatal/handshake_failure
  expect alert fatal/decode_error if libressl
}
