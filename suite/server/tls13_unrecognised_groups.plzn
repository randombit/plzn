plzn tls "server/tls13-unrecognised-groups/only-unknown-key-shares-ec-secp256r1-listed" {
  rfc 8446 section 4.2.8
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [hrr, secp256r1] }
  matrix { size in [64, 128, 256] }
  flow handshake {
    send ClientHello {
      +ext supported_groups = [secp256r1, 0x0022..0x00fe]
      +ext key_share = [0x0022..0x00fe : 0xab * $size]
    } @ fragment 16384
    recv HelloRetryRequest { key_share_group: secp256r1, has_ext: supported_versions }
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/decode_error if libressl
}

