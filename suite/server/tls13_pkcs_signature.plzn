plzn tls "server/tls13-pkcs-signature/rsa_pkcs1_md5" {
  rfc 8446 section 4.2.3
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_md5] }
  }
  expect alert fatal/handshake_failure
}

