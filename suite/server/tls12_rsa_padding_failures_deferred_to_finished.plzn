plzn tls "server/tls12-rsa-padding-failures-deferred-to-finished/pkcs1-block-type-3-no-early-response" {
  rfc 5246 section 7.4.7.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow handshake {
    send ClientKeyExchange @ set[pkcs1.block_type, 0] = 0x03
    wait 200 ms
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/bad_record_mac
}
