plzn tls "server/tls12-rsa-padding-failures-deferred-to-finished/valid-pkcs1-padding" {
  rfc 5246 section 7.4.7.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  matrix {
    suite in [0x002f, 0x0035, 0x003c]
  }
  flow handshake {
    send ClientKeyExchange { padding_byte: 0x55 }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-rsa-padding-failures-deferred-to-finished/pkcs1-block-type-3" {
  rfc 5246 section 7.4.7.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  matrix {
    suite in [0x002f, 0x0035, 0x003c]
  }
  flow handshake {
    send ClientKeyExchange @ set[pkcs1.block_type, 0] = 0x03
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/bad_record_mac
}

