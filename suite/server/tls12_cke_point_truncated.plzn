plzn tls "server/tls12-cke-point-truncated" {
  rfc 8422 section 5.4.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe, secp256r1] }
  flow handshake {
    send ClientKeyExchange {
      key_share_point: truncated
    }
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}
