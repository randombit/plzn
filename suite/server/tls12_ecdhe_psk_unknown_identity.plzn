plzn tls "server/tls12-ecdhe-psk-unknown-identity" {
  rfc 5489 section 3.3
  chain: []
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_psk] }
  psk {
    identity: "plzn-psk-id"
    secret: "6f6c6f6c6f6c6f6c"
  }
  flow handshake {
    send ClientKeyExchange { psk_identity: "not-an-identity" }
  }
  expect alert fatal/unknown_psk_identity
}
