plzn tls "server/tls13-zero-content-type/zero-content-type-after-handshake" {
  rfc 8446 section 5.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send empty_record 0x00
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decrypt_error if boringssl
  expect close if rustls
}

plzn tls "server/tls13-zero-content-type/zero-content-type-with-padding-after-handshake" {
  rfc 8446 section 5.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send record 0 raw 0x00 * 42
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decrypt_error if boringssl
  expect close if rustls
}

plzn tls "server/tls13-zero-content-type/zero-content-type-during-handshake" {
  rfc 8446 section 5.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send Finished {
    send empty_record 0x00
    send Finished
    recv NewSessionTicket
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decrypt_error if boringssl
  expect close if rustls
}

plzn tls "server/tls13-zero-content-type/zero-content-type-with-padding-during-handshake" {
  rfc 8446 section 5.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send Finished {
    send record 0 raw 0x00 * 42
    send Finished
    recv NewSessionTicket
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decrypt_error if boringssl
  expect close if rustls
}

plzn tls "server/tls13-zero-content-type/zero-content-type-during-application-data" {
  rfc 8446 section 5.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send AppData
    recv AppData
    send empty_record 0x00
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decrypt_error if boringssl
  expect close if rustls
}

plzn tls "server/tls13-zero-content-type/zero-content-type-with-padding-during-application-data" {
  rfc 8446 section 5.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send AppData
    recv AppData
    send record 0 raw 0x00 * 42
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decrypt_error if boringssl
  expect close if rustls
}
