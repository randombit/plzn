plzn tls "server/tls13-empty-alert/empty-alert-using-handshake-keys" {
  rfc 8446 section 5.1
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send Finished {
    send empty_record alert
    send Finished
    recv NewSessionTicket
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decode_error if boringssl
  expect alert fatal/decode_error if rustls
}

plzn tls "server/tls13-empty-alert/empty-alert-with-2-bytes-of-padding-using-handshake-keys" {
  rfc 8446 section 5.1
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send Finished {
    send empty_record alert @ record_pad 2
    send Finished
    recv NewSessionTicket
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decode_error if boringssl
  expect alert fatal/decode_error if rustls
}

