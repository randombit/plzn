plzn tls "server/tls12-session-id-too-long" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send ClientHello {
      legacy_session_id: 0x41 * 33
    }
  }
  expect alert fatal/decode_error
  expect alert fatal/illegal_parameter if libressl
}
