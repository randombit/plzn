plzn tls "server/tls12-alert-truncated" {
  rfc 5246 section 7.2
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientKeyExchange {
    send raw "150303000102"
    wait 300 ms
  }
  expect alert fatal/{decode_error,unexpected_message}
  expect close if wolfssl
  expect close if libressl
}
