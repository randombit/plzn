plzn tls "server/tls12-ecdsa-sig-flexibility/connect-with-sha1-ecdsa-only" {
  rfc 4492 section 5.10
  chain: [ecdsa_p256]
  skip botan "Botan TLS does not implement the explicit ECDSA/SHA-1 SignatureScheme"
  skip rustls "rustls does not implement ECDSA/SHA-1"
  uut server {
    versions: [tls12]
    signing_prefs: [ecdsa_sha1]
  }
  peer { capabilities: [ecdhe_ecdsa, aes128_gcm_sha256] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_sha1]
      +ext supported_groups = [secp256r1, secp384r1, secp521r1]
    }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange { signature_scheme: ecdsa_sha1 }
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-ecdsa-sig-flexibility/connect-with-sha224-ecdsa-only" {
  rfc 4492 section 5.10
  chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_ecdsa, aes128_gcm_sha256] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_sha224]
      +ext supported_groups = [secp256r1, secp384r1, secp521r1]
    }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange { signature_scheme: ecdsa_sha224 }
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect alert fatal/handshake_failure
  expect ok if openssl
  expect alert fatal/decode_error if libressl
}

