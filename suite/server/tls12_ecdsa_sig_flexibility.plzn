plzn tls "server/tls12-ecdsa-sig-flexibility/connect-with-ecdsa_brainpoolP256r1tls13_sha256-only" {
  rfc 8734 section 3
  chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_ecdsa, aes128_gcm_sha256] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_brainpoolP256r1tls13_sha256]
      +ext supported_groups = [secp256r1, secp384r1, secp521r1]
    }
  }
  expect alert fatal/handshake_failure
  expect alert fatal/decode_error if libressl
}

