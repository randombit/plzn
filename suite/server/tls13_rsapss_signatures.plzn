plzn tls "server/tls13-rsapss-signatures/rsa_pss_rsae_sha256" {
  rfc 8446 section 4.2.3
  chain: [rsa_pss]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256] }
  }
  expect alert fatal/handshake_failure
}

plzn tls "server/tls13-rsapss-signatures/rsa_pss_rsae_sha384" {
  rfc 8446 section 4.2.3
  chain: [rsa_pss]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha384] }
  }
  expect alert fatal/handshake_failure
}

plzn tls "server/tls13-rsapss-signatures/rsa_pss_rsae_sha512" {
  rfc 8446 section 4.2.3
  chain: [rsa_pss]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha512] }
  }
  expect alert fatal/handshake_failure
}

plzn tls "server/tls13-rsapss-signatures/rsa_pss_pss_sha256" {
  rfc 8446 section 4.2.3
  chain: [rsa_pss]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_pss_sha256] }
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls13-rsapss-signatures/rsa_pss_pss_sha384" {
  rfc 8446 section 4.2.3
  chain: [rsa_pss]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_pss_sha384] }
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls13-rsapss-signatures/rsa_pss_pss_sha512" {
  rfc 8446 section 4.2.3
  chain: [rsa_pss]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_pss_sha512] }
    send AppData
    recv AppData
    close
  }
