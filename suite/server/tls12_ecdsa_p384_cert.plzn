plzn tls "server/tls12-p384-cert" {
  rfc 5246 section 7.4.3
  chain: [ecdsa_p384]
  uut server { versions: [tls12] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [ecdsa_secp384r1_sha384]
      # OpenSSL requires the certificate's P-384 curve here even though ECDHE uses P-256.
      +ext supported_groups = [secp256r1, secp384r1]
    }
    send AppData
    recv AppData
    close
  }
  expect ok
}
