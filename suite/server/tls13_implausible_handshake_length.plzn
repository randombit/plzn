# TLS 1.3 server: a handshake header announcing 2^24 - 1 bytes is rejected
# from the header alone, with no size limit configured.
#
# Each case sets the 24-bit handshake length of one message to 0xffffff and
# sends only that 4-byte header (`fragment 4 hold_all` withholds the real
# body), then requires the peer to give up within `wait 300 ms`. No RFC caps a
# handshake message below the 24-bit field, but every library has a built-in
# limit far below 16 MiB; a peer that waits instead is ready to buffer the
# whole announced body before looking at it.
#
# The response is unspecified, so each backend's is pinned: Botan sends
# handshake_failure (65536-byte default limit); OpenSSL and BoringSSL
# illegal_parameter; Go internal_error.
#
# RFC 8446 6.2 makes the alert a SHOULD, so a prompt close without one passes
# where that is the library's path: rustls returns HandshakePayloadTooLarge
# without handle_deframe_error's alert, wolfSSL's HANDSHAKE_SIZE_ERROR never
# chooses one, and LibreSSL's TLS 1.3 stack fails with TLS13_IO_FAILURE and no
# alert.
#
# GnuTLS has no header-time size check: parse_handshake_header takes any
# length, and gnutls_handshake_set_max_packet_length bounds the transcript
# only once a whole message has arrived, so it waits (xfail).
# suite/*/*max_handshake_message_size.plzn test a configured limit the same
# way.

plzn tls "server/tls13-implausible-handshake-length/client-hello" {
  syntax 1.0
  rfc 8446 section 4
  chain: [ecdsa_p256]
  uut server { versions: [tls13] }
  xfail gnutls "parses any handshake length and checks its size limit only once the whole message has arrived (CHECK_SIZE in lib/handshake.c), so it waits for the announced 16 MiB"
  flow handshake until send ClientHello {
    send ClientHello @ set[handshake.length, 0..2] = 0xff, @ fragment 4 hold_all
    wait 300 ms
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/handshake_failure if botan
  expect alert fatal/internal_error if go
  expect close if rustls
  expect close if wolfssl
  expect close if libressl
}

plzn tls "server/tls13-implausible-handshake-length/client-hello-after-hrr" {
  syntax 1.0
  rfc 8446 section 4
  chain: [ecdsa_p256]
  uut server {
    versions: [tls13]
    curves: [secp256r1]
  }
  peer { capabilities: [x25519, secp256r1, hrr] }
  xfail gnutls "parses any handshake length and checks its size limit only once the whole message has arrived (CHECK_SIZE in lib/handshake.c), so it waits for the announced 16 MiB"
  flow handshake until send ClientHello {
    send ClientHello { +ext key_share = [x25519] }
    recv HelloRetryRequest { key_share_group: secp256r1 }
    send ClientHello @ set[handshake.length, 0..2] = 0xff, @ fragment 4 hold_all
    wait 300 ms
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/handshake_failure if botan
  expect alert fatal/internal_error if go
  expect close if rustls
  expect close if wolfssl
  expect close if libressl
}

plzn tls "server/tls13-implausible-handshake-length/certificate" {
  syntax 1.0
  rfc 8446 section 4
  chain: [ecdsa_p256]
  uut server {
    versions: [tls13]
    require_client_cert: true
  }
  xfail gnutls "parses any handshake length and checks its size limit only once the whole message has arrived (CHECK_SIZE in lib/handshake.c), so it waits for the announced 16 MiB"
  flow handshake until send Certificate {
    send Certificate @ set[handshake.length, 0..2] = 0xff, @ fragment 4 hold_all
    wait 300 ms
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/handshake_failure if botan
  expect alert fatal/internal_error if go
  expect close if rustls
  expect close if wolfssl
  expect close if libressl
}

