plzn tls "server/tls13-implausible-handshake-length/finished" {
  syntax 1.0
  rfc 8446 section 4
  chain: [ecdsa_p256]
  uut server { versions: [tls13] }
  xfail gnutls "parses any handshake length and checks its size limit only once the whole message has arrived (CHECK_SIZE in lib/handshake.c), so it waits for the announced 16 MiB"
  flow handshake until send Finished {
    send Finished @ set[handshake.length, 0..2] = 0xff, @ fragment 4 hold_all
    wait 300 ms
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/handshake_failure if botan
  expect alert fatal/internal_error if go
  expect close if rustls
  expect close if wolfssl
  expect close if libressl
