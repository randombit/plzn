plzn tls "server/tls13-ecdhe-brainpool-curves/right-0-padded" {
  rfc 8734 section 2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [0x001f, 0x0020]
  }
  flow handshake {
    send ClientHello { key_share_point: padded }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls13-ecdhe-brainpool-curves/right-truncated" {
  rfc 8734 section 2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [0x001f, 0x0020]
  }
  flow handshake {
    send ClientHello { key_share_point: truncated }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls13-ecdhe-brainpool-curves/point-at-infinity" {
  rfc 8734 section 2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [0x001f, 0x0020]
  }
  flow handshake {
    send ClientHello { key_share_point: [0x00] }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls13-ecdhe-brainpool-curves/point-outside-curve" {
  rfc 8734 section 2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [0x001f, 0x0020]
  }
  flow handshake {
    send ClientHello @ xor[handshake.key_share, -1] = 0x01
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls13-ecdhe-brainpool-curves/x-and-y-zero" {
  rfc 8734 section 2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [0x001f, 0x0020]
  }
  flow handshake {
    send ClientHello { key_share_point: zero }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls13-ecdhe-brainpool-curves/share-from-other-curve-256" {
  rfc 8734 section 2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [brainpoolP256r1tls13] }
  flow handshake {
    send ClientHello { key_share_point: brainpoolP384r1tls13 }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls13-ecdhe-brainpool-curves/share-from-other-curve-384" {
  rfc 8734 section 2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [brainpoolP384r1tls13] }
  flow handshake {
    send ClientHello { key_share_point: brainpoolP256r1tls13 }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls13-ecdhe-brainpool-curves/tls12-codepoint-in-tls13" {
  rfc 8734 section 2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [secp256r1] }
  flow handshake {
    send ClientHello {
      +ext supported_groups = [brainpoolP256r1]
      +ext key_share = raw "0000"
    }
    recv ServerHello
  }
  expect alert fatal/{handshake_failure, illegal_parameter}
}
