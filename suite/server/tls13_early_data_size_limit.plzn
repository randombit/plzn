plzn tls "server/tls13-early-data-exceeds-ticket-limit" {
  rfc 8446 section 4.2.10
  chain: [default]
  uut server {
    versions: [tls13]
    session_tickets: 1
    max_early_data: 16
  }
  xfail gnutls "detects the excess early data but sends unexpected_message under the handshake write key after Server Finished, where TLS 1.3 requires the application write key"

  session initial {
    flow handshake {
      recv NewSessionTicket { has_ext: early_data }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow {
      send ClientHello
      send EarlyData { size: 17 }
      recv ServerHello { has_ext: pre_shared_key }
      recv EncryptedExtensions { has_ext: early_data }
      recv Finished
      send EndOfEarlyData
      send Finished
    }
    expect alert fatal/unexpected_message
  }
}
