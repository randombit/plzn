plzn tls "server/tls12-invalid-client-hello/extensions-length-low-byte-fuzz" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  matrix { i in [0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80] }
  flow handshake until send ClientHello {
    send ClientHello @ xor[handshake.extensions_length, 1] = $i
    recv ServerHello
  }
  expect alert fatal/decode_error
}
