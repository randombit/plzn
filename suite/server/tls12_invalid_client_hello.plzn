  chain: [default]
  uut server {
    versions: [tls12]
  }
  matrix { i in [0x01, 0x03, 0x05, 0x7f, 0xff] }
  flow handshake until send ClientHello {
    send ClientHello @ set[handshake.cipher_suites_length, 1] = $i
    recv ServerHello
  }
  expect alert fatal/decode_error
}

