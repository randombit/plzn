plzn tls "server/tls13-mandatory-client-message-omissions/client-hello" {
  rfc 8446 section 4.1.2
  chain: [default]
  uut server { versions: [tls13] }
  flow {
    send raw "160303000402000000"
    recv AppData
  }
  expect alert fatal/{unexpected_message, decode_error}
}

plzn tls "server/tls13-mandatory-client-message-omissions/certificate-after-certificate-request" {
  rfc 8446 section 4.4.2
  chain: [default]
  client_chain: [rsa_2048]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake until send Certificate {
    send Finished
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decode_error if gnutls
}

plzn tls "server/tls13-application-data-before-required-client-authentication" {
  rfc 8446 section 4.4.4
  chain: [default]
  client_chain: [rsa_2048]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake until send Certificate {
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
}

plzn tls "server/tls13-mandatory-client-message-omissions/certificate-verify-after-client-certificate" {
  rfc 8446 section 4.4.3
  chain: [default]
  client_chain: [rsa_2048]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake until send CertificateVerify {
    send Finished
    recv AppData
  }
  expect alert fatal/unexpected_message
}

plzn tls "server/tls13-mandatory-client-message-omissions/finished" {
  rfc 8446 section 4.4.4
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send Finished {
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
}
