plzn tls "server/tls12-chacha20-bad-tag" {
  rfc 5246 section 6.2.3
  uut server { versions: [tls12] }
  chain: [rsa_2048]
  matrix {
    suite in [ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256]
  }
  flow handshake {
    recv ServerHello { cipher_suite: $suite }
    send AppData { size: 18 } @ xor[record.aead_tag, 0] = 0x01
    recv AppData
  }
  expect alert fatal/bad_record_mac
}
