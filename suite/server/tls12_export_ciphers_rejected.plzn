plzn tls "server/tls12-export-ciphers-rejected/export-with-aes-picks-aes" {
  rfc 7465 section 2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  matrix {
    export in [0x0003, 0x0006, 0x0008, 0x000b, 0x000e, 0x0011, 0x0014, 0x0017, 0x0019, 0x0026, 0x0027, 0x0028, 0x0029, 0x002a, 0x002b, 0x0060, 0x0061, 0x0062, 0x0064]
  }
  flow handshake {
    send ClientHello { cipher_suites: [$export, RSA_WITH_AES_128_CBC_SHA] }
    recv ServerHello { cipher_suite: RSA_WITH_AES_128_CBC_SHA }
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-export-ciphers-rejected/export-only" {
  rfc 5246 section 7.4.1.2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  matrix {
    export in [0x0003, 0x0006, 0x0008, 0x000b, 0x000e, 0x0011, 0x0014, 0x0017, 0x0019, 0x0026, 0x0027, 0x0028, 0x0029, 0x002a, 0x002b, 0x0060, 0x0061, 0x0062, 0x0064]
  }
  flow handshake {
    send ClientHello { cipher_suites: [$export] }
    recv ServerHello
  }
  expect alert fatal/{handshake_failure,insufficient_security}
}
