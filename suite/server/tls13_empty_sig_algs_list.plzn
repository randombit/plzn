plzn tls "server/tls13-empty-sig-algs-list" {
  rfc 8446 section 4.2.3
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = raw "0000"
    }
  }
  expect alert fatal/decode_error
  expect alert fatal/handshake_failure if libressl
}
