plzn tls "server/tls13-record-layer-limits/max-size-payload-in-app-data" {
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix { suite in cipher_suites(tls13) }
  flow handshake {
    send record 23 raw 0x41 * 16384
    recv AppData { size: 16384 }
    close alert warning/close_notify
  }
  expect ok
}

plzn tls "server/tls13-record-layer-limits/too-big-payload-in-app-data" {
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix { suite in cipher_suites(tls13) }
  flow handshake {
    send record 23 raw 0x41 * 16385
    recv AppData
  }
  expect alert fatal/record_overflow
}

plzn tls "server/tls13-record-layer-limits/too-big-plaintext-with-padding" {
  rfc 8446 section 5.2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix { suite in cipher_suites(tls13) }
  flow handshake {
    send record 23 raw 0x41 * 16376 @ record_pad 9
    recv AppData
  }
  expect alert fatal/record_overflow
  # OpenSSL enforces the ciphertext bound, not the tighter TLSInnerPlaintext bound.
  expect ok if openssl
}

plzn tls "server/tls13-record-layer-limits/max-size-finished-with-left-padding" {
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  flow handshake until send Finished {
    send Finished { verify_data: 0x00 * 16380 }
    recv NewSessionTicket
  }
  expect alert fatal/{decrypt_error,decode_error}
  expect alert fatal/illegal_parameter if openssl
}

plzn tls "server/tls13-record-layer-limits/too-big-finished-with-left-padding" {
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  flow handshake until send Finished {
    send Finished { verify_data: 0x00 * 16381 }
    recv NewSessionTicket
  }
  expect alert fatal/record_overflow
}

plzn tls "server/tls13-record-layer-limits/max-size-finished-with-record-padding" {
  rfc 8446 section 5.2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [aes128_gcm_sha256] }
  flow handshake until send Finished {
    send Finished @ record_pad 16587
    send AppData
    recv AppData
    close alert warning/close_notify
  }
  expect alert fatal/record_overflow
  expect ok if openssl
}

plzn tls "server/tls13-record-layer-limits/too-big-finished-with-record-padding" {
  rfc 8446 section 5.2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [aes128_gcm_sha256] }
  flow handshake until send Finished {
    send Finished @ record_pad 16588
    recv NewSessionTicket
  }
  expect alert fatal/record_overflow
}

plzn tls "server/tls13-record-layer-limits/max-size-client-hello" {
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  flow handshake until send ClientHello {
    # Tracks the encoded default ClientHello so the resulting record is exactly 2^14 bytes.
    send ClientHello { +ext padding = 16226 }
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData
    recv AppData
    close alert warning/close_notify
  }
  expect ok
}

plzn tls "server/tls13-record-layer-limits/too-big-client-hello" {
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  xfail rustls "does not enforce the 2^14 record limit"
  flow handshake until send ClientHello {
    send ClientHello { +ext padding = 16233 }
    recv ServerHello
  }
  expect alert fatal/record_overflow
}
