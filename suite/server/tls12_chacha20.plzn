plzn tls "server/tls12-chacha20/suite-in-tls-1-1" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut server { versions: [tls12] }
  matrix {
    suite in [0xcca8, 0xccaa]
  }
  flow handshake {
    send ClientHello { legacy_version: 0x0302 }
    recv ServerHello
  }
  expect alert fatal/{handshake_failure,protocol_version,insufficient_security}
}

plzn tls "server/tls12-chacha20/empty-app-data" {
  rfc 5246 section 6.2.1
  uut server { versions: [tls12] }
  chain: [rsa_2048]
  matrix {
    suite in [0xcca8, 0xccaa]
  }
  flow handshake {
    send empty_record application_data
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-chacha20/empty-app-data-with-app-data" {
  rfc 5246 section 6.2.1
  uut server { versions: [tls12] }
  chain: [rsa_2048]
  matrix {
    suite in [0xcca8, 0xccaa]
  }
  flow handshake {
    send empty_record application_data
    send AppData
    recv AppData
    send empty_record application_data
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-chacha20/maximum-size-app-data" {
  rfc 5246 section 6.2.1
  uut server { versions: [tls12] }
  chain: [rsa_2048]
  matrix {
    suite in [0xcca8, 0xccaa]
  }
  flow handshake {
    send AppData { size: 16384 }
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-chacha20/too-big-app-data" {
  rfc 5246 section 6.2.1
  uut server { versions: [tls12] }
  chain: [rsa_2048]
  matrix {
    suite in [0xcca8, 0xccaa]
  }
  flow handshake {
    send AppData { size: 16385 }
    recv AppData
  }
  expect alert fatal/{record_overflow,decompression_failure}
}

plzn tls "server/tls12-chacha20/corrupted-tag-app-data" {
  rfc 5246 section 6.2.3.3
  uut server { versions: [tls12] }
  chain: [rsa_2048]
  matrix {
    suite in [0xcca8, 0xccaa]
    pos in [-16, -9, -8, -1]
    val in [0x01, 0x80]
  }
  flow handshake {
    send AppData { size: 18 } @ xor[record.aead_tag, $pos] = $val
    recv AppData
  }
  expect alert fatal/bad_record_mac
}

plzn tls "server/tls12-chacha20/0-byte-ciphertext-record" {
  rfc 5246 section 6.2.3.3
  uut server { versions: [tls12] }
  chain: [rsa_2048]
  matrix {
    suite in [0xcca8, 0xccaa]
  }
  flow handshake {
    send raw "1703030000"
    recv AppData
  }
  expect alert fatal/{bad_record_mac,decode_error,decrypt_error}
}

plzn tls "server/tls12-chacha20/1-byte-ciphertext-record" {
  rfc 5246 section 6.2.3.3
  uut server { versions: [tls12] }
  chain: [rsa_2048]
  matrix {
    suite in [0xcca8, 0xccaa]
  }
  flow handshake {
    send raw "1703030001aa"
    recv AppData
  }
  expect alert fatal/{bad_record_mac,decode_error,decrypt_error}
}

