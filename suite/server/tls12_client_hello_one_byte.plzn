plzn tls "server/tls12-client-hello-one-byte" {
  syntax 1.0
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut server { versions: [tls12] }
  flow {
    send raw "16030300050100000100"
    wait 300 ms
  }
  expect alert fatal/decode_error
  expect close if libressl
  # OpenSSL 4 (ECH enabled) scans the ClientHello for its ECH offsets before
  # parsing it; on a one-byte body ossl_ech_get_ch_offsets fails with
  # illegal_parameter (BAD_EXTENSION), ahead of the decode_error the parser
  # would give.
  expect alert fatal/illegal_parameter if openssl
}
