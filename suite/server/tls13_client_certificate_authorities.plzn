plzn tls "server/tls13-client-certificate-authorities" {
  syntax 1.0
  rfc 8446 section 4.2.4
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext certificate_authorities = raw "000400023000" }
    send AppData
    recv AppData
    close
  }
  expect ok
}
