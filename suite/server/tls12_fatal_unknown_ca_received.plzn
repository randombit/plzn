plzn tls "server/tls12-fatal-unknown-ca-received" {
  rfc 5246 section 7.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake after send ClientHello {
    send raw "15030300020230"
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    wait 300 ms
  }
  expect close
}
