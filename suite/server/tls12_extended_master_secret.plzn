plzn tls "server/tls12-extended-master-secret" {
  rfc 7627 section 5.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake {
    recv ServerHello {
      has_ext: extended_master_secret
    }
    send AppData
    recv AppData
    close
  }
  expect ok
  skip libressl "does not implement extended_master_secret"
}
