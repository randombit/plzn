# LibreSSL's TLS 1.2 server answers any failed CertificateVerify signature with
# internal_error (its TLS 1.3 server and TLS 1.2 client send decrypt_error), so the
# internal_error pins below are that alert choice, not an internal failure.

plzn tls "server/tls12-certificate-verify/valid-handshake" {
  rfc 5246 section 7.4.8
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pkcs1_sha224, rsa_pkcs1_sha1, rsa_pkcs1_md5] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa }
    send ClientKeyExchange
    send CertificateVerify { sign_with: rsa_pkcs1_sha256 }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-certificate-verify/md5-forced" {
  rfc 5246 section 7.4.8
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pkcs1_sha224, rsa_pkcs1_sha1, rsa_pkcs1_md5] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa }
    send ClientKeyExchange
    send CertificateVerify { sign_with: rsa_pkcs1_md5 }
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}

plzn tls "server/tls12-certificate-verify/md5-forced-in-hashinfo" {
  rfc 5246 section 7.4.8
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pkcs1_sha224, rsa_pkcs1_sha1, rsa_pkcs1_md5] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa }
    send ClientKeyExchange
    send CertificateVerify { sign_with: rsa_pkcs1_md5, algorithm: rsa_pkcs1_sha256 }
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/decrypt_error
  expect alert fatal/internal_error if libressl
}

plzn tls "server/tls12-certificate-verify/tls11-signature-in-tls12" {
  rfc 5246 section 7.4.8
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pkcs1_sha224, rsa_pkcs1_sha1, rsa_pkcs1_md5] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa }
    send ClientKeyExchange
    send CertificateVerify { sign_with: rsa_pkcs1_sha256, format: tls11 }
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/{decode_error,illegal_parameter}
  expect close if libressl
}
