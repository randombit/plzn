plzn tls "server/tls12-sig-algs/empty-sigalgs" {
  rfc 5246 section 7.4.1.4.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = raw "0000"
      +ext supported_groups = [secp256r1, x25519, secp384r1, secp521r1]
    }
  }
  expect alert fatal/decode_error
  xfail libressl "treats an empty signature_algorithms extension as absent and signs with the SHA-1 default"
}

