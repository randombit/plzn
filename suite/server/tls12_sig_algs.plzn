plzn tls "server/tls12-sig-algs/valid-handshake" {
  rfc 5246 section 7.4.1.4.1
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_rsa] }
  chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512, rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512, rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pkcs1_sha224, rsa_pkcs1_sha1]
      +ext supported_groups = [secp256r1, x25519, secp384r1, secp521r1]
    }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

