plzn tls "server/tls12-sig-algs/rsa_pss_pss_sha256-only" {
  rfc 5246 section 7.4.1.4.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_pss_sha256]
      +ext supported_groups = [secp256r1, x25519, secp384r1, secp521r1]
    }
  }
  expect alert fatal/handshake_failure
  expect alert fatal/decode_error if libressl
}

