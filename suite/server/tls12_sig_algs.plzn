  }
  peer { capabilities: [ecdhe_rsa] }
  chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256]
      +ext supported_groups = [secp256r1, x25519, secp384r1, secp521r1]
    }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange { signature_scheme: rsa_pss_rsae_sha256 }
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

