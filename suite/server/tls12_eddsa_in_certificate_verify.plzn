plzn tls "server/tls12-eddsa-in-certificate-verify/corrupted-signature" {
  rfc 8422 section 5.10
  skip botan "no Ed25519 TLS signature scheme"
  # handshake.signature includes a two-byte length; offsets from 2 address the Ed25519 signature.
  matrix {
    pos in [2, 3, 33, 34, 65]
    v in [0x01, 0x80]
  }
  chain: [default]
  uut server {
    versions: [tls12], require_client_cert: true
  }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384, ecdsa_secp521r1_sha512, rsa_pss_rsae_sha256, rsa_pkcs1_sha256, ed25519, ed448] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: ed25519 }
    send ClientKeyExchange
    send CertificateVerify { } @ xor[handshake.signature, $pos] = $v
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/decrypt_error
  expect alert fatal/illegal_parameter if boringssl
  expect close if libressl
}
