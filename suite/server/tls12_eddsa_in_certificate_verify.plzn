plzn tls "server/tls12-eddsa-in-certificate-verify/valid-handshake" {
  rfc 8422 section 5.10
  skip botan "no Ed25519 TLS signature scheme"
  chain: [default]
  uut server {
    versions: [tls12], require_client_cert: true
    verify_prefs: [ed25519]
  }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384, ecdsa_secp521r1_sha512, rsa_pss_rsae_sha256, rsa_pkcs1_sha256, ed25519, ed448] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: ed25519 }
    send ClientKeyExchange
    send CertificateVerify { }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-eddsa-in-certificate-verify/md5-ecdsa-forced" {
  rfc 8422 section 5.10
  skip botan "no Ed25519 TLS signature scheme"
  chain: [default]
  uut server {
    versions: [tls12], require_client_cert: true
  }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384, ecdsa_secp521r1_sha512, rsa_pss_rsae_sha256, rsa_pkcs1_sha256, ed25519, ed448] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: ed25519 }
    send ClientKeyExchange
    send CertificateVerify { sign_with: ed25519, algorithm: ecdsa_md5 }
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/illegal_parameter
  expect close if libressl
}

