# A TLS 1.2 server (stream transport) receiving a ClientHello whose version
# fields claim DTLS. DTLS wire versions are {254, x}: DTLS 1.0 = 0xfeff,
# DTLS 1.2 = 0xfefd, DTLS 1.3 = 0xfefc. Numerically they are all higher than
# any TLS version, so RFC 5246 E.1 version tolerance negotiates the server's
# highest version when they appear in legacy_version; in supported_versions
# they are unknown versions a server MUST ignore (RFC 8446 4.2.1).
#
# Botan parses a ClientHello whose legacy_version has major 0xfe in the DTLS
# format (a cookie field after the session id), so the TLS-format body fails
# to decode and it answers decode_error.

plzn tls "server/tls12-clienthello-dtls-legacy-version" {
  rfc 5246 section E.1
  chain: [default]
  uut server { versions: [tls12] }
  matrix {
    legacy_version in [0xfeff, 0xfefd, 0xfefc]
  }
  flow handshake {
    send ClientHello { legacy_version: $legacy_version }
    recv ServerHello { legacy_version: 0x0303 }
    send AppData
    recv AppData
    close
  }
  expect ok
  expect alert fatal/decode_error if botan
}

plzn tls "server/tls12-clienthello-supported-versions-dtls-only" {
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls12] }
  matrix {
    version in [0xfeff, dtls12, dtls13]
  }
  flow handshake until send ClientHello {
    send ClientHello { +ext supported_versions = [$version] }
  }
  expect alert fatal/protocol_version
}

plzn tls "server/tls12-clienthello-supported-versions-dtls13-and-dtls12" {
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientHello {
    send ClientHello { +ext supported_versions = [dtls13, dtls12] }
  }
  expect alert fatal/protocol_version
}

plzn tls "server/tls12-clienthello-supported-versions-dtls-then-tls12" {
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake {
    send ClientHello { +ext supported_versions = [dtls13, dtls12, tls12] }
    recv ServerHello { legacy_version: 0x0303, lacks_ext: supported_versions }
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-clienthello-supported-versions-tls12-then-dtls" {
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake {
    send ClientHello { +ext supported_versions = [tls12, dtls12, dtls13] }
    recv ServerHello { legacy_version: 0x0303, lacks_ext: supported_versions }
    send AppData
    recv AppData
    close
  }
  expect ok
}

# RFC 8446 4.2.1: with supported_versions present the server MUST NOT use
# legacy_version for negotiation, so the DTLS legacy_version is noise.
plzn tls "server/tls12-clienthello-dtls-legacy-version-with-supported-versions-tls12" {
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake {
    send ClientHello {
      legacy_version: 0xfefd
      +ext supported_versions = [tls12]
    }
    recv ServerHello { legacy_version: 0x0303 }
    send AppData
    recv AppData
    close
  }
  expect ok
  expect alert fatal/decode_error if botan
}

# Every version field says DTLS 1.2; nothing offered is a TLS version.
plzn tls "server/tls12-clienthello-dtls-legacy-version-with-supported-versions-dtls12" {
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientHello {
    send ClientHello {
      legacy_version: 0xfefd
      +ext supported_versions = [dtls12]
    }
  }
  expect alert fatal/protocol_version
  expect alert fatal/decode_error if botan
}

# The record header of the ClientHello claims DTLS 1.2. RFC 5246 E.1 only
# obliges a server to accept {3, x} on the initial record. Botan, OpenSSL and
# Go treat a {254, x} first record as "not TLS" and hang up without an alert
# (Botan has no record state yet to send one under).
plzn tls "server/tls12-clienthello-dtls-record-version" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server { versions: [tls12] }
  # rustls 0.23's record reader intends to accept only 0x03XX, but its guard
  # covers unknown code points only and the DTLS versions are known
  # ProtocolVersion variants; the handshake completes. rustls main (commit
  # 1509dfc8, 2026-03-08) checks the raw value and rejects it.
  xfail rustls "accepts the DTLS 1.2 wire version in the record header of the ClientHello"
  flow handshake {
    send ClientHello @ record_version 0xfefd
  }
  expect close
  expect alert fatal/protocol_version if libressl
}

# Record header, legacy_version and supported_versions all claim DTLS 1.2:
# a DTLS ClientHello body under a 5-byte TLS record header on a stream.
# rustls accepts the record (see above) and then refuses the version offer.
plzn tls "server/tls12-clienthello-dtls-at-every-layer" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake {
    send ClientHello {
      legacy_version: 0xfefd
      +ext supported_versions = [dtls12]
    } @ record_version 0xfefd
  }
  expect close
  expect alert fatal/protocol_version if libressl
  expect alert fatal/protocol_version if rustls
}

# A server with both TLS 1.2 and 1.3 enabled. The extension is present and
# lists only DTLS versions, so the server MUST NOT fall back to the
# legacy_version (0x0303) it would otherwise have accepted.
plzn tls "server/tls12-13-clienthello-supported-versions-dtls-only-no-legacy-fallback" {
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls12, tls13] }
  flow handshake until send ClientHello {
    send ClientHello { +ext supported_versions = [dtls13, dtls12] }
  }
  expect alert fatal/protocol_version
}

# LibreSSL decides "is this a TLS 1.3 ClientHello" from the numerically
# highest supported_versions entry, so 0xfefc routes this TLS 1.2 hello to its
# TLS 1.3 server, which then demands key_share and friends. See also the
# unknown-high row in tls13_supported_versions_forward_compat.plzn.
plzn tls "server/tls12-13-clienthello-supported-versions-dtls13-then-tls12" {
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls12, tls13] }
  xfail libressl "treats a ClientHello as TLS 1.3 because its supported_versions lists 0xfefc, then rejects the TLS 1.2 hello with missing_extension"
  flow handshake {
    send ClientHello { +ext supported_versions = [dtls13, tls12] }
    recv ServerHello { legacy_version: 0x0303, lacks_ext: supported_versions }
    send AppData
    recv AppData
    close
  }
  expect ok
}
