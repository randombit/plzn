plzn tls "server/tls12-warning-alert-flood/application-data-over-thirty-two" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut server { versions: [tls12] }
  matrix {
    count in [33, 100]
  }
  flow handshake {
    repeat $count { send alert warning/user_canceled }
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/unexpected_message if openssl
  expect alert fatal/unexpected_message if boringssl
  expect close if rustls
  expect close if wolfssl
  expect alert fatal/unexpected_message if go
  expect alert fatal/unexpected_message if botan
}

# Each burst is four warnings followed by an application-data exchange.
# A consecutive counter (OpenSSL, BoringSSL, Go) is reset by the data and
# tolerates every burst; a lifetime budget (rustls, wolfSSL) is not, so the
# second burst's fifth warning trips it.
plzn tls "server/tls12-warning-alert-flood/interleaved-with-application-data-one-burst" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut server { versions: [tls12] }
  matrix {
    count in [1]
  }
  flow handshake {
    repeat $count {
      repeat 4 { send alert warning/user_canceled }
      send AppData
      recv AppData
    }
  }
  expect ok
}

plzn tls "server/tls12-warning-alert-flood/interleaved-with-application-data-two-or-more-bursts" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut server { versions: [tls12] }
  matrix {
    count in [2, 3, 5]
  }
  flow handshake {
    repeat $count {
      repeat 4 { send alert warning/user_canceled }
      send AppData
      recv AppData
    }
  }
  expect ok
  expect close if rustls
  expect close if wolfssl
}
