plzn tls "server/tls12-warning-unknown-ca-tolerated" {
  rfc 5246 section 7.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake after send ClientHello {
    send raw "15030300020130"
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect ok
}
