plzn tls "server/tls13-shuffled-extensions/hrr-reversed-order-of-known-extensions" {
  rfc 8446 section 4.1.2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [secp256r1] }
  flow handshake until send ClientHello {
    send ClientHello { +ext key_share = raw "0000" }
    recv HelloRetryRequest { key_share_group: secp256r1, has_ext: key_share }
    send ClientHello { reverse_extensions }
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData
    recv AppData
    close alert warning/close_notify
  }
  expect ok
  expect alert fatal/illegal_parameter if libressl
}

plzn tls "server/tls13-shuffled-extensions/hrr-retry-with-added-padding" {
  rfc 8446 section 4.1.2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [secp256r1] }
  flow handshake until send ClientHello {
    send ClientHello { +ext key_share = raw "0000" }
    recv HelloRetryRequest { key_share_group: secp256r1 }
    send ClientHello { +ext padding = 100 }
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData
    recv AppData
    close alert warning/close_notify
  }
  expect ok
}
