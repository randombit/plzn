plzn tls "server/tls12-empty-finished" {
  rfc 5246 section 7.4.9
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send Finished @ truncate 0
  }
  expect alert fatal/decrypt_error
  expect alert fatal/decode_error if openssl
  expect alert fatal/decode_error if libressl
}
