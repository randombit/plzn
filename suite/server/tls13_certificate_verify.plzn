plzn tls "server/tls13-certificate-verify/corrupted-rsa-encoded-message" {
  rfc 8446 section 4.4.3
  matrix {
    pos in [0, 1, 100, 223, 224, 254, 255]
    v in [0x01, 0x80]
  }
  uut server { versions: [tls13], require_client_cert: true }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256, rsa_pss_pss_sha256, rsa_pss_rsae_sha384, rsa_pss_pss_sha384] }
    recv ServerHello
    recv EncryptedExtensions
    recv CertificateRequest
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Certificate { credential: rsa }
    send CertificateVerify { sign_with: rsa_pss_rsae_sha256 } @ xor[signature.em, $pos] = $v
    send Finished
  }
  expect alert fatal/decrypt_error
}

plzn tls "server/tls13-certificate-verify/id-rsassa-pss-client-key" {
  rfc 8446 section 4.4.3
  skip botan "no rsa_pss_pss_* signature schemes: an id-RSASSA-PSS client key cannot be verified"
  skip rustls "ring lists no rsa_pss_pss_* scheme in its CertificateRequest: an id-RSASSA-PSS client key cannot be verified"
  uut server {
    versions: [tls13], require_client_cert: true
    verify_prefs: [rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512]
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256, rsa_pss_pss_sha256, rsa_pss_rsae_sha384, rsa_pss_pss_sha384] }
    recv ServerHello
    recv EncryptedExtensions
    recv CertificateRequest
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Certificate { credential: rsa_pss }
    send CertificateVerify { }
    send Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

