plzn tls "server/tls12-supported-groups-trailing-data" {
  rfc 5246 section 7.4.1.4
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake {
    send ClientHello {
      +ext supported_groups = raw "0002001dff"
    }
  }
  expect alert fatal/decode_error
}
