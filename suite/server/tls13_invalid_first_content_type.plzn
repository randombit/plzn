plzn tls "server/tls13-invalid-first-content-type" {
  rfc 8446 section 5
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello @ set[record.content_type, 0] = 0xff
    send AppData
    recv AppData
    close
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decode_error if rustls
}
