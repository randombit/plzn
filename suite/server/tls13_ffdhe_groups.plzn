plzn tls "server/tls13-ffdhe-groups/duplicated-key-share-entry" {
  rfc 8446 section 4.2.8
  chain: [default]
  uut server {
    versions: [tls13]
    curves: [$group]
  }
  matrix {
    group in [ffdhe2048, ffdhe3072, ffdhe4096, ffdhe6144, ffdhe8192]
  }
  flow handshake {
    send ClientHello { +ext key_share = [$group, $group] }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
  # RFC 8446 4.2.8: servers MAY check for this violation.
  expect ok if openssl
  expect ok if gnutls
}

plzn tls "server/tls13-ffdhe-groups/right-0-padded" {
  rfc 8446 section 4.2.8.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [ffdhe2048, ffdhe3072, ffdhe4096, ffdhe6144, ffdhe8192]
  }
  flow handshake {
    send ClientHello { key_share_point: padded }
    recv ServerHello
  }
  expect alert fatal/{illegal_parameter,handshake_failure}
  expect close if wolfssl
}

