plzn tls "server/tls12-mandatory-client-message-omissions/client-hello" {
  rfc 5246 section 7.4
  chain: [default]
  uut server { versions: [tls12] }
  flow {
    send raw "160303010610000102" + 0xff * 258
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect close if wolfssl
}

plzn tls "server/tls12-mandatory-client-message-omissions/certificate-after-certificate-request" {
  rfc 5246 section 7.4.6
  chain: [default]
  client_chain: [rsa_2048]
  uut server { versions: [tls12], require_client_cert: true }
  flow handshake until send Certificate {
    send ClientKeyExchange
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect close if wolfssl
  expect alert fatal/handshake_failure if libressl
}

plzn tls "server/tls12-mandatory-client-message-omissions/client-key-exchange" {
  rfc 5246 section 7.4.7
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientKeyExchange {
    send ChangeCipherSpec
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect close if wolfssl
}

plzn tls "server/tls12-mandatory-client-message-omissions/certificate-verify-after-client-certificate" {
  rfc 5246 section 7.4.8
  chain: [default]
  client_chain: [rsa_2048]
  uut server { versions: [tls12], require_client_cert: true }
  flow handshake until send CertificateVerify {
    send ChangeCipherSpec
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect close if wolfssl
  xfail libressl "waits instead of rejecting a ChangeCipherSpec that skips the required CertificateVerify"
}

plzn tls "server/tls12-mandatory-client-message-omissions/change-cipher-spec" {
  rfc 5246 section 7.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ChangeCipherSpec {
    send Finished
    recv AppData
  }
  expect alert fatal/unexpected_message
}

plzn tls "server/tls12-mandatory-client-message-omissions/finished" {
  rfc 5246 section 7.4.9
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send Finished {
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
}
