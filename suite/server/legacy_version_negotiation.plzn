plzn tls "server/static-rsa-premaster-uses-clienthello-version" {
  rfc 5246 section 7.4.7.1
  chain: [rsa_2048]
  matrix { version in [tls10, tls11] }
  uut server {
    versions: [$version]
    cipher_suites: [RSA_WITH_AES_128_CBC_SHA]
  }
  peer { capabilities: [rsa, aes128_cbc_sha] }
  flow handshake {
    send ClientHello { legacy_version: tls12 }
    recv ServerHello { legacy_version: $version }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-capable-client-negotiates-tls10" {
  rfc 8446 section 4.2.1
  chain: [rsa_2048]
  uut server {
    versions: [tls10, tls12, tls13]
    cipher_suites: [RSA_WITH_AES_128_CBC_SHA]
  }
  peer { capabilities: [rsa, aes128_cbc_sha] }
  flow handshake {
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls12-client-negotiates-tls10" {
  rfc 5246 section 7.4.1.2
  chain: [rsa_2048]
  uut server {
    versions: [tls10, tls12]
    cipher_suites: [RSA_WITH_AES_128_CBC_SHA]
  }
  peer { capabilities: [rsa, aes128_cbc_sha] }
  flow handshake {
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls11-downgrade-sentinel" {
  rfc 8446 section 4.1.3
  chain: [rsa_2048]
  uut server {
    versions: [tls11, tls13]
    cipher_suites: [RSA_WITH_AES_128_CBC_SHA]
  }
  peer { capabilities: [rsa, aes128_cbc_sha] }
  flow handshake until send ClientHello {
    send ClientHello
    recv ServerHello {
      legacy_version: tls11
      random_suffix: [0x44, 0x4f, 0x57, 0x4e, 0x47, 0x52, 0x44, 0x00]
    }
  }
  expect ok
}
