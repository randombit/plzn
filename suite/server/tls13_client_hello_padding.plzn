plzn tls "server/tls13-client-hello-padding" {
  rfc 7685 section 3
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello {
      +ext padding = 300
    }
    recv ServerHello { lacks_ext: padding }
    send AppData
    recv AppData
    close
  }
  expect ok
}
