plzn tls "server/tls12-cke-fragment-interleaved-empty-app-data" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake until send ClientKeyExchange {
    send ClientKeyExchange @ fragment 16 hold
    send empty_record application_data
    flush_fragment
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect alert fatal/{unexpected_message, decode_error}
  expect close if rustls
  xfail libressl "accepts an empty application-data record interleaved with a fragmented ClientKeyExchange"
}
