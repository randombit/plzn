plzn tls "server/tls12-user-canceled-warning-during-handshake" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake after send ClientHello {
    send alert warning/user_canceled
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect ok
}
