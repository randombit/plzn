plzn tls "server/tls12-hello-request-by-client/during-handshake" {
  rfc 5246 section 7.4.1.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake until send ClientKeyExchange {
    send record 22 raw "00000000"
    recv ChangeCipherSpec
  }
  expect alert fatal/unexpected_message
}

plzn tls "server/tls12-hello-request-by-client/after-handshake" {
  rfc 5246 section 7.4.1.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send record 22 raw "00000000"
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/no_renegotiation if boringssl
}
