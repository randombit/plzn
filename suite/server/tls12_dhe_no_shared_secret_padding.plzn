plzn tls "server/tls12-dhe-no-shared-secret-padding/premaster-with-leading-zero-byte" {
  rfc 5246 section 8.1.2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [dhe_rsa] }
  flow handshake {
    send ClientKeyExchange { shared_secret_leading_zeros: 1 }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}
