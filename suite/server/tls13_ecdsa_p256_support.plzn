plzn tls "server/tls13-ecdsa-support/ecdsa_secp256r1_sha256" {
  rfc 8446 section 4.2.3
  chain: [ecdsa_p256]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp256r1_sha256] }
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls13-ecdsa-support/ecdsa_sha1" {
  rfc 8446 section 4.2.3
  chain: [ecdsa_p256]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_sha1] }
  }
  expect alert fatal/handshake_failure
}

