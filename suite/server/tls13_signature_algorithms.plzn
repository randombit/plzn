plzn tls "server/tls13-signature-algorithms/legacy-pkcs1-tolerance" {
  rfc 8446 section 4.2.3
  uut server { versions: [tls13] }
  chain: [rsa_2048]
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [rsa_pkcs1_sha1, rsa_pkcs1_sha256, rsa_pkcs1_sha384, rsa_pkcs1_sha512, rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
    }
    recv ServerHello
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-signature-algorithms/unallocated-first" {
  rfc 8446 section 4.2.3
  uut server { versions: [tls13] }
  chain: [rsa_2048]
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [0x0a01, rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
    }
    recv ServerHello
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-signature-algorithms/duplicated-n-non-rsa" {
  rfc 8446 section 4.2.3
  uut server { versions: [tls13] }
  chain: [rsa_2048]
  matrix { n in [215, 2355, 8132, 23754, 32000] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [dsa_sha1 * $n, rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
    } @ fragment 16384
    recv ServerHello
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/decode_error if libressl
}

plzn tls "server/tls13-signature-algorithms/n-invalid-pkcs1" {
  rfc 8446 section 4.2.3
  uut server { versions: [tls13] }
  chain: [rsa_2048]
  matrix { n in [215, 2355, 8132, 23754, 32000] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [rsa_pkcs1_sha1 * $n, rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
    } @ fragment 16384
    recv ServerHello
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/decode_error if libressl
