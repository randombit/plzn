plzn tls "server/tls13-signature-algorithms/tolerance-n-unknown" {
  rfc 8446 section 4.2.3
  uut server { versions: [tls13] }
  chain: [rsa_2048]
  matrix { n in [215, 2355, 8132, 23754, 32000] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [0x0a00..$n + 0x09ff, rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
    } @ fragment 16384
    recv ServerHello
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/decode_error if libressl
}

plzn tls "server/tls13-signature-algorithms/tolerance-n-unknown-sig-alg-cert" {
  rfc 8446 section 4.2.3
  uut server { versions: [tls13] }
  chain: [rsa_2048]
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
      +ext signature_algorithms_cert = [0x0a00..0x86ff, rsa_pss_rsae_sha256, rsa_pkcs1_sha256]
    } @ fragment 16384
    recv ServerHello
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-signature-algorithms/well-known-rsa-last" {
  rfc 8446 section 4.2.3
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [ecdsa_md5, ecdsa_sha1, ecdsa_sha224, ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384, ecdsa_secp521r1_sha512, 0x0102, dsa_sha1, 0x0302, dsa_sha256, 0x0502, 0x0602, rsa_pkcs1_md5, rsa_pkcs1_sha1, rsa_pkcs1_sha224, rsa_pkcs1_sha256, rsa_pkcs1_sha384, rsa_pkcs1_sha512, ed25519, ed448, rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512, rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512]
    }
    recv ServerHello
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-signature-algorithms/only-undefined" {
  rfc 8446 section 4.2.3
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [0x0a00..0x0a63] }
  }
  expect alert fatal/handshake_failure
  expect alert fatal/decode_error if libressl
}

