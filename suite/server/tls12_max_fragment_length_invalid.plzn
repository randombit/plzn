plzn tls "server/tls12-max-fragment-length-invalid" {
  rfc 6066 section 4
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send ClientHello {
      +ext max_fragment_length = raw "05"
    }
    send AppData
    recv AppData
  }
  expect any { ok, alert fatal/illegal_parameter }
}
