plzn tls "server/tls12-max-handshake-message-size/renegotiation-client-hello-over-limit" {
  syntax 1.1
  rfc 5246 section 7.4
  chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    max_handshake_message_size: 4096
  }
  flow handshake after recv Finished {
    send AppData
    recv AppData
    begin_renegotiation
    send ClientHello @ pad to 4097, @ fragment 4 hold_all
  }
  expect alert fatal/handshake_failure
}

plzn tls "server/tls12-max-handshake-message-size/renegotiation-client-hello-at-limit" {
  syntax 1.1
  rfc 5246 section 7.4
  chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    max_handshake_message_size: 4096
  }
  flow handshake after recv Finished {
    send AppData
    recv AppData
    begin_renegotiation
    send ClientHello @ pad to 4096, @ fragment 4 hold_all
    wait 300 ms
  }
  expect ok
}
