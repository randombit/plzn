plzn tls "server/tls12-max-handshake-message-size/certificate-over-limit" {
  syntax 1.1
  rfc 5246 section 7.4
  chain: [ecdsa_p256]
  uut server {
    versions: [tls12]
    max_handshake_message_size: 4096
    require_client_cert: true
  }
  flow handshake until send Certificate {
    send Certificate @ pad to 4097, @ fragment 4 hold_all
  }
  expect alert fatal/handshake_failure
}

