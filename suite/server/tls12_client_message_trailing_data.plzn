plzn tls "server/tls12-trailing-clienthello" {
  rfc 5246 section 7.4
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake { send ClientHello @ pad +1 }
  expect alert fatal/decode_error
}

plzn tls "server/tls12-trailing-client-certificate" {
  rfc 5246 section 7.4
  chain: [default]
  uut server {
    versions: [tls12]
    require_client_cert: true
  }
  flow handshake { send Certificate @ pad +1 }
  expect alert fatal/decode_error
  expect close if wolfssl
}

plzn tls "server/tls12-trailing-client-certificateverify" {
  rfc 5246 section 7.4
  chain: [default]
  uut server {
    versions: [tls12]
    require_client_cert: true
  }
  flow handshake { send CertificateVerify @ pad +1 }
  expect alert fatal/decode_error
}

plzn tls "server/tls12-trailing-clientkeyexchange" {
  rfc 5246 section 7.4
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake { send ClientKeyExchange @ pad +1 }
  expect alert fatal/{decode_error,illegal_parameter}
}

plzn tls "server/tls12-trailing-client-finished" {
  rfc 5246 section 7.4
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake { send Finished @ pad +1 }
  expect alert fatal/{decode_error,decrypt_error,handshake_failure}
  expect close if wolfssl
}
