      cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, ECDHE_RSA_WITH_AES_128_GCM_SHA256]
      +ext supported_groups = [x25519, secp256r1]
      +ext signature_algorithms = [ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256]
    }
    recv ServerHello { cipher_suite: ECDHE_RSA_WITH_AES_128_GCM_SHA256 }
    recv Certificate { entries: 1, leaf_key: rsa_2048 }
    send AppData
    recv AppData
  }
  expect ok
}
