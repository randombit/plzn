plzn tls "server/tls12-certificate-selection-static-rsa-ignores-sigalgs" {
  rfc 5246 section 7.4.1.4.1
  chain: [ecdsa_p256, rsa_2048]
  xfail openssl "applies signature_algorithms to static-RSA certificate selection"
  uut server {
    versions: [tls12]
    cipher_suites: [RSA_WITH_AES_128_GCM_SHA256]
  }
  flow handshake {
    send ClientHello {
      cipher_suites: [RSA_WITH_AES_128_GCM_SHA256]
      +ext signature_algorithms = [ecdsa_secp256r1_sha256]
    }
    recv ServerHello { cipher_suite: RSA_WITH_AES_128_GCM_SHA256 }
    recv Certificate { entries: 1, leaf_key: rsa_2048 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls12-certificate-selection-no-ecdhe-falls-back-to-rsa" {
  rfc 5246 section 7.4.1.4.1
  chain: [ecdsa_p256, rsa_2048]
  uut server {
    versions: [tls12]
    cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, RSA_WITH_AES_128_GCM_SHA256]
    curves: [secp256r1]
  }
  flow handshake {
    send ClientHello {
      cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, RSA_WITH_AES_128_GCM_SHA256]
      +ext supported_groups = [x25519]
      +ext signature_algorithms = [ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256]
    }
    recv ServerHello { cipher_suite: RSA_WITH_AES_128_GCM_SHA256 }
    recv Certificate { entries: 1, leaf_key: rsa_2048 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls12-certificate-selection-requires-mutually-enabled-suite" {
  rfc 5246 section 7.4.1.4.1
  chain: [ecdsa_p256, rsa_2048]
