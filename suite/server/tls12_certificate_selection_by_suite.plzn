plzn tls "server/tls12-certificate-selection-ecdsa-suite-no-match" {
  rfc 5246 section 7.4.1.4.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
    cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
  }
  flow handshake {
    send ClientHello {
      cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
      +ext supported_groups = [x25519, secp256r1]
      +ext signature_algorithms = [rsa_pss_rsae_sha256, ecdsa_secp256r1_sha256]
    }
    recv ServerHello
  }
  expect alert fatal/{handshake_failure, unsupported_certificate, access_denied}
  expect close if wolfssl
}

