plzn tls "server/tls12-length/client-key-exchange-message" {
  rfc 5246 section 7.4.7
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientKeyExchange {
    send ClientKeyExchange @ sub[handshake.length] = 1
    recv ChangeCipherSpec
  }
  expect alert fatal/{decode_error,unexpected_message,decrypt_error,illegal_parameter}
  expect close if rustls
  expect close if wolfssl
}

plzn tls "server/tls12-length/client-key-exchange-public-key" {
  rfc 8422 section 5.7
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientKeyExchange {
    send ClientKeyExchange @ sub[handshake.ecdh_point_length] = 1
    recv ChangeCipherSpec
  }
  expect alert fatal/{decode_error,illegal_parameter,handshake_failure,internal_error}
  expect close if wolfssl
}

plzn tls "server/tls12-length/client-certificate-message" {
  rfc 5246 section 7.4.6
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server { versions: [tls12], require_client_cert: true }
  flow handshake until send Certificate {
    send Certificate @ sub[handshake.length] = 1
    wait 300 ms
  }
  expect alert fatal/{decode_error,unexpected_message,bad_certificate,certificate_unknown}
  expect close if wolfssl
}

plzn tls "server/tls12-length/client-certificate-list" {
  rfc 5246 section 7.4.2
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server { versions: [tls12], require_client_cert: true }
  flow handshake until send Certificate {
    send Certificate @ sub[handshake.certificate_list_length] = 1
    wait 300 ms
  }
  expect alert fatal/{decode_error,bad_certificate,certificate_unknown}
  expect close if wolfssl
}

