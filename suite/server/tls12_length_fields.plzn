plzn tls "server/tls12-length/renegotiation-info-extension" {
  rfc 5746 section 3.2
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientHello {
    send ClientHello { +ext renegotiation_info = raw "00" } @ sub[handshake.extension_renegotiation_info_length] = 1
    recv ServerHello
  }
  expect alert fatal/decode_error
  expect close if wolfssl
