plzn tls "server/tls12-length/renegotiation-info-vector" {
  rfc 5746 section 3.2
  xfail wolfssl "does not check that renegotiated_connection is empty in an initial ClientHello (this build never parses renegotiation_info; secure-renegotiation builds accept it too)"
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientHello {
    send ClientHello { +ext renegotiation_info = raw "00" } @ add[handshake.extension_renegotiation_info_info_length] = 1
    recv ServerHello
  }
  expect alert fatal/{decode_error,handshake_failure}
}

plzn tls "server/tls12-length/alpn-extension" {
  rfc 7301 section 3.1
  chain: [default]
  uut server { versions: [tls12], alpn_select: "h2" }
  flow handshake until send ClientHello {
    send ClientHello { +ext alpn = raw "0003026832" } @ sub[handshake.extension_alpn_length] = 1
    recv ServerHello
  }
  expect alert fatal/decode_error
}

