plzn tls "server/tls12-length/client-hello-message" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientHello {
    send ClientHello @ sub[handshake.length] = 1
    recv ServerHello
  }
  expect alert fatal/{decode_error,unexpected_message}
}

plzn tls "server/tls12-length/client-hello-session-id" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientHello {
    send ClientHello @ add[handshake.session_id_length] = 1
    recv ServerHello
  }
  expect alert fatal/decode_error
  expect close if wolfssl
  expect close if libressl
}

plzn tls "server/tls12-length/client-hello-cipher-suites" {
