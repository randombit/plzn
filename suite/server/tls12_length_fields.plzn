plzn tls "server/tls12-length/signature-algorithms-extension" {
  rfc 5246 section 7.4.1.4.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ClientHello {
    send ClientHello { +ext signature_algorithms = raw "00020403" } @ sub[handshake.extension_signature_algorithms_length] = 1
    recv ServerHello
  }
  expect alert fatal/decode_error
  expect close if wolfssl
}

plzn tls "server/tls12-length/signature-algorithms-list" {
