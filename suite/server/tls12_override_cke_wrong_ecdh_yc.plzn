plzn tls "server/cke-wrong-ecdh-yc" {
  rfc 5246 section 7.4.7.2
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake {
    # Correctly sized uncompressed P-256 encoding with invalid coordinates.
    send ClientKeyExchange {
      ecdh_Yc: [
        0x04,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
      ]
    }
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}
