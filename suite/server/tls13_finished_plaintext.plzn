plzn tls "server/tls13-finished-plaintext/unencrypted-finished" {
  rfc 8446 section 5
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send Finished {
    send Finished @ plaintext
    recv NewSessionTicket
  }
  expect alert fatal/unexpected_message
  expect alert fatal/bad_record_mac if boringssl
  expect alert fatal/bad_record_mac if rustls
}
