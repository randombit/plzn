plzn tls "server/tls13-supported-versions-trailing-data" {
  syntax 1.0
  rfc 8446 section 4.2.1
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello {
      +ext supported_versions = raw "020304ff"
    }
  }
  expect alert fatal/{decode_error, protocol_version}
}
