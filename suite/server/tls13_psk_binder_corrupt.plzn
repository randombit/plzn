plzn tls "server/tls13-psk-binder-corrupt" {
  rfc 8446 section 4.2.11.2
  chain: []
  uut server { versions: [tls13] }
  psk {
    identity: "Client_identity"
    secret: "6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c"
  }
  flow handshake {
    send ClientHello @ xor[handshake.psk_binder, -1] = 0x01
  }
  expect alert fatal/{decrypt_error, illegal_parameter}
  expect alert fatal/internal_error if boringssl
}
