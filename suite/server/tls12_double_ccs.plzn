plzn tls "server/tls12-double-ccs" {
  rfc 5246 section 7.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake until send ChangeCipherSpec {
    send ChangeCipherSpec
    send ChangeCipherSpec
    send Finished
    recv Finished
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decode_error if rustls
  expect close if wolfssl
}
