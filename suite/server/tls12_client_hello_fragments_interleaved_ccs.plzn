plzn tls "server/tls12-client-hello-fragments-interleaved-ccs/single-interleaved-client-hello-fragment" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake until send ClientHello {
    atomic {
      send ClientHello @ fragment 2 hold
      send record 20 raw "01"
      flush_fragment
    }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close alert warning/close_notify
  }
  expect alert fatal/unexpected_message
  expect close if rustls
}

plzn tls "server/tls12-client-hello-fragments-interleaved-ccs/multiple-interleaved-client-hello-fragments" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake until send ClientHello {
    atomic {
      send ClientHello @ fragment 64 hold_all
      send record 20 raw "01"
      flush_fragment
      send record 20 raw "01"
      flush_fragment
    }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close alert warning/close_notify
  }
  expect alert fatal/unexpected_message
  expect close if rustls
}
