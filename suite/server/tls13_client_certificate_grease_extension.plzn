plzn tls "server/tls13-rejects-grease-client-certificate-extension" {
  rfc 8446 section 4.4.2
  rfc 8701 section 4.1
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  uut server { versions: [tls13], require_client_cert: true }
  # RFC 8446 4.4.2: client Certificate extensions MUST correspond to ones in
  # the CertificateRequest. RFC 8701 4.1: the server MUST fail the connection
  # if a GREASE value appears in any TLS 1.3 Certificate extension.
  xfail go "accepts an unsolicited GREASE client Certificate extension"
  xfail openssl "accepts an unsolicited GREASE client Certificate extension"
  matrix {
    grease in grease
  }
  flow handshake {
    send Certificate { credential: rsa, +ext $grease = zeros 25 }
  }
  expect alert fatal/{decode_error, illegal_parameter, unsupported_extension}
  xfail libressl "never parses client CertificateEntry extensions"
}
