plzn tls "server/tls13-key-share-client-preference" {
  rfc 8446 section 4.2.8
  chain: [default]
  uut server {
    versions: [tls13]
    curves: [x25519, secp256r1]
  }
  peer { capabilities: [secp256r1, x25519] }
  flow handshake {
    send ClientHello {
      +ext key_share = [secp256r1, x25519]
    }
    recv ServerHello { key_share_group: secp256r1 }
    send AppData
    recv AppData
    close
  }
  expect ok
}
