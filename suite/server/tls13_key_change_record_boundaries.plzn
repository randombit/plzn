plzn tls "server/tls13-clienthello-ends-record-before-finished" {
  rfc 8446 section 5.1
  chain: [default]
  uut server { versions: [tls13] }
  xfail gnutls "crosses the ClientHello key boundary and rejects the buffered Finished later with decode_error"
  flow handshake until send ClientHello {
    coalesce old_keys {
      send ClientHello
      send Renegotiation { msg_type: 20 }
    }
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/decrypt_error if libressl
}

plzn tls "server/tls13-client-finished-ends-record-before-key-update" {
  rfc 8446 section 5.1
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send Finished {
    coalesce old_keys {
      send Finished
      send KeyUpdate { request_update: update_not_requested }
    }
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  xfail libressl "accepts a KeyUpdate coalesced after client Finished in the preceding handshake-key record"
}

plzn tls "server/tls13-end-of-early-data-ends-record-before-finished" {
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
    session_tickets: 1
    max_early_data: 1024
  }
  xfail gnutls "accepts Finished coalesced after EndOfEarlyData in the preceding early-data-key record"
  xfail rustls "accepts Finished coalesced after EndOfEarlyData in the preceding early-data-key record"

  session initial {
    flow handshake {
      recv NewSessionTicket { has_ext: early_data }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow {
      send ClientHello
      send EarlyData { size: 32 }
      recv ServerHello
      recv EncryptedExtensions { has_ext: early_data }
      recv Finished
      coalesce old_keys {
        send EndOfEarlyData
        send Finished
      }
      send AppData
      recv AppData
    }
    expect alert fatal/unexpected_message
  }
}

plzn tls "server/tls13-key-update-ends-record-before-next-key-update" {
  rfc 8446 section 5.1
  chain: [default]
  uut server { versions: [tls13] }
  xfail gnutls "accepts two KeyUpdates in one record under the pre-update keys"
  xfail wolfssl "accepts two KeyUpdates in one record under the pre-update keys"
  flow handshake {
    coalesce old_keys {
      send KeyUpdate { request_update: update_not_requested }
      send KeyUpdate { request_update: update_requested }
    }
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect close if libressl
}
