# LibreSSL's TLS 1.2 server answers any failed CertificateVerify signature with
# internal_error (its TLS 1.3 server and TLS 1.2 client send decrypt_error), so the
# internal_error pins below are that alert choice, not an internal failure.

plzn tls "server/tls12-rsa-pss-sigs-on-certificate-verify/valid-handshake" {
  rfc 8446 section 4.2.3
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512, rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512, rsa_pkcs1_sha512, rsa_pkcs1_sha384, rsa_pkcs1_sha256, rsa_pkcs1_sha224, rsa_pkcs1_sha1] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa }
    send ClientKeyExchange
    send CertificateVerify { }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

