    v in [0x01, 0x80]
  }
  uut server {
    versions: [tls12], require_client_cert: true
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512, rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa }
    send ClientKeyExchange
    send CertificateVerify { sign_with: rsa_pss_rsae_sha256 } @ xor[signature.em, $pos] = $v
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/decrypt_error
  expect alert fatal/internal_error if libressl
}

plzn tls "server/tls12-rsa-pss-sigs-on-certificate-verify/id-rsassa-pss-client-key" {
  rfc 8446 section 4.2.3
  skip botan "no rsa_pss_pss_* signature schemes: an id-RSASSA-PSS client key cannot be verified"
  skip rustls "ring lists no rsa_pss_pss_* scheme in its CertificateRequest: an id-RSASSA-PSS client key cannot be verified"
  uut server {
    versions: [tls12], require_client_cert: true
    verify_prefs: [rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512]
  }
  chain: [rsa_2048]
  client_chain: [rsa_2048]
  flow handshake {
    send ClientHello { +ext signature_algorithms = [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512, rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: rsa_pss }
    send ClientKeyExchange
    send CertificateVerify { }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

