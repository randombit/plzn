plzn tls "server/tls13-cert-compression-offered-not-forced" {
  syntax 1.0
  rfc 8879 section 3
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello {
      +ext compress_certificate = raw "020001"
    }
    send AppData
    recv AppData
    close
  }
  expect ok
}
