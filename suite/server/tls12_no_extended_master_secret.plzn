plzn tls "server/tls12-no-extended-master-secret" {
  rfc 7627 section 5.3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send ClientHello {
      -ext extended_master_secret
    }
    recv ServerHello {
      lacks_ext: extended_master_secret
    }
    send AppData
    recv AppData
    close
  }
  expect ok
}
