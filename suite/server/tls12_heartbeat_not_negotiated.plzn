plzn tls "server/tls12-heartbeat-invalid-mode-255-ignored" {
  rfc 6520 section 2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send ClientHello { +ext heartbeat = raw "ff" }
    recv ServerHello { lacks_ext: heartbeat }
    send AppData
