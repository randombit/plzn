plzn tls "server/tls12-rsa-ciphertext-failures-deferred-to-finished/pkcs1-padding-short-by-1-byte" {
  rfc 5246 section 7.4.7.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow handshake {
    send ClientKeyExchange { premaster_secret: 0x03 * 49 }
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/bad_record_mac
}

