plzn tls "server/tls12-rsa-ciphertext-failures-deferred-to-finished/46-byte-zero-premaster-with-type-3-suffix" {
  rfc 5246 section 7.4.7.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow handshake {
    send ClientKeyExchange { premaster_secret: 0x00 * 46 } @ set[pkcs1.padding, -1] = 0x00, @ set[pkcs1.separator, 0] = 0x03
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/bad_record_mac
}

