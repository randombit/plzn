plzn tls "server/tls12-ecdhe-follows-ecdsa-chain" {
  rfc 8422 section 5.1.3
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  chain: [ecdsa_p256]
  flow handshake {
    recv ServerKeyExchange { signature_scheme: [ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384, ecdsa_secp521r1_sha512] }
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls12-ecdhe-follows-rsa-chain" {
  rfc 5246 section 7.4.2
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  chain: [rsa_2048]
  flow handshake {
    recv ServerKeyExchange { signature_scheme: [rsa_pss_rsae_sha256, rsa_pss_rsae_sha384, rsa_pss_rsae_sha512, rsa_pkcs1_sha256, rsa_pkcs1_sha384, rsa_pkcs1_sha512] }
    send AppData
    recv AppData
    close
  }
  expect ok
}
