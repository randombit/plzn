plzn tls "server/tls12-signature-algorithms-trailing-data" {
  rfc 5246 section 7.4.1.4.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = raw "00020601ff"
    }
  }
  expect alert fatal/decode_error
}
