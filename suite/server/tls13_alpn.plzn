plzn tls "server/tls13-alpn-selection" {
  rfc 7301 section 3.2
  chain: [default]
  uut server {
    versions: [tls13]
    alpn_select: "foo"
    expect_alpn: "foo"
  }
  flow handshake {
    send ClientHello { +ext alpn = ["foo", "bar", "baz"] }
    recv EncryptedExtensions { ext alpn == "foo" }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-alpn-declined" {
  rfc 7301 section 3.2
  chain: [default]
  uut server {
    versions: [tls13]
    alpn_decline: true
  }
  flow handshake {
    send ClientHello { +ext alpn = ["foo", "bar"] }
    recv EncryptedExtensions { lacks_ext: alpn }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-alpn-empty-protocol-name" {
  rfc 7301 section 3.1
  chain: [default]
  uut server {
    versions: [tls13]
    alpn_select: "foo"
  }
  flow handshake {
    send ClientHello { +ext alpn = raw "000903666f6f000362617a" }
  }
  expect alert fatal/decode_error
}

plzn tls "server/tls13-alpn-resumption" {
  rfc 7301 section 3.1
  chain: [default]
  uut server {
    versions: [tls13]
    alpn_select: "foo"
    expect_alpn: "foo"
  }

  session initial {
    flow handshake {
      send ClientHello { +ext alpn = ["foo", "bar"] }
      recv EncryptedExtensions { ext alpn == "foo" }
      recv NewSessionTicket
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send ClientHello { +ext alpn = ["foo", "bar"] }
      recv EncryptedExtensions { ext alpn == "foo" }
      send AppData
      recv AppData
    }
    expect ok
  }
}
