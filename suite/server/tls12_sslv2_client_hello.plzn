# OpenSSL 4.0 removed SSLv2 ClientHello parsing, so an SSLv2 record header is
# read as a TLS record header with an impossible version and the connection is
# closed without an alert (3.6 answered handshake_failure or decode_error).
plzn tls "server/tls12-sslv2-client-hello" {
  rfc 5246 section E.2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow {
    send ClientHello { format: sslv2 }
    recv ServerHello
    recv Certificate
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect ok
  expect close if botan
  expect close if openssl
  expect alert fatal/protocol_version if libressl
}

plzn tls "server/tls12-sslv2-empty-record" {
  rfc 5246 section E.2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow {
    send raw "8000"
    send ClientHello { format: sslv2 }
    recv ServerHello
  }
  expect close
  expect alert fatal/protocol_version if boringssl
  expect alert fatal/protocol_version if libressl
}

plzn tls "server/tls12-sslv2-empty-record-type-0" {
  rfc 5246 section E.2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow {
    send raw "800100"
    send ClientHello { format: sslv2 }
    recv ServerHello
  }
  expect close
  expect alert fatal/protocol_version if boringssl
  expect alert fatal/protocol_version if libressl
}

plzn tls "server/tls12-sslv2-empty-record-type-1" {
  rfc 5246 section E.2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow {
    send raw "800101"
    send ClientHello { format: sslv2 }
    recv ServerHello
  }
  expect close
  expect alert fatal/protocol_version if boringssl
  expect alert fatal/protocol_version if libressl
}

plzn tls "server/tls12-sslv2-just-version" {
  rfc 5246 section E.2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow {
    send raw "8003010303"
    send ClientHello { format: sslv2 }
    recv ServerHello
  }
  expect close
  skip libressl "reads the truncated SSLv2 header as a TLS record header of length 771 and waits for that body; the runner can only time out"
  skip openssl "reads the truncated SSLv2 header as a TLS record header of length 771 and waits for that body; the runner can only time out"
}
