plzn tls "server/tls13-empty-supported-groups" {
  rfc 8446 section 4.2.7
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello {
      +ext supported_groups = raw "0000"
    }
    send AppData
    recv AppData
    close
  }
  expect alert fatal/decode_error
}
