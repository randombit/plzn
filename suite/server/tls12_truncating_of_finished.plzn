plzn tls "server/tls12-truncating-of-finished/padded-finished" {
  rfc 5246 section 7.4.9
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send Finished @ pad "fa"
  }
  expect alert fatal/{decode_error,decrypt_error}
}

plzn tls "server/tls12-truncating-of-finished/truncated-finished" {
  rfc 5246 section 7.4.9
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send Finished @ pad -1
  }
  expect alert fatal/{decode_error,decrypt_error}
}
