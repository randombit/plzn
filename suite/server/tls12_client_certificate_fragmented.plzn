plzn tls "server/tls12-client-certificate-fragmented" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12], require_client_cert: true
  }
  matrix {
    size in [1, 5, 16, 64, 255]
  }
  flow handshake {
    send Certificate @ fragment $size
    send CertificateVerify @ fragment $size
    send AppData
    recv AppData
  }
  expect ok
}
