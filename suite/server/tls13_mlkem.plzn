plzn tls "server/tls13-mlkem/invalid-ecdh-point-format-compressed" {
  rfc 8446 section 4.2.8.2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [0x11eb, 0x11ed]
  }
  flow handshake {
    send ClientHello { key_share_point: compressed }
    recv ServerHello
    send AppData
    recv AppData
    close
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls13-mlkem/invalid-ecdh-point-format-hybrid" {
  rfc 8446 section 4.2.8.2
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [0x11eb, 0x11ed]
  }
  flow handshake {
    send ClientHello { key_share_point: hybrid }
    recv ServerHello
    send AppData
    recv AppData
    close
  }
  expect alert fatal/illegal_parameter
  xfail openssl "accepts a SEC1 hybrid-form point in the ECDHE half of a SecP*MLKEM share (RFC 10024 requires uncompressed); plain EC shares are checked"
}

