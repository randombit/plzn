plzn tls "server/tls13-mlkem/truncated-key-share" {
  rfc 8446 section 4.2.8
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix {
    group in [0x11ec, 0x11ee, 0x11eb, 0x11ed, 0x0200, 0x0201, 0x0202]
  }
  flow handshake {
    send ClientHello { key_share_point: truncated }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if libressl
}

