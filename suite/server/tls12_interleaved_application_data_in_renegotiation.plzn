plzn tls "server/tls12-interleaved-application-data-in-renegotiation/before-cke" {
  rfc 5246 section 7.4.1.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake after recv Finished {
    send AppData
    recv AppData
    begin_renegotiation
    send ClientHello
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send AppData
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/no_renegotiation if boringssl
}

