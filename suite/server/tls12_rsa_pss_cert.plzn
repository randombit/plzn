plzn tls "server/tls12-rsa-pss-cert" {
  rfc 8446 section 4.2.3
  chain: [rsa_pss]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe_rsa] }
  flow handshake {
    send ClientHello {
      +ext signature_algorithms = [rsa_pss_pss_sha256, rsa_pss_pss_sha384, rsa_pss_pss_sha512]
    }
    send AppData
    recv AppData
    close
  }
  expect ok
}
