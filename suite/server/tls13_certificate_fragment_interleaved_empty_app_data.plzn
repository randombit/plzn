plzn tls "server/tls13-certificate-fragment-interleaved-empty-app-data" {
  rfc 8446 section 5.1
  chain: [default]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake until send Certificate {
    send Certificate @ fragment 16 hold
    send empty_record application_data
    flush_fragment
    send CertificateVerify
    send Finished
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect close if rustls
}
