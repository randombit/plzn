# RFC 8998 curveSM2 (named group 41): plain TLS 1.3 ECDHE on the SM2 curve of
# GB/T 32918.5-2017, uncompressed SEC1 points and an x-coordinate shared
# secret, which RFC 8998 3.1 confines to TLS 1.3. Of the backends only OpenSSL
# 4 implements the group (it sits in its default group list); the other shims
# report an offer of nothing but curveSM2 as unsupported and skip.

plzn tls "server/tls13-curvesm2/key-share-negotiated" {
  rfc 8998 section 3.3.1
  chain: [default]
  uut server { versions: [tls13] }
  peer { capabilities: [curvesm2] }
  flow handshake {
    recv ServerHello { key_share_group: curveSM2 }
    send AppData
    recv AppData
  }
  expect ok
}

# curveSM2 listed but not key-shared: the server retries for it.
plzn tls "server/tls13-curvesm2/hrr-to-curvesm2" {
  rfc 8998 section 3.3.1
  rfc 8446 section 4.1.4
  chain: [default]
  uut server { versions: [tls13] }
  peer { capabilities: [hrr, curvesm2] }
  flow handshake {
    send ClientHello { +ext key_share = raw "0000" }
    recv HelloRetryRequest { key_share_group: curveSM2 }
    send AppData
    recv AppData
  }
  expect ok
}

# The last byte of the share flipped: a point off the curve must be rejected.
plzn tls "server/tls13-curvesm2/point-outside-curve" {
  rfc 8446 section 4.2.8.2
  chain: [default]
  uut server { versions: [tls13] }
  peer { capabilities: [curvesm2] }
  flow handshake {
    send ClientHello @ xor[handshake.key_share, -1] = 0x01
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
}

# draft-yang-tls-hybrid-sm2-mlkem: curveSM2MLKEM768 (0x11ee) is curveSM2
# ECDHE first, then ML-KEM-768, in both the shares and the 64-byte secret.
plzn tls "server/tls13-curvesm2/hybrid-key-share-negotiated" {
  rfc 8998 section 3.3.1
  chain: [default]
  uut server { versions: [tls13] }
  peer { capabilities: [curvesm2mlkem768] }
  flow handshake {
    recv ServerHello { key_share_group: curveSM2MLKEM768 }
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-curvesm2/hrr-to-hybrid" {
  rfc 8998 section 3.3.1
  rfc 8446 section 4.1.4
  chain: [default]
  uut server { versions: [tls13] }
  peer { capabilities: [hrr, curvesm2mlkem768] }
  flow handshake {
    send ClientHello { +ext key_share = raw "0000" }
    recv HelloRetryRequest { key_share_group: curveSM2MLKEM768 }
    send AppData
    recv AppData
  }
  expect ok
}

# RFC 8998 3.1: the group exists only in TLS 1.3, so a TLS 1.2 server offered
# nothing else has no curve to use.
plzn tls "server/tls12-ignores-curvesm2" {
  rfc 8998 section 3.1
  chain: [default]
  uut server {
    versions: [tls12]
    cipher_suites: [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256]
  }
  flow handshake {
    send ClientHello { +ext supported_groups = [curveSM2] }
  }
  expect alert fatal/{handshake_failure, insufficient_security}
}
