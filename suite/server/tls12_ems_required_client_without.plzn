plzn tls "server/tls12-ems-required-client-without" {
  rfc 7627 section 5.3
  chain: [default]
  uut server {
    versions: [tls12]
    extended_master_secret: require
  }
  flow handshake {
    send ClientHello {
      -ext extended_master_secret
    }
  }
  expect alert fatal/handshake_failure
}
