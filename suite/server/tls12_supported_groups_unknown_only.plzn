plzn tls "server/tls12-supported-groups-unknown-only" {
  rfc 8422 section 5.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [ecdhe] }
  flow handshake {
    send ClientHello {
      +ext supported_groups = raw "00020001"
    }
  }
  expect alert fatal/handshake_failure
}
