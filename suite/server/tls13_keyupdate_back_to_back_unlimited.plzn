plzn tls "server/tls13-keyupdate-back-to-back-unlimited" {
  rfc 8446 section 4.6.3
  chain: [default]
  uut server {
    versions: [tls13]
    min_key_update_interval_ms: 0
  }
  flow handshake {
    send AppData
    recv AppData
    send KeyUpdate { request_update: update_not_requested }
    send KeyUpdate { request_update: update_not_requested }
    send AppData
    recv AppData
    send KeyUpdate { request_update: update_requested }
    send AppData
    recv KeyUpdate { request_update: update_not_requested }
    recv AppData
  }
  expect ok
}
