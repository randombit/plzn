      cipher_suites: [0x005d..0x005f, 0x006e..0x0083, 0x00c6..0x00fe, 0x00ff..0x55ff, 0x5601..0x80aa, ECDHE_RSA_WITH_AES_128_GCM_SHA256, EMPTY_RENEGOTIATION_INFO_SCSV]
    } @ fragment 16384
    recv ServerHello { cipher_suite: ECDHE_RSA_WITH_AES_128_GCM_SHA256 }
    send AppData
