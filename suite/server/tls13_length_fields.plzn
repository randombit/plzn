plzn tls "server/tls13-length/psk-key-exchange-modes-list" {
  rfc 8446 section 4.2.9
  xfail gnutls "accepts psk_key_exchange_modes with a short modes vector"
  skip wolfssl "built without PSK or session tickets: psk_key_exchange_modes is ignored unparsed"
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send ClientHello {
    send ClientHello { +ext psk_key_exchange_modes = raw "0101" } @ sub[handshake.extension_psk_key_exchange_modes_list_length] = 1
    recv ServerHello
  }
  expect alert fatal/decode_error
}

plzn tls "server/tls13-length/pre-shared-key-extension" {
  rfc 8446 section 4.2.11
  chain: []
  uut server { versions: [tls13] }
  psk {
    identity: "Client_identity"
    secret: "6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c6f6c"
  }
  flow handshake until send ClientHello {
