plzn tls "server/tls13-length/client-hello-message" {
  rfc 8446 section 4.1.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send ClientHello {
    send ClientHello @ sub[handshake.length] = 1
    recv ServerHello
  }
  expect alert fatal/{decode_error,unexpected_message}
  expect alert fatal/protocol_version if libressl
}

plzn tls "server/tls13-length/client-hello-session-id" {
  rfc 8446 section 4.1.2
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send ClientHello {
    send ClientHello @ add[handshake.session_id_length] = 1
    recv ServerHello
  }
  expect alert fatal/{decode_error,illegal_parameter}
  expect close if libressl
}

