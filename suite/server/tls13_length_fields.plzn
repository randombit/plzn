plzn tls "server/tls13-length/client-certificate-message" {
  rfc 8446 section 4.4.2
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake until send Certificate {
    send Certificate @ sub[handshake.length] = 1
    wait 300 ms
  }
  expect alert fatal/{decode_error,unexpected_message,bad_certificate,certificate_unknown}
  expect close if libressl
}

plzn tls "server/tls13-length/client-certificate-request-context" {
  rfc 8446 section 4.4.2
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake until send Certificate {
    send Certificate @ add[handshake.request_context_length] = 1
    wait 300 ms
  }
  expect alert fatal/{decode_error,illegal_parameter,bad_certificate,certificate_unknown}
  expect close if wolfssl
  expect close if libressl
}

plzn tls "server/tls13-length/client-certificate-list" {
