plzn tls "server/tls13-length/client-certificate-verify-message" {
  rfc 8446 section 4.4.3
  chain: [default]
  client_chain: [ecdsa_p256]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake until send CertificateVerify {
    send CertificateVerify @ sub[handshake.length] = 1
    recv Finished
  }
  expect alert fatal/{decode_error,unexpected_message,decrypt_error,internal_error}
}

plzn tls "server/tls13-length/client-certificate-verify-signature" {
