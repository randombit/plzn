plzn tls "server/tls13-keyupdate-unknown-mode" {
  rfc 8446 section 4.6.3
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send KeyUpdate { request_update: 0x03 }
    recv AppData
  }
  expect alert fatal/illegal_parameter
  expect alert fatal/decode_error if boringssl
}
