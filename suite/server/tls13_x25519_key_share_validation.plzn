plzn tls "server/tls13-x25519-key-share-validation/ec-point-formats-uncompressed" {
  rfc 7748 section 6.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [x25519] }
  flow handshake {
    send ClientHello { +ext ec_point_formats = [uncompressed] }
    recv ServerHello { key_share_group: x25519 }
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls13-x25519-key-share-validation/ec-point-formats-compressed-prime" {
  rfc 7748 section 6.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  peer { capabilities: [x25519] }
  flow handshake {
    send ClientHello { +ext ec_point_formats = [ansix962_compressed_prime] }
    recv ServerHello { key_share_group: x25519 }
    send AppData
    recv AppData
    close
  }
  expect ok
  expect alert fatal/illegal_parameter if botan
  expect alert fatal/illegal_parameter if libressl
}

plzn tls "server/tls13-x25519-key-share-validation/ec-point-formats-compressed-char2" {
