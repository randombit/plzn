plzn tls "server/tls12-invalid-cipher-suites/valid-handshake" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send AppData
    recv AppData
    send alert warning/close_notify
    recv alert warning/close_notify
    close
  }
  expect ok
}
