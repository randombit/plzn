plzn tls "server/tls12-invalid-cipher-suites/null-null" {
  rfc 5246 section 7.4.1.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow {
    send ClientHello { cipher_suites: [0x0000] }
  }
  expect alert fatal/handshake_failure
}

