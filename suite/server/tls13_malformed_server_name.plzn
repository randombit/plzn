plzn tls "server/tls13-malformed-server-name" {
  rfc 6066 section 3
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake {
    send ClientHello {
      +ext server_name = raw "00"
    }
  }
  expect alert fatal/decode_error
}

plzn tls "server/tls13-server-name-repeated-unknown-name-type" {
  rfc 6066 section 3
  chain: [default]
  uut server { versions: [tls13] }
  xfail go "accepts repeated name types"
  flow handshake {
    send ClientHello {
      +ext server_name = raw "00080100014101000142"
    }
  }
  expect alert fatal/{decode_error, illegal_parameter}
}
