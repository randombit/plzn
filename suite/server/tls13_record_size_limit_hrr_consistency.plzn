  xfail openssl "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
  xfail rustls "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
  xfail wolfssl "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
  flow handshake until send ClientHello {
    send ClientHello {
      +ext key_share = raw "0000"
      +ext record_size_limit = 16385
