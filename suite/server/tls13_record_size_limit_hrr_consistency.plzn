plzn tls "server/tls13-record-size-limit/hrr-unchanged" {
  rfc 8446 section 4.1.2
  chain: [default]
  uut server { versions: [tls13], curves: [secp256r1] }
  peer { capabilities: [hrr, secp256r1] }
  flow handshake until send ClientHello {
    send ClientHello {
      +ext key_share = raw "0000"
      +ext record_size_limit = 16385
    }
    recv HelloRetryRequest { key_share_group: secp256r1 }
    send ClientHello
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls13-record-size-limit/hrr-value-changed" {
  rfc 8446 section 4.1.2
  chain: [default]
  uut server { versions: [tls13], curves: [secp256r1] }
  peer { capabilities: [hrr, secp256r1] }
  xfail boringssl "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
  xfail gnutls "does not enforce record_size_limit invariance across ClientHello1 and ClientHello2"
  xfail go "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
  xfail openssl "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
  xfail rustls "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
  xfail wolfssl "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
  flow handshake until send ClientHello {
    send ClientHello {
      +ext key_share = raw "0000"
      +ext record_size_limit = 16385
    }
    recv HelloRetryRequest { key_share_group: secp256r1 }
    send ClientHello { +ext record_size_limit = 16384 }
    recv ServerHello
  }
  expect alert fatal/illegal_parameter
  xfail libressl "does not compare this unimplemented extension across ClientHello1 and ClientHello2"
}

