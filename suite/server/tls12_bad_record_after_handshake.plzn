plzn tls "server/tls12-bad-record-after-handshake" {
  rfc 5246 section 6.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake {
    send raw "ff 0303 0005 deadbeefca"
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/bad_record_mac if boringssl
  expect alert fatal/bad_record_mac if openssl
  expect alert fatal/decode_error if rustls
  expect close if libressl
}
