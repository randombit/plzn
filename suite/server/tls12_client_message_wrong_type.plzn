plzn tls "server/tls12-wrong-type-clienthello" {
  rfc 5246 section 7.4
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake {
    send ClientHello @ set[handshake.msg_type, 0] = 0xff
  }
  expect alert fatal/{unexpected_message,decode_error}
}

plzn tls "server/tls12-wrong-type-client-certificate" {
  rfc 5246 section 7.4
  chain: [default]
  uut server {
    versions: [tls12]
    require_client_cert: true
  }
  flow handshake {
    send Certificate @ set[handshake.msg_type, 0] = 0xff
  }
  expect alert fatal/{unexpected_message,decode_error}
}

plzn tls "server/tls12-wrong-type-client-certificateverify" {
  rfc 5246 section 7.4
  chain: [default]
  uut server {
    versions: [tls12]
    require_client_cert: true
  }
  flow handshake {
    send CertificateVerify @ set[handshake.msg_type, 0] = 0xff
  }
  expect alert fatal/{unexpected_message,decode_error}
}

plzn tls "server/tls12-wrong-type-client-finished" {
  rfc 5246 section 7.4
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake {
    send Finished @ set[handshake.msg_type, 0] = 0xff
  }
  expect alert fatal/{unexpected_message,decode_error}
}
