plzn tls "server/tls13-record-layer-fragmentation/tls13-hello" {
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
  }
  matrix { record_len in [1, 5, 100, 1024, 16384] }
  flow handshake until send ClientHello {
    send ClientHello { +ext padding = 2048 } @ fragment $record_len
    recv ServerHello
    recv EncryptedExtensions
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Finished
    send AppData
    recv AppData
    close alert warning/close_notify
  }
  expect ok
}

