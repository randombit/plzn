plzn tls "server/tls13-rejects-end-of-early-data-prefix-after-client-hello" {
  rfc 8446 section 2.3
  rfc 8446 section 5.1
  chain: [default]
  uut server {
    versions: [tls13]
    session_tickets: 1
    max_early_data: 1024
  }
  xfail gnutls "carries a partial EndOfEarlyData across the ClientHello key change"

  session initial {
    flow handshake {
      recv NewSessionTicket { has_ext: early_data }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow {
      send ClientHello @ trailing "05"
      send ChangeCipherSpec
      send EarlyData { size: 32 }
      recv ServerHello
      recv EncryptedExtensions { has_ext: early_data }
      recv Finished
      send EndOfEarlyData @ omit_prefix 1
      send Finished
    }
    expect alert fatal/unexpected_message
  }
}

plzn tls "server/tls13-rejects-end-of-early-data-prefix-after-client-hello-without-ccs" {
