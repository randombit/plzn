plzn tls "server/tls12-invalid-rsa-key-exchange-messages/encrypted-premaster-all-zero-128" {
  rfc 5246 section 7.4.7.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow handshake {
    send ClientKeyExchange { encrypted_premaster: 0x00 * 128 }
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/{bad_record_mac,decode_error,decrypt_error}
  expect close if boringssl
}

