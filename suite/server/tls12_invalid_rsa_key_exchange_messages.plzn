plzn tls "server/tls12-invalid-rsa-key-exchange-messages/modulus-as-encrypted-premaster" {
  rfc 5246 section 7.4.7.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa] }
  flow handshake {
    send ClientKeyExchange { encrypted_premaster: modulus }
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/bad_record_mac
  expect close if boringssl
  expect alert fatal/decrypt_error if openssl
  expect alert fatal/decrypt_error if libressl
}
