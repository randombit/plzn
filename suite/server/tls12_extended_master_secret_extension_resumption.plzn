plzn tls "server/tls12-extended-master-secret/ems-with-session-resume" {
  rfc 7627 section 5.3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [session_id] }

  session initial {
    flow handshake {
      recv ServerHello { has_ext: extended_master_secret }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      recv ServerHello { resumed: true, has_ext: extended_master_secret }
      send AppData
      recv AppData
    }
    expect ok
  }
  skip libressl "does not implement extended_master_secret"
}

plzn tls "server/tls12-extended-master-secret/ems-with-session-resume-sha384-prf" {
  rfc 7627 section 5.3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [sha384, session_id] }

  session initial {
    flow handshake {
      recv ServerHello { has_ext: extended_master_secret }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      recv ServerHello { resumed: true, has_ext: extended_master_secret }
      send AppData
      recv AppData
    }
    expect ok
  }
  skip libressl "does not implement extended_master_secret"
}

plzn tls "server/tls12-extended-master-secret/ems-session-resume-without-extension" {
  rfc 7627 section 5.3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [session_id] }

  session initial {
    flow handshake {
      recv ServerHello { has_ext: extended_master_secret }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      send ClientHello { -ext extended_master_secret }
    }
    expect alert fatal/handshake_failure
    expect alert fatal/illegal_parameter if rustls
  }
  skip libressl "does not implement extended_master_secret"
}

plzn tls "server/tls12-extended-master-secret/resume-non-ems-session-with-ems" {
  rfc 7627 section 5.3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [session_id] }

  session initial {
    flow handshake {
      send ClientHello { -ext extended_master_secret }
      recv ServerHello { lacks_ext: extended_master_secret }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow handshake {
      recv ServerHello { resumed: false, has_ext: extended_master_secret }
      send AppData
      recv AppData
    }
    expect ok
  }
  skip libressl "does not implement extended_master_secret"
}

plzn tls "server/tls12-extended-master-secret/renegotiate-with-ems-in-session-without-ems" {
  rfc 7627 section 5.3
  chain: [default]
  uut server {
    versions: [tls12]
  }
  # A ServerHello matcher would also apply to the renegotiation, where EMS is present.
  flow handshake {
    send ClientHello { -ext extended_master_secret }
    send AppData
    recv AppData
    renegotiate { +ext extended_master_secret }
    send AppData
    recv AppData
  }
  expect ok
}
