# Under the client's write keys: zero-length handshake fragments that decrypt
# cleanly. Each library counts or rejects them.
plzn tls "server/tls12-empty-record-flood/protected-handshake-before-client-finished-one-to-thirty-two" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  matrix {
    count in [1, 2, 32]
  }
  flow handshake until send Finished {
    repeat $count { send empty_record handshake }
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect ok
  expect alert fatal/unexpected_message if libressl
  expect alert fatal/unexpected_message if go
  expect close if wolfssl
}

