# The ClientHello is split into 64-byte records and the empties go before its
# last one: still handshake content type, so no interleaving rule applies.
plzn tls "server/tls12-empty-record-flood/plaintext-handshake-between-client-hello-fragments-one-to-thirty-two" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  matrix {
    count in [1, 2, 32]
  }
  flow handshake until send ClientHello {
    send ClientHello @ fragment 64 hold
    repeat $count { send empty_record handshake }
    flush_fragment
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect ok if openssl
  expect ok if boringssl
  expect alert fatal/decode_error if botan
  expect alert fatal/decode_error if rustls
  expect alert fatal/record_overflow if wolfssl
}

