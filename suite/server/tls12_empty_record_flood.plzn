# BoringSSL is waiting for the ChangeCipherSpec here and refuses any handshake
# record, so it never reaches its empty-record counter at this position.
plzn tls "server/tls12-empty-record-flood/plaintext-handshake-after-client-key-exchange-one-to-thirty-two" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  matrix {
    count in [1, 2, 32]
  }
  flow handshake after send ClientKeyExchange {
    repeat $count { send empty_record handshake }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect ok if openssl
  expect alert fatal/decode_error if botan
  expect alert fatal/decode_error if rustls
  expect alert fatal/record_overflow if wolfssl
}

