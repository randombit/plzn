plzn tls "server/tls12-etm-negotiated" {
  rfc 7366 section 2
  chain: [default]
  uut server {
    versions: [tls12]
    encrypt_then_mac: true
  }
  peer { capabilities: [cbc] }
  flow handshake {
    send ClientHello {
      +ext encrypt_then_mac
    }
    recv ServerHello { has_ext: encrypt_then_mac }
    send AppData
    recv AppData
    close
  }
  expect ok
}
