plzn tls "server/tls12-invalid-content-type/before-client-key-exchange" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake until send ClientKeyExchange {
    send record 24 "hello server!\n"
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
  }
  expect alert fatal/{unexpected_message,decode_error}
}

plzn tls "server/tls12-invalid-content-type/before-change-cipher-spec" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake after send ClientKeyExchange {
    send record 24 "hello server!\n"
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
  }
  expect alert fatal/{unexpected_message,decode_error}
}

plzn tls "server/tls12-invalid-content-type/before-finished" {
  rfc 5246 section 6.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake after send ChangeCipherSpec {
    send record 24 "hello server!\n"
    send Finished
    recv ChangeCipherSpec
  }
  expect alert fatal/{unexpected_message,decode_error}
}
