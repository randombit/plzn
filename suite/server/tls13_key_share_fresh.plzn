plzn tls "server/tls13-key-share-fresh-across-connections" {
  rfc 9846 section 4.3.8
  chain: [default]
  uut server {
    versions: [tls13]
    curves: [x25519]
  }
  repeat 8
  flow handshake {
    recv ServerHello { key_share: capture $ks }
    send AppData
    recv AppData
  }
  expect ok
  assert unique $ks
}
