# The ChangeCipherSpec is its own record type; a handshake record cannot
# stand in for it, even one using the library's internal CCS type value.
plzn tls "server/tls12-client-ccs-as-handshake-message" {
  rfc 5246 section 7.1
  chain: [default]
  uut server { versions: [tls12] }
  flow handshake until send ChangeCipherSpec {
    send record 22 raw "fc000000"
    send Finished
    wait 300 ms
  }
  expect alert fatal/unexpected_message
}
