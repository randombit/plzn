plzn tls "server/tls12-renegotiation-interleaved-app-data/valid-handshake" {
  rfc 5246 section 7.4.1.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa, cbc] }
  flow handshake {
    send AppData
    recv AppData
  }
  expect ok
}

plzn tls "server/tls12-renegotiation-interleaved-app-data/weaved-app-data-and-handshake" {
  rfc 5246 section 7.4.1.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [rsa, cbc] }
  flow handshake after recv Finished {
    begin_renegotiation
    send ClientHello
    recv ServerHello
    recv Certificate
    recv ServerHelloDone
    send AppData
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    recv AppData
  }
  expect alert fatal/unexpected_message
  expect alert fatal/no_renegotiation if boringssl
}
