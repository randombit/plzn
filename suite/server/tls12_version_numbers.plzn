plzn tls "server/tls12-version-numbers/very-low-version-0-0" {
  rfc 5246 section E.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake until send ClientHello {
    send ClientHello { legacy_version: 0x0000 } @ record_version 0x0300
    recv ServerHello
  }
  expect alert fatal/protocol_version
}

