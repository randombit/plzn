plzn tls "server/tls12-version-numbers/very-high-version-254-254" {
  rfc 5246 section E.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake until send ClientHello {
    send ClientHello { legacy_version: 0xfefe } @ record_version 0x0300
    recv ServerHello { legacy_version: 0x0303 }
    recv Certificate
    recv ServerKeyExchange
    recv ServerHelloDone
    send ClientKeyExchange
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close alert warning/close_notify
  }
  expect ok
  expect alert fatal/decode_error if botan
}

