plzn tls "server/tls12-connection-abort/before-client-hello" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake until send ClientHello {
    close
  }
  expect ok
}

plzn tls "server/tls12-connection-abort/after-client-hello" {
  rfc 5246 section 7.2.1
  chain: [default]
  uut server {
    versions: [tls12]
  }
  flow handshake after send ClientHello {
    close
  }
  expect ok
}

