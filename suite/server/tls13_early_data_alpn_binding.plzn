plzn tls "server/tls13-early-data-rejected-after-alpn-change" {
  rfc 8446 section 4.2.10
  chain: [default]
  uut server {
    versions: [tls13]
    session_tickets: 1
    max_early_data: 1024
    alpn_select_from: ["foo", "bar"]
  }
  xfail gnutls "accepts 0-RTT after selecting an ALPN protocol different from the ticket's session"

  session initial {
    flow handshake {
      send ClientHello { +ext alpn = ["foo"] }
      recv EncryptedExtensions { ext alpn == "foo" }
      recv NewSessionTicket { has_ext: early_data }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow {
      send ClientHello { +ext alpn = ["bar"] }
      send EarlyData { size: 32 }
      recv ServerHello { has_ext: pre_shared_key }
      recv EncryptedExtensions {
        ext alpn == "bar"
        lacks_ext: early_data
      }
      recv Finished
      send Finished
      send AppData
      recv AppData
    }
    expect ok
  }
}
