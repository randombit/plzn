plzn tls "server/tls13-empty-ccs-record" {
  rfc 8446 section 5
  chain: [default]
  uut server { versions: [tls13] }
  flow handshake until send ChangeCipherSpec {
    send empty_record change_cipher_spec
    send ChangeCipherSpec
    send Finished
    send AppData
    recv AppData
  }
  expect alert fatal/{unexpected_message, decode_error}
  expect alert fatal/bad_record_mac if boringssl
}
