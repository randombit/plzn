plzn tls "server/tls13-eddsa-in-certificate-verify/valid-handshake" {
  rfc 8446 section 4.4.3
  skip botan "no Ed25519 TLS signature scheme"
  chain: [default]
  uut server {
    versions: [tls13], require_client_cert: true
    verify_prefs: [ed25519]
  }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp521r1_sha512, ecdsa_secp384r1_sha384, ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256, rsa_pss_pss_sha256, rsa_pss_rsae_sha384, rsa_pss_pss_sha384, ed25519, ed448] }
    recv ServerHello
    recv EncryptedExtensions
    recv CertificateRequest
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Certificate { credential: ed25519 }
    send CertificateVerify { }
    send Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

plzn tls "server/tls13-eddsa-in-certificate-verify/labelled-ecdsa_sha1" {
  rfc 8446 section 4.4.3
  skip botan "no Ed25519 TLS signature scheme"
  chain: [default]
  uut server { versions: [tls13], require_client_cert: true }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_secp521r1_sha512, ecdsa_secp384r1_sha384, ecdsa_secp256r1_sha256, rsa_pss_rsae_sha256, rsa_pss_pss_sha256, rsa_pss_rsae_sha384, rsa_pss_pss_sha384, ed25519, ed448] }
    recv ServerHello
    recv EncryptedExtensions
    recv CertificateRequest
    recv Certificate
    recv CertificateVerify
    recv Finished
    send Certificate { credential: ed25519 }
    send CertificateVerify { sign_with: ed25519, algorithm: ecdsa_sha1 }
    send Finished
  }
  expect alert fatal/illegal_parameter
  skip libressl "no Ed25519 TLS signature scheme"
}

