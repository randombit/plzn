plzn tls "server/tls12-cbc-padding-corruption/xor-position" {
  rfc 5246 section 6.2.3.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [aes128_cbc_sha] }
  matrix {
    pos in [-1, -2, -6, -12]
    val in [0x01, 0xff]
  }
  flow handshake {
    send AppData { size: 16 } @ cbc_pad 20, xor[record.padding, $pos] = $val
    recv AppData
  }
  expect alert fatal/bad_record_mac
}

plzn tls "server/tls12-cbc-padding-corruption/zero-at-padding-start" {
  rfc 5246 section 6.2.3.2
  chain: [default]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [aes128_cbc_sha] }
  flow handshake {
    send AppData { size: 10 } @ set[record.padding, 0] = 0x00
    recv AppData
  }
  expect alert fatal/bad_record_mac
}
