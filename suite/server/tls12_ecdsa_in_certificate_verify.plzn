# LibreSSL's TLS 1.2 server answers any failed CertificateVerify signature with
# internal_error (its TLS 1.3 server and TLS 1.2 client send decrypt_error), so the
# internal_error pins below are that alert choice, not an internal failure.

plzn tls "server/tls12-ecdsa-in-certificate-verify/valid-handshake" {
  rfc 4492 section 5.10
  chain: [default]
  uut server {
    versions: [tls12], require_client_cert: true
  }
  peer { capabilities: [ecdhe, aes128_gcm_sha256] }
  flow handshake {
    send ClientHello { +ext signature_algorithms = [ecdsa_sha1, ecdsa_sha224, ecdsa_secp256r1_sha256, ecdsa_secp384r1_sha384, ecdsa_secp521r1_sha512, rsa_pss_rsae_sha256, rsa_pkcs1_sha256] }
    recv ServerHello
    recv Certificate
    recv ServerKeyExchange
    recv CertificateRequest
    recv ServerHelloDone
    send Certificate { credential: ecdsa_p256 }
    send ClientKeyExchange
    send CertificateVerify { }
    send ChangeCipherSpec
    send Finished
    recv ChangeCipherSpec
    recv Finished
    send AppData
    recv AppData
    close
  }
  expect ok
}

