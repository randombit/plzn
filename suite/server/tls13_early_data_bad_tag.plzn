plzn tls "server/tls13-early-data-bad-tag" {
  rfc 8446 section 5.2
  chain: [default]
  uut server {
    versions: [tls13]
    session_tickets: 1
    max_early_data: 1024
  }
  xfail gnutls "sends bad_record_mac under the handshake write key after Server Finished, where TLS 1.3 requires the application write key"

  session initial {
    flow handshake {
      recv NewSessionTicket { has_ext: early_data }
      close
    }
    expect ok
  }

  session resumed [resumes: initial] {
    flow {
      send ClientHello
      send EarlyData { size: 32 } @ xor[record.aead_tag, -1] = 0x01
      recv ServerHello
      recv EncryptedExtensions
      recv Finished
      recv AppData
    }
    expect alert fatal/bad_record_mac
  }
}
