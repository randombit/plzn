plzn tls "server/tls12-dhe-rsa-key-exchange-with-bad-messages/dh-Yc-zero" {
  rfc 5246 section 7.4.7.2
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [dhe_rsa] }
  flow handshake {
    send ClientKeyExchange { key_share_point: zero }
    send ChangeCipherSpec
    send Finished
  }
  expect alert fatal/illegal_parameter
}

plzn tls "server/tls12-dhe-rsa-key-exchange-with-bad-messages/dh-Yc-one" {
  rfc 5246 section 7.4.7.2
  chain: [rsa_2048]
  uut server {
