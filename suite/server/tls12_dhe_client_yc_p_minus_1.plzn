plzn tls "server/tls12-dhe-client-yc-p-minus-1" {
  rfc 8446 section 4.2.8.1
  chain: [rsa_2048]
  uut server {
    versions: [tls12]
  }
  peer { capabilities: [dhe_rsa] }
  flow handshake {
    send ClientKeyExchange {
      key_share_point: p_minus_1
    }
  }
  expect alert fatal/illegal_parameter
}
