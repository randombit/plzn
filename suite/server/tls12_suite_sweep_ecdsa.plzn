plzn tls "server/tls12-sweep-ecdsa" {
  rfc 5246 section 7.4.1.3
  chain: [ecdsa_p256]
  uut server { versions: [tls12] }
  matrix {
    suite in [ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256, ECDHE_ECDSA_WITH_AES_128_CBC_SHA, ECDHE_ECDSA_WITH_AES_128_CBC_SHA256, ECDHE_ECDSA_WITH_AES_256_CBC_SHA, ECDHE_ECDSA_WITH_AES_256_CBC_SHA384, ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA, ECDHE_ECDSA_WITH_NULL_SHA, ECDHE_ECDSA_WITH_ARIA_128_GCM_SHA256, ECDHE_ECDSA_WITH_ARIA_256_GCM_SHA384, ECDHE_ECDSA_WITH_CAMELLIA_128_GCM_SHA256, ECDHE_ECDSA_WITH_CAMELLIA_256_GCM_SHA384, ECDHE_ECDSA_WITH_AES_128_CCM, ECDHE_ECDSA_WITH_AES_256_CCM, ECDHE_ECDSA_WITH_AES_128_CCM_8, ECDHE_ECDSA_WITH_AES_256_CCM_8]
  }
  flow handshake {
    recv ServerHello { cipher_suite: $suite }
    send AppData
    recv AppData
    close
  }
  expect ok
}
